---
// src/components/RaceControlTicker.astro
export {}; // Isolates scope

interface Session { session_key: number; session_name?: string; date_start?: string; }
interface RaceControlMessage { lap_number?: number; category: string; message: string; flag?: string; scope?: string; sector?: number; }

let messages: RaceControlMessage[] = [];

try {
  const sessionsRes = await fetch('https://api.openf1.org/v1/sessions?session_key=latest');
  const sessions = (await sessionsRes.json()) as Session[];
  
  if (sessions && sessions.length > 0) {
    const latestSessionKey = sessions[0].session_key;

    const messagesRes = await fetch(`https://api.openf1.org/v1/race_control?session_key=${latestSessionKey}`);
    const data = (await messagesRes.json()) as RaceControlMessage[];

    messages = data.reverse().slice(0, 8);
  }
} catch (error) {
  console.error("Error fetching Race Control data:", error);
}

const getFlagColor = (category: string): string => {
  switch (category) {
    case 'Flag': return 'bg-red';
    case 'SafetyCar': return 'bg-yellow';
    case 'Other': return 'bg-blue';
    case 'Drs': return 'bg-green';
    default: return 'bg-gray';
  }
};
---

<div class="race-control-widget">
  <div class="widget-header">
    <div class="title-flex">
      <span class="live-dot"></span>
      <h3>FIA Race Control</h3>
    </div>
    <span class="api-credit">Powered by OpenF1</span>
  </div>

  {messages.length === 0 ? (
    <div class="empty-state">
      <p>Waiting for 2026 Race Control messages...</p>
    </div>
  ) : (
    <ul class="message-feed">
      {messages.map((msg: RaceControlMessage) => (
        <li class="message-item">
          <div class="msg-meta">
            <span class="lap-badge">Lap {msg.lap_number || '-'}</span>
            <span class={`category-pill ${getFlagColor(msg.category)}`}>
              {msg.category}
            </span>
          </div>
          <p class="msg-text">{msg.message}</p>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
.race-control-widget {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0; /* CRITICAL */
    background: transparent;
    border-radius: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .widget-header {
    background: #1e293b;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
  }

  .title-flex {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.8);
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.5; }
    100% { transform: scale(0.95); opacity: 1; }
  }

  h3 {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .api-credit {
    color: #64748b;
    font-size: 0.7rem;
    font-weight: 600;
  }

.message-feed {
    list-style: none;
    margin: 0;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1 1 0%; /* CRITICAL FIX: Replaces flex-grow: 1 */
    overflow-y: auto;
    min-height: 0; /* CRITICAL */
  }

  .message-feed::-webkit-scrollbar { width: 6px; }
  .message-feed::-webkit-scrollbar-track { background: #0f172a; }
  .message-feed::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

  .message-item {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #1e293b;
    transition: background 0.2s;
  }

  .message-item:hover {
    background: #161f30;
  }

  .msg-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .lap-badge {
    background: #334155;
    color: #f8fafc;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .category-pill {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  /* Category Colors - High Contrast Solid Backgrounds */
  .bg-red { background: #ef4444; color: #ffffff; border: none; }
  .bg-yellow { background: #facc15; color: #422006; border: none; font-weight: 900; } /* Dark brown/black text */
  .bg-blue { background: #38bdf8; color: #082f49; border: none; font-weight: 900; } /* Very dark blue text */
  .bg-green { background: #22c55e; color: #022c22; border: none; font-weight: 900; } /* Very dark green text */
  .bg-gray { background: #475569; color: #f8fafc; border: none; }

  .msg-text {
    color: #e2e8f0;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    font-weight: 500;
  }

  .empty-state {
    padding: 2rem;
    text-align: center;
    color: #64748b;
    font-size: 0.9rem;
  }
</style>