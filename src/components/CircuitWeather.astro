---
// src/components/CircuitWeather.astro

export interface Props {
  lat: number;
  lon: number;
  locationName: string;
}

const { lat, lon, locationName } = Astro.props;

// It looks for your new secret API key in the .env file
const apiKey = import.meta.env.WEATHERAPI_KEY || import.meta.env.PUBLIC_WEATHERAPI_KEY;

// SET DEFAULT AS MOCK DATA
// This prevents the "Loading... 0°C" trap if the API fetch fails or the key is invalid
let weather = {
  temp: 19,
  condition: 'Partly Cloudy',
  wind: 18,
  humidity: 65,
  iconCode: 1003,
  isDay: 1,
  isLive: false
};

try {
  if (apiKey && apiKey !== 'your_new_api_key_here') {
    // Fetch live data from WeatherAPI.com
    const res = await fetch(`https://api.weatherapi.com/v1/current.json?key=${apiKey}&q=${lat},${lon}&aqi=no`);
    
    if (res.ok) {
      const data = await res.json();
      weather = {
        temp: Math.round(data.current.temp_c),
        condition: data.current.condition.text, // e.g., "Partly cloudy", "Clear"
        wind: Math.round(data.current.wind_kph), 
        humidity: data.current.humidity,
        iconCode: data.current.condition.code,
        isDay: data.current.is_day,
        isLive: true
      };
    } else {
      console.warn(`WeatherAPI fetch failed with status: ${res.status}. Using mock data.`);
    }
  }
} catch (error) {
  console.error("WeatherAPI fetch encountered an error:", error);
}

// Map WeatherAPI.com condition codes to custom SVG emojis/icons
const getWeatherEmoji = (code: number, isDay: number) => {
  if (code === 1000) return isDay ? '☀️' : '🌙';
  if (code === 1003) return isDay ? '⛅' : '☁️';
  if ([1006, 1009].includes(code)) return '☁️';
  if ([1030, 1135, 1148].includes(code)) return '🌫️';
  if ([1087, 1273, 1276, 1279, 1282].includes(code)) return '⛈️';
  if ([1066, 1069, 1072, 1114, 1117, 1213, 1219, 1222, 1225, 1237, 1249, 1252, 1255, 1258, 1261, 1264].includes(code)) return '❄️';
  if ([1063, 1150, 1153, 1168, 1171, 1180, 1183, 1186, 1189, 1192, 1195, 1198, 1201, 1240, 1243, 1246].includes(code)) return '🌧️';
  
  return isDay ? '🌤️' : '🌙'; 
};
---

<div class="weather-card">
  <div class="card-header">
    <div class="title-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
      </svg>
      <h3>Track Weather: {locationName}</h3>
    </div>
    {weather.isLive ? (
      <span class="live-badge"><span class="live-dot"></span>Live API</span>
    ) : (
      <span class="mock-badge">Mock Data</span>
    )}
  </div>

  <div class="weather-grid">
    <div class="w-main">
      <span class="w-emoji">{getWeatherEmoji(weather.iconCode, weather.isDay)}</span>
      <div class="w-temp">
        <span class="val">{weather.temp}°</span>
        <span class="unit">C</span>
      </div>
      <span class="w-cond">{weather.condition}</span>
    </div>

    <div class="w-details">
      <div class="w-item">
        <span class="label">Wind</span>
        <span class="value">{weather.wind} <small>km/h</small></span>
      </div>
      <div class="w-item">
        <span class="label">Humidity</span>
        <span class="value">{weather.humidity} <small>%</small></span>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.5rem;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.75rem;
  }

  .title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .live-badge, .mock-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .live-badge { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .mock-badge { background: rgba(250, 204, 21, 0.15); color: #facc15; border: 1px solid rgba(250, 204, 21, 0.3); }

  .live-dot {
    width: 6px; height: 6px; background: #34d399; border-radius: 50%;
    box-shadow: 0 0 6px #34d399; animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.5; }
    100% { transform: scale(0.95); opacity: 1; }
  }

  .weather-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .w-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .w-emoji { font-size: 2.5rem; line-height: 1; margin-bottom: 0.25rem; }

  .w-temp {
    display: flex;
    align-items: flex-start;
  }

  .w-temp .val { font-size: 3rem; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
  .w-temp .unit { font-size: 1.2rem; font-weight: 700; color: #94a3b8; margin-top: 0.25rem; }

  .w-cond { color: #38bdf8; font-weight: 700; font-size: 1rem; margin-top: 0.25rem; }

  .w-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .w-item {
    background: #0b0f19;
    border: 1px solid #334155;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .w-item .label { color: #94a3b8; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
  .w-item .value { color: #ffffff; font-size: 1.1rem; font-weight: 800; }
  .w-item small { color: #64748b; font-size: 0.8rem; }

  @media (max-width: 480px) {
    .weather-grid { flex-direction: column; align-items: stretch; gap: 1.5rem; }
    .w-main { align-items: center; }
  }
</style>