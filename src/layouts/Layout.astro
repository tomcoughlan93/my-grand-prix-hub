---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';

// 1. Define Props Type Interface
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

// 2. Destructure Props with Fallback Default Strings
const { 
  title = "My Grand Prix Hub | F1 Circuit, Travel & Viewing Guides", 
  description = "Your ultimate fan guide for F1 travel logistics, grandstand reviews, trackside city guides, and broadcast options.",
  image = "/default-og-image.jpg",
  type = "website"
} = Astro.props;

// 3. Construct Absolute URLs for SEO and Social Sharing
// This ensures platforms like X and WhatsApp can properly fetch the images
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const socialImageURL = new URL(image, Astro.site || Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <!-- Persistent Site Header -->
    <Header />

    <!-- Main Dynamic Content Slot -->
    <slot />

    <!-- Persistent Site Footer -->
    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; {new Date().getFullYear()} My Grand Prix Hub. Unofficial fan guide, not affiliated with Formula 1.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* 1. Global CSS Variables */
  :root {
    --color-bg: #0f172a;
    --color-card: #1e293b;
    --color-border: #334155;
    --color-primary: #e10600; /* F1 Red */
    --color-text: #f8fafc;
    --color-muted: #94a3b8;
  }

  /* 2. CSS Box Reset */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* 3. Base Document Layout */
  html, body {
    min-height: 100vh;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    display: block;
    width: 100%;
    flex: 1 0 auto;
  }

  section {
    display: block;
    width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* 4. Global Footer Styling */
  .site-footer {
    background-color: #0b0f19;
    border-top: 1px solid var(--color-border);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>