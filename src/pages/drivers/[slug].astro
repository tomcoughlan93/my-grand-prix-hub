---
import Layout from '@/layouts/Layout.astro';
import seasonData from '@/content/results/season-2026.json';
import { TEAMS } from '@/data/teams';
import Parser from 'rss-parser';

export async function getStaticPaths() {
  const driverFiles = import.meta.glob('/src/content/drivers/*.md', { eager: true });

  return Object.entries(driverFiles).map(([path, file]: [string, any]) => {
    const slug = path.split('/').pop()?.replace('.md', '') || '';
    return {
      params: { slug },
      props: {
        driver: file.frontmatter,
        Content: file.Content,
      },
    };
  });
}

const { driver, Content } = Astro.props;

// --- 1. FIND TEAMMATE LOGIC ---
const code = driver.code.toUpperCase().trim();
const currentTeam = TEAMS.find(t => t.d1 === code || t.d2 === code);
let teammate: any = null;

if (currentTeam) {
  if (currentTeam.d1 === code) {
    teammate = { name: currentTeam.d2Name, code: currentTeam.d2, number: currentTeam.d2Number, slug: currentTeam.d2Slug };
  } else {
    teammate = { name: currentTeam.d1Name, code: currentTeam.d1, number: currentTeam.d1Number, slug: currentTeam.d1Slug };
  }
}

// --- 2. RSS PARSER (DRIVER SPECIFIC) ---
interface CustomFeedItem {
  mediaContent?: any;
  mediaThumbnail?: any;
  enclosure?: { url?: string };
  contentEncoded?: string;
  description?: string;
  content?: string;
  summary?: string;
  contentSnippet?: string;
  title?: string;
  link?: string;
  pubDate?: string;
  image?: any;
}

const parser: Parser<{}, CustomFeedItem> = new Parser({
  customFields: {
    item: [
      ['media:content', 'mediaContent', { keepArray: true }],
      ['media:thumbnail', 'mediaThumbnail', { keepArray: true }],
      ['media:group', 'mediaGroup', { keepArray: true }],
      ['content:encoded', 'contentEncoded'],
      ['description', 'description'],
      ['image', 'image']
    ],
  },
});

const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' },
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;
  if (item.enclosure && item.enclosure.url) url = item.enclosure.url;
  if (!url && item.mediaContent && Array.isArray(item.mediaContent)) {
    const found = item.mediaContent.find((m: any) => m.$?.url || m.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) {
    const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && (item as any).mediaGroup && Array.isArray((item as any).mediaGroup)) {
    const group = (item as any).mediaGroup[0];
    if (group && group['media:content'] && Array.isArray(group['media:content'])) {
      const found = group['media:content'].find((m: any) => m.$?.url || m.url);
      if (found) url = found.$?.url || found.url;
    }
  }
  if (!url && item.image) {
    if (typeof item.image === 'string') url = item.image;
    else if (item.image.url) url = item.image.url;
    else if (item.image.$ && item.image.$.url) url = item.image.$.url;
  }
  if (!url) {
    const htmlString = [item.contentEncoded, item.content, item.summary, item.description, item.contentSnippet].filter(Boolean).join(' ');
    const dataSrcMatch = htmlString.match(/<img[^>]+data-src\s*=\s*["']([^"']+)["']/i);
    if (dataSrcMatch && dataSrcMatch[1]) url = dataSrcMatch[1];
    else {
      const srcMatch = htmlString.match(/<img[^>]+src\s*=\s*["']([^"']+)["']/i);
      if (srcMatch && srcMatch[1]) url = srcMatch[1];
    }
  }
  if (!url) {
    const itemStr = JSON.stringify(item);
    const regex = /(https?:\/\/[^"'\s>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\s>]*)?)/i;
    const match = itemStr.match(regex);
    if (match && match[1]) url = match[1];
  }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  return url;
}

let driverNews: any[] = [];
try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems = [];
      for (const item of feed.items || []) {
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!hasValidDate) continue;
        const imageUrl = extractImage(item, src.name);
        if (src.name === 'RacingNews365' && !imageUrl) continue;
        const rawDescription = item.contentEncoded || item.content || item.summary || item.description || item.contentSnippet || '';
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDateStr: new Date(item.pubDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
          source: src.name,
          snippet: cleanSnippet(rawDescription),
          imageUrl: imageUrl || null,
          timestamp: new Date(item.pubDate!).getTime(),
        });
      }
      return validItems;
    } catch (err) { return []; }
  });

  const rssResults = await Promise.all(feedPromises);
  const globalRssFeed = rssResults.flat().sort((a, b) => b.timestamp - a.timestamp);

  // Filter for THIS driver specifically
  const lastName = driver.name.split(' ').pop() || '';
  const escapeRegExp = (str: string) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const driverRegex = new RegExp(`\\b(${escapeRegExp(driver.name)}|${escapeRegExp(lastName)})\\b`, 'i');

  const matchedNews = globalRssFeed.filter((article: any) => {
    return driverRegex.test(article.title) || driverRegex.test(article.snippet);
  });

  driverNews = matchedNews.slice(0, 3);
} catch (e) {}

// --- 3. CALENDAR & SEASON RESULTS ---
const ROUND_DATA = [
  { round: 1, name: 'AUS', flag: 'au', gp: 'Australian GP' }, { round: 2, name: 'CHN', flag: 'cn', gp: 'Chinese GP' },
  { round: 3, name: 'JPN', flag: 'jp', gp: 'Japanese GP' }, { round: 4, name: 'MIA', flag: 'us', gp: 'Miami GP' },
  { round: 5, name: 'CAN', flag: 'ca', gp: 'Canadian GP' }, { round: 6, name: 'MON', flag: 'mc', gp: 'Monaco GP' },
  { round: 7, name: 'ESP', flag: 'es', gp: 'Spanish GP' }, { round: 8, name: 'AUT', flag: 'at', gp: 'Austrian GP' },
  { round: 9, name: 'GBR', flag: 'gb', gp: 'British GP' }, { round: 10, name: 'BEL', flag: 'be', gp: 'Belgian GP' },
  { round: 11, name: 'HUN', flag: 'hu', gp: 'Hungarian GP' }, { round: 12, name: 'NED', flag: 'nl', gp: 'Dutch GP' },
  { round: 13, name: 'ITA', flag: 'it', gp: 'Italian GP' }, { round: 14, name: 'MAD', flag: 'es', gp: 'Madrid GP' },
  { round: 15, name: 'AZE', flag: 'az', gp: 'Azerbaijan GP' }, { round: 16, name: 'BHR', flag: 'bh', gp: 'Bahrain GP' },
  { round: 17, name: 'SIN', flag: 'sg', gp: 'Singapore GP' }, { round: 18, name: 'USA', flag: 'us', gp: 'United States GP' },
  { round: 19, name: 'MEX', flag: 'mx', gp: 'Mexico City GP' }, { round: 20, name: 'SAP', flag: 'br', gp: 'São Paulo GP' },
  { round: 21, name: 'LVG', flag: 'us', gp: 'Las Vegas GP' }, { round: 22, name: 'QAT', flag: 'qa', gp: 'Qatar GP' },
  { round: 23, name: 'ABU', flag: 'ae', gp: 'Abu Dhabi GP' }
];

const gridDriver = seasonData?.drivers?.find((d: any) => String(d.code).toUpperCase().trim() === code) as any;
const seasonResults: (string | number)[] = [];
let seasonPodiums = 0;
let seasonWins = 0;
let seasonPointsFinishes = 0;

for (let i = 1; i <= 23; i++) {
  const val = gridDriver?.[`r${i}`] ? String(gridDriver[`r${i}`]).trim().toUpperCase() : '-';
  if (val === 'RET' || val === 'DNF' || val === 'DSQ') {
    seasonResults.push('RET');
  } else if (val === '-' || val === '') {
    seasonResults.push('-');
  } else {
    const pos = parseInt(val, 10);
    if (!isNaN(pos)) {
      seasonResults.push(pos);
      if (pos === 1) seasonWins++;
      if (pos <= 3) seasonPodiums++;
      if (pos <= 10) seasonPointsFinishes++;
    } else {
      seasonResults.push(val);
    }
  }
}

// --- 4. API STANDINGS ---
let currentStanding = { pos: '--', points: 0, wins: seasonWins };
try {
  const res = await fetch('https://api.jolpi.ca/ergast/f1/current/driverStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } });
  if (res.ok) {
    const data = await res.json();
    const dList = data?.MRData?.StandingsTable?.StandingsLists?.[0]?.DriverStandings;
    if (dList) {
      const match = dList.find((item: any) => (item.Driver.code && item.Driver.code.toUpperCase() === code) || item.Driver.familyName.toLowerCase().includes(driver.name.split(' ').pop()?.toLowerCase() || ''));
      if (match) {
        currentStanding = { pos: match.position, points: parseFloat(match.points) || 0, wins: parseInt(match.wins) || seasonWins };
      }
    }
  }
} catch {}

function getFormBadgeClass(result: number | string): string {
  const resStr = String(result).toUpperCase().trim();
  if (resStr === 'RET') return 'badge-ret';
  if (resStr === 'DNS' || resStr === 'DSQ') return 'badge-dns';
  if (resStr === '-' || resStr === '') return 'badge-dnp';
  const num = parseInt(resStr, 10);
  if (!isNaN(num)) {
    if (num === 1) return 'badge-p1';
    if (num === 2) return 'badge-p2';
    if (num === 3) return 'badge-p3';
    if (num <= 10) return 'badge-points';
  }
  return 'badge-out';
}
---

<Layout
  title={`${driver.name} (#${driver.number}) | F1 Driver Profile | My Grand Prix Hub`}
  description={`Official 2026 driver profile for ${driver.name}. Career biography, race results timeline, championship standing, and statistics.`}
>
  <main class="driver-profile-container">
    
    <nav class="breadcrumb-nav">
      <a href="/championship/standings">Standings</a>
      <span class="sep">/</span>
      <a href={`/teams/${currentTeam?.slug}`}>{driver.team}</a>
      <span class="sep">/</span>
      <span class="current">{driver.name}</span>
    </nav>

    <header class="driver-hero" style={`--team-accent: ${driver.teamColor};`}>
      <div class="hero-glow"></div>
      <span class={`hero-number-bg ${driver.number < 10 ? 'single-digit' : ''}`}>#{driver.number}</span>

      <div class="hero-content">
        <div class="hero-meta-top">
          <div class="team-pill">
            <span class="team-dot" style={`background-color: ${driver.teamColor};`}></span>
            <span class="team-name">{driver.team}</span>
          </div>
          <div class="nat-pill">
            <img src={`https://flagcdn.com/w20/${driver.countryCode}.png`} width="16" height="12" alt={driver.nationality} class="flag-img" />
            <span>{driver.nationality}</span>
          </div>
        </div>

        <div class="hero-title-row">
          <h1>{driver.name}</h1>
          <span class="driver-tag">{driver.code}</span>
        </div>

        <div class="season-stats-strip">
          <div class="stat-card">
            <span class="stat-label">2026 Championship</span>
            <div class="stat-val-group"><span class="stat-val">{currentStanding.pos !== '--' ? `P${currentStanding.pos}` : '--'}</span></div>
          </div>
          <div class="stat-card">
            <span class="stat-label">World Titles</span>
            <div class="stat-val-group"><span class="stat-val">{driver.worldTitles}</span></div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Points</span>
            <div class="stat-val-group"><span class="stat-val">{currentStanding.points}</span><span class="stat-sub">PTS</span></div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Wins</span>
            <div class="stat-val-group"><span class="stat-val">{currentStanding.wins}</span></div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Podiums</span>
            <div class="stat-val-group"><span class="stat-val">{seasonPodiums}</span></div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Top 10 Finishes</span>
            <div class="stat-val-group"><span class="stat-val">{seasonPointsFinishes}</span></div>
          </div>
        </div> 
      </div> 
    </header> 

    <!-- Content Grid (Bio/Vitals on left, Teammate on right) -->
    <div class="profile-layout-grid">
      
      <div class="main-column">
        <!-- Vitals Grid -->
        {(driver.dob || driver.birthplace || driver.debut) && (
          <section class="profile-section">
            <div class="section-title-row">
              <h2>Driver Profile</h2>
              <div class="social-links">
                {driver.socials?.x && <a href={driver.socials.x} target="_blank" rel="noopener noreferrer" title="X (Twitter)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>}
                {driver.socials?.instagram && <a href={driver.socials.instagram} target="_blank" rel="noopener noreferrer" title="Instagram"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>}
              </div>
            </div>
            
            <div class="vitals-grid">
              {driver.dob && <div class="vital-item"><span class="v-label">Date of Birth</span><span class="v-val">{driver.dob}</span></div>}
              {driver.birthplace && <div class="vital-item"><span class="v-label">Place of Birth</span><span class="v-val">{driver.birthplace}</span></div>}
              {driver.debut && <div class="vital-item"><span class="v-label">F1 Debut</span><span class="v-val">{driver.debut}</span></div>}
            </div>
          </section>
        )}

        <!-- Biography -->
        <section class="profile-section">
          <div class="section-title-row">
            <h2>Career Notes</h2>
          </div>
          <div class="bio-card">
            <div class="prose-content">
              <Content />
            </div>
          </div>
        </section>
      </div>

      <aside class="sidebar-column">
        <!-- Across The Garage -->
        {teammate && (
          <section class="profile-section">
            <div class="section-title-row">
              <h2>Teammate</h2>
              <span class="section-badge">Across The Garage</span>
            </div>
            
            <a href={`/drivers/${teammate.slug}`} class="typo-driver-card" style={`--accent: ${driver.teamColor}`}>
              <div class={`driver-bg-number ${teammate.number < 10 ? 'single-digit' : ''}`}>{teammate.number}</div>
              <div class="driver-card-content">
                <div class="d-info-top">
                  <span class="d-tag">{teammate.code}</span>
                </div>
                <div class="d-info-bottom">
                  <h3>{teammate.name}</h3>
                  <span class="view-profile-btn">View Profile →</span>
                </div>
              </div>
            </a>
          </section>
        )}
      </aside>
    </div>

    <!-- 2026 Season Timeline -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>2026 Grand Prix Results</h2>
        <span class="section-badge">Season Tracker</span>
      </div>

      <div class="timeline-card">
        <div class="full-season-grid">
          {seasonResults.map((res, index) => {
            const raceInfo = ROUND_DATA[index];
            return (
              <div class="season-race-box" title={raceInfo.gp}>
                <img src={`https://flagcdn.com/w20/${raceInfo.flag}.png`} alt={raceInfo.name} class="race-card-flag" loading="lazy" />
                <span class="race-round">{raceInfo.name}</span>
                <span class={`form-circle ${getFormBadgeClass(res)}`}>{res}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Latest Driver News -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>Latest {driver.name.split(' ').pop()} News</h2>
        <span class="section-badge">Around The Paddock</span>
      </div>

      {driverNews && driverNews.length > 0 ? (
        <div class="news-grid">
          {driverNews.map((article: any) => (
            <a href={article.link} target="_blank" rel="noopener noreferrer" class="news-card">
              {article.imageUrl && (
                <div class="card-image-wrap">
                  <img src={article.imageUrl} alt={article.title} loading="lazy" class="card-image" />
                </div>
              )}
              <div class="news-content">
                <div class="news-meta">
                  <span class="feed-source" style={`color: ${driver.teamColor}`}>{article.source}</span>
                  <span class="news-date">{article.pubDateStr}</span>
                </div>
                <h3 class="news-title">{article.title}</h3>
                {article.snippet && <p class="news-excerpt">{article.snippet}</p>}
                <span class="read-more">Read on {article.source} ↗</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="news-empty-state">
          <p>Currently scouting the paddock for the latest updates on {driver.name}.</p>
        </div>
      )}
    </section>

  </main>
</Layout>

<style>
  .driver-profile-container { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.5rem 6rem; color: #f1f5f9; box-sizing: border-box; }
  .breadcrumb-nav { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; font-weight: 600; }
  .breadcrumb-nav a { color: #38bdf8; text-decoration: none; }
  .breadcrumb-nav a:hover { text-decoration: underline; }
  .breadcrumb-nav .sep { color: #334155; }
  .breadcrumb-nav .current { color: #94a3b8; }

  /* Hero Section */
  .driver-hero { position: relative; background: #0f172a; border: 1px solid #1e293b; border-radius: 16px; overflow: hidden; padding: 3rem; margin-bottom: 3.5rem; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4); }
  .hero-glow { position: absolute; top: -50px; right: -50px; width: 320px; height: 320px; background: radial-gradient(circle, var(--team-accent) 0%, rgba(15, 23, 42, 0) 70%); opacity: 0.18; pointer-events: none; }
  .hero-number-bg { position: absolute; right: -2%; bottom: -1.5rem; font-size: 14rem; font-weight: 900; line-height: 1; color: var(--team-accent); opacity: 0.08; font-style: italic; user-select: none; pointer-events: none; font-variant-numeric: tabular-nums; transition: right 0.3s; }
  .hero-number-bg.single-digit { right: 5%; }
  
  .hero-content { position: relative; z-index: 2; }
  .hero-meta-top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .team-pill { display: inline-flex; align-items: center; gap: 0.5rem; background: #1e293b; border: 1px solid #334155; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 700; color: #ffffff; }
  .team-dot { width: 8px; height: 8px; border-radius: 50%; }
  .nat-pill { display: inline-flex; align-items: center; gap: 0.4rem; background: #1e293b; border: 1px solid #334155; padding: 0.35rem 0.65rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; color: #94a3b8; }
  .flag-img { border-radius: 2px; }
  
  .hero-title-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .hero-title-row h1 { font-size: 3.25rem; font-weight: 900; color: #ffffff; letter-spacing: -0.03em; margin: 0; }
  .driver-tag { background: #1e293b; color: #38bdf8; font-size: 1rem; font-weight: 800; padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid #334155; }

  /* Stat Strip */
  .season-stats-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; max-width: 720px; }
  .stat-card { background: #1e293b; border: 1px solid #334155; padding: 1rem 1.25rem; border-radius: 10px; display: flex; flex-direction: column; justify-content: space-between; gap: 0.5rem; }
  .stat-label { font-size: 0.72rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-val-group { display: flex; align-items: baseline; gap: 0.35rem; }
  .stat-val { font-size: 1.75rem; font-weight: 900; color: #ffffff; font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: 0.75rem; font-weight: 800; color: #e10600; }

  /* Page Layout Grid */
  .profile-layout-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 1rem; }
  
  /* Sections */
  .profile-section { margin-bottom: 3.5rem; }
  .section-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1px solid #334155; padding-bottom: 0.75rem; }
  .section-title-row h2 { font-size: 1.5rem; font-weight: 800; color: #ffffff; margin: 0; }
  .section-badge { background: #0f172a; color: #38bdf8; border: 1px solid #334155; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 4px; text-transform: uppercase; }

  /* Vitals & Socials */
  .social-links { display: flex; gap: 0.75rem; }
  .social-links a { color: #64748b; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: #1e293b; border: 1px solid #334155; transition: all 0.2s ease; }
