---
// src/pages/live.astro
import Layout from '@/layouts/Layout.astro';
import RaceControlTicker from '@/components/RaceControlTicker.astro';
import LiveTimingTower from '@/components/LiveTimingTower.astro';
import TeamRadioFeed from '@/components/TeamRadioFeed.astro';
import SectorLapBoard from '@/components/SectorLapBoard.astro';

interface OpenF1Session {
  session_key: number;
  session_name: string;
  country_name?: string;
  circuit_short_name?: string;
}

interface OpenF1Weather {
  track_temperature: number;
  air_temperature: number;
}

interface OpenF1RaceControl {
  flag?: string;
  category: string;
}

interface OpenF1Lap {
  lap_number: number;
}

// Default / Fallback Session Info (2026 Spec)
let sessionInfo = {
  name: 'Dutch Grand Prix - Race',
  status: 'GREEN', // GREEN, YELLOW, RED, VSC, CHEQUERED
  lap: '42 / 72',
  trackTemp: '31°C',
  airTemp: '19°C'
};

try {
  // 1. Fetch the exact current or most recent session using the 'latest' shortcut
  const sessionRes = await fetch('https://api.openf1.org/v1/sessions?session_key=latest');
  const sessions = (await sessionRes.json()) as OpenF1Session[];

  if (sessions && sessions.length > 0) {
    const latestSession = sessions[0]; // It only returns one item now!
    const sessionKey = latestSession.session_key;

    // 2. Fetch Weather, Race Control, and Laps simultaneously
    const [weatherRes, rcRes, lapsRes] = await Promise.all([
      fetch(`https://api.openf1.org/v1/weather?session_key=${sessionKey}`),
      fetch(`https://api.openf1.org/v1/race_control?session_key=${sessionKey}`),
      fetch(`https://api.openf1.org/v1/laps?session_key=${sessionKey}`)
    ]);

    const weatherData = (await weatherRes.json()) as OpenF1Weather[];
    const rcData = (await rcRes.json()) as OpenF1RaceControl[];
    const lapsData = (await lapsRes.json()) as OpenF1Lap[];

    // Session Title
    if (latestSession.session_name) {
      const location = latestSession.circuit_short_name || latestSession.country_name || 'Grand Prix';
      sessionInfo.name = `${location} - ${latestSession.session_name}`;
    }

    // Weather Temps
    if (weatherData && weatherData.length > 0) {
      const latestWeather = weatherData[weatherData.length - 1];
      sessionInfo.trackTemp = `${Math.round(latestWeather.track_temperature)}°C`;
      sessionInfo.airTemp = `${Math.round(latestWeather.air_temperature)}°C`;
    }

    // Flag Status
    if (rcData && rcData.length > 0) {
      const flagMessages = rcData.filter(m => m.flag);
      if (flagMessages.length > 0) {
        sessionInfo.status = flagMessages[flagMessages.length - 1].flag?.toUpperCase() || 'GREEN';
      }
    }

    // Lap Counter
    if (lapsData && lapsData.length > 0) {
      const validLaps = lapsData.map(l => l.lap_number).filter(n => typeof n === 'number' && n > 0);
      if (validLaps.length > 0) {
        const maxLap = Math.max(...validLaps);
        sessionInfo.lap = `${maxLap}`;
      }
    }
  }
} catch (error) {
  console.error("Failed to fetch live session header info:", error);
}
---

<Layout 
  title="Live Race Centre | F1 Live Timing & Telemetry | My Grand Prix Hub"
  description="Second-screen live dashboard for F1 sessions. Live timing, race control, and telemetry."
>
  <div class="dashboard-wrapper">
    
    <!-- TOP STATUS BAR -->
    <header class="dash-header">
      <div class="header-left">
        <span class="live-pulse"></span>
        <h1>{sessionInfo.name}</h1>
      </div>
      
      <div class="header-center">
        <div class={`flag-status status-${sessionInfo.status.toLowerCase()}`}>
          {sessionInfo.status} FLAG
        </div>
        <div class="lap-counter">LAP {sessionInfo.lap}</div>
      </div>

      <div class="header-right">
        <div class="env-stat"><span>Track:</span> {sessionInfo.trackTemp}</div>
        <div class="env-stat"><span>Air:</span> {sessionInfo.airTemp}</div>
      </div>
    </header>

    <!-- 3-COLUMN DASHBOARD GRID -->
    <main class="dash-grid">
      
      <!-- COLUMN 1: LIVE TIMING TOWER -->
      <aside class="widget-panel timing-tower">
        <LiveTimingTower />
      </aside>

      <!-- COLUMN 2: CENTER STAGE (Sector Board & Radio) -->
      <section class="center-stage">
        
        <div class="stage-upper">
          <SectorLapBoard />
        </div>

        <div class="stage-lower">
          <TeamRadioFeed />
        </div>

      </section>

      <!-- COLUMN 3: RACE CONTROL & WEATHER -->
      <aside class="right-panel">
        
        <div class="rc-wrapper">
          <RaceControlTicker />
        </div>

        <div class="widget-panel weather-widget">
          <div class="widget-header">
            <h2>Live Weather Radar</h2>
          </div>
          <div class="weather-content">
             <div class="radar-placeholder">
               <span class="cloud-icon">⛅</span>
               <span>No rain expected in the next 30 mins</span>
             </div>
          </div>
        </div>

      </aside>
    </main>
  </div>
</Layout>

<style is:global>
  /* --- 1. STANDARD PAGE LAYOUT --- */
  body {
    background-color: #0b0f19;
    margin: 0;
  }

  .dashboard-wrapper {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    min-height: calc(100vh - 80px); 
  }

  /* --- 2. HEADER --- */
  .dash-header {
    display: flex; justify-content: space-between; align-items: center;
    background: #1e293b; border: 1px solid #334155; border-radius: 8px;
    padding: 0.75rem 1.5rem; margin-bottom: 1.5rem; flex-shrink: 0;
  }
  .header-left { display: flex; align-items: center; gap: 0.75rem; }
  .live-pulse { width: 10px; height: 10px; background: #e10600; border-radius: 50%; box-shadow: 0 0 10px #e10600; animation: pulse 1.5s infinite; }
  .header-left h1 { font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0; text-transform: uppercase; }
  .header-center { display: flex; align-items: center; gap: 1rem; }
  .flag-status { font-weight: 900; font-size: 0.9rem; padding: 0.35rem 1rem; border-radius: 4px; letter-spacing: 0.05em; }
  .status-green { background: #34d399; color: #064e3b; }
  .status-yellow { background: #facc15; color: #713f12; animation: flash 1s infinite; }
  .status-red { background: #ef4444; color: #7f1d1d; }
  .status-chequered { background: #ffffff; color: #000000; }
  .status-vsc { background: #f97316; color: #431407; }
  @keyframes flash { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
  .lap-counter { color: #f8fafc; font-weight: 800; font-size: 1.1rem; }
  .header-right { display: flex; gap: 1.5rem; }
  .env-stat { color: #ffffff; font-weight: 700; font-size: 0.95rem; }
  .env-stat span { color: #64748b; font-size: 0.8rem; text-transform: uppercase; margin-right: 0.25rem; }

  /* --- 3. THE DASHBOARD GRID --- */
  .dash-grid {
    display: grid;
    grid-template-columns: 350px 1fr 350px;
    gap: 1.5rem;
    height: calc(100vh - 160px); 
    min-height: 750px; 
    margin-bottom: 2rem; 
  }

  /* --- 4. COLUMN CONTAINERS --- */
  .timing-tower, .right-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.5rem;
    min-height: 0;
  }

  .center-stage {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
    height: 100%;
    min-height: 0;
  }

  /* --- 5. THE WIDGET PANELS --- */
  .widget-panel, .stage-upper, .stage-lower, .rc-wrapper {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    overflow: hidden !important; 
    min-height: 0;
    height: 100%;
  }

  .rc-wrapper { flex-grow: 1; }
  .weather-widget { height: 150px; flex-shrink: 0; }

  /* Weather Widget Header Styling */
  .weather-widget .widget-header {
    background: #1e293b;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #334155;
  }
  
  .weather-widget .widget-header h2 {
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* --- 6. THE CSS GRID FIX --- */
  :global(.timing-tower-container),
  :global(.sector-board-widget) {
    display: grid !important;
    grid-template-rows: auto auto 1fr !important; 
    height: 100% !important;
    width: 100% !important;
    overflow: hidden !important;
  }

  :global(.team-radio-container),
  :global(.race-control-widget) {
    display: grid !important;
    grid-template-rows: auto 1fr !important; 
    height: 100% !important;
    width: 100% !important;
    overflow: hidden !important;
  }

  :global(.timing-list),
  :global(.board-list),
  :global(.radio-feed),
  :global(.message-feed) {
    height: 100% !important;
    overflow-y: auto !important;
    margin: 0 !important;
  }

  :global(.timing-list)::-webkit-scrollbar,
  :global(.board-list)::-webkit-scrollbar,
  :global(.radio-feed)::-webkit-scrollbar,
  :global(.message-feed)::-webkit-scrollbar { width: 6px; }
  
  :global(.timing-list)::-webkit-scrollbar-thumb,
  :global(.board-list)::-webkit-scrollbar-thumb,
  :global(.radio-feed)::-webkit-scrollbar-thumb,
  :global(.message-feed)::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

  /* Weather Box Styling */
  .weather-content { flex-grow: 1; display: flex; align-items: center; justify-content: center; }
  .radar-placeholder { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #94a3b8; font-size: 0.85rem; font-weight: 600; }
  .cloud-icon { font-size: 2rem; }

  /* --- 8. RESPONSIVE DESIGN --- */
  @media (max-width: 1100px) {
    .dash-grid { grid-template-columns: 300px 1fr; }
    .right-panel { display: none; }
  }

  @media (max-width: 768px) {
    .dash-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .dash-grid { display: flex; flex-direction: column; height: auto; }
    .timing-tower { height: 600px; }
    .center-stage { display: flex; flex-direction: column; }
    .stage-upper { height: 450px; }
    .stage-lower { height: 450px; }
    .right-panel { display: flex; }
    .rc-wrapper { height: 450px; }
  }
</style>

<script is:inline>
  let dashboardTimer;

  async function refreshDashboard() {
    try {
      const response = await fetch(window.location.href);
      const htmlText = await response.text();
      
      const parser = new DOMParser();
      const newDoc = parser.parseFromString(htmlText, 'text/html');

      // 1. Swap Header Status Bar
      const newHeader = newDoc.querySelector('.dash-header');
      const oldHeader = document.querySelector('.dash-header');
      if (newHeader && oldHeader) { oldHeader.innerHTML = newHeader.innerHTML; }

      // 2. Swap Live Timing Tower
      const newTiming = newDoc.querySelector('.timing-tower-container');
      const oldTiming = document.querySelector('.timing-tower-container');
      if (newTiming && oldTiming) { oldTiming.innerHTML = newTiming.innerHTML; }

      // 3. Swap Sector Lap Board
      const newSectors = newDoc.querySelector('.sector-board-widget');
      const oldSectors = document.querySelector('.sector-board-widget');
      if (newSectors && oldSectors) { oldSectors.innerHTML = newSectors.innerHTML; }

      // 4. Swap Race Control Ticker
      const newRC = newDoc.querySelector('.race-control-widget');
      const oldRC = document.querySelector('.race-control-widget');
      if (newRC && oldRC) { oldRC.innerHTML = newRC.innerHTML; }

      // 5. Swap Team Radio (Audio Safeguard)
      let isPlayingAudio = false;
      const audioPlayers = document.querySelectorAll('.f1-audio');
      audioPlayers.forEach(player => {
        if (!player.paused && !player.ended) { isPlayingAudio = true; }
      });

      if (!isPlayingAudio) {
        const newRadio = newDoc.querySelector('.team-radio-container');
        const oldRadio = document.querySelector('.team-radio-container');
        if (newRadio && oldRadio) { oldRadio.innerHTML = newRadio.innerHTML; }
      }

    } catch (error) {
      console.error("Dashboard silent refresh failed:", error);
    }
  }

  function initLiveDashboard() {
    if (dashboardTimer) clearInterval(dashboardTimer);
    dashboardTimer = setInterval(refreshDashboard, 15000);
  }

  document.addEventListener('DOMContentLoaded', initLiveDashboard);
  document.addEventListener('astro:page-load', initLiveDashboard);
</script>