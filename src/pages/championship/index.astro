---
// src/pages/championship/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Safely retrieve drivers collection
const driversCollection = (await getCollection('drivers')) || [];

// Dynamically calculate the counts
const driverCount = driversCollection.length;

// Extract unique team names from the drivers collection, fallback to 11 (the 2026 grid with Cadillac)
const uniqueTeams = new Set(driversCollection.map(driver => driver.data.team));
const teamCount = uniqueTeams.size > 0 ? uniqueTeams.size : 11;
---

<Layout 
  title="F1 Championship Hub | My Grand Prix Hub"
  description="Explore Formula 1 driver profiles, constructor team overviews, and live championship standings."
>
  <main class="page-container">
    <header class="section-header">
      <span class="badge">Formula 1 Season</span>
      <h1 class="gradient-title">Championship Hub</h1>
      <p>Your central destination for Formula 1 standings, team technical breakdowns, and driver profiles.</p>
    </header>

    <div class="hub-grid">
      {/* 1. STANDINGS CARD */}
      <div class="hub-card">
        <div class="card-badge">🏆 Championship Points</div>
        <h2>Driver & Team Standings</h2>
        <p>View full points breakdowns and current position leaderboards for both the Drivers' and Constructors' World Championships.</p>
        <a href="/championship/standings" class="hub-btn primary-btn">View Standings →</a>
      </div>

      {/* 2. TEAMS & DRIVERS CARD */}
      <div class="hub-card">
        <div class="card-badge">🏎️ Constructors & Grid</div>
        <h2>Teams & Drivers</h2>
        <p>In-depth team specification profiles, power unit details, car chassis models, and career biographies for every driver on the grid.</p>
        <div class="card-meta">{teamCount} Teams • {driverCount > 0 ? driverCount : 22} Drivers</div>
        <a href="/championship/teams-drivers" class="hub-btn primary-btn">Explore Teams & Drivers →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem 1.5rem;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    margin: 0;
    max-width: 700px;
    line-height: 1.6;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .hub-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .card-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .hub-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin: 0 0 1rem 0;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .hub-card p {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .card-meta {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #1e293b;
  }

  .hub-btn {
    display: block;
    text-align: center;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .primary-btn {
    background-color: transparent;
    border: 1px solid #334155;
    color: #ffffff;
  }

  .hub-card:hover .primary-btn {
    background-color: #e10600;
    border-color: #e10600;
  }

  @media (max-width: 768px) {
    .gradient-title { font-size: 2.75rem; }
    .hub-card { padding: 1.75rem; }
  }
</style>