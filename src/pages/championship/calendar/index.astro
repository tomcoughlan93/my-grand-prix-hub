  { season: "2026", round: "22", raceName: "Abu Dhabi Grand Prix", tyresAnnounced: false, tyres: ["C3", "C4", "C5"], Circuit: { circuitName: "Yas Marina Circuit", Location: { locality: "Abu Dhabi", country: "UAE", timezone: "Asia/Dubai", coordinates: { lat: 24.4672, lon: 54.6031 } } }, date: "2026-12-06", time: "13:00:00Z", sessions: { fp1: "2026-12-04T09:30:00Z", fp2: "2026-12-04T13:00:00Z", fp3: "2026-12-05T10:30:00Z", quali: "2026-12-05T14:00:00Z", race: "2026-12-06T13:00:00Z" } }
];

// --- 2. MAP DYNAMIC PODIUMS FROM TINA CMS ---
if (seasonData && seasonData.drivers) {
  for (const race of CALENDAR) {
    const roundKey = `r${race.round}`;
    const p1 = seasonData.drivers.find((d: any) => String(d[roundKey]) === "1");
    const p2 = seasonData.drivers.find((d: any) => String(d[roundKey]) === "2");
    const p3 = seasonData.drivers.find((d: any) => String(d[roundKey]) === "3");

    if (p1 && p2 && p3) {
      race.podium = {
        first: p1.code || "TBD",
        second: p2.code || "TBD",
        third: p3.code || "TBD"
      };
      // Make sure it displays in the hero session boxes too
      race.sessionResults = {
        race: race.podium
      };
    }
  }
}

// --- 3. DYNAMIC RACE SORTING LOGIC (THE "MONDAY RULE") ---
const now = new Date();
let nextRace: Race | null = null;
let upcomingRaces: Race[] = [];
let pastRaces: Race[] = [];

for (const race of CALENDAR) {
  const raceStartTime = new Date(race.sessions.race);
  
  // A race stays in the "Next Race" hero slot until 24 hours AFTER it starts.
  // This guarantees a Sunday 2pm race stays as the Hero until Monday 2pm.
  const heroExpirationTime = new Date(raceStartTime.getTime() + (24 * 60 * 60 * 1000));

  if (!nextRace) {
    // If we are currently *before* the Monday expiration time, this is our Hero!
    if (now < heroExpirationTime) {
      nextRace = race;
    } else {
      // The Monday expiration has passed, move it down to the completed pile
      pastRaces.push(race);
    }
  } else {
    // We already found our Hero. Add everything else to upcoming.
    upcomingRaces.push(race);
  }
}

pastRaces.reverse(); // Put the most recently completed races at the top of the past list

// --- 4. DYNAMIC NEXT SESSION COUNTDOWN & LIVE BADGE ---
let targetCountdown = "";
let targetSessionName = "Next Session";
let isSessionLive = false;
let isWeekendFinished = false;
let hasOfficialResults = !!nextRace?.podium;

if (nextRace) {
  const sessionsList = [
    { id: 'fp1', name: 'Practice 1', time: new Date(nextRace.sessions.fp1) },
    { id: 'fp2', name: nextRace.isSprint ? 'Sprint Quali' : 'Practice 2', time: new Date(nextRace.sessions.fp2) },
    { id: 'fp3', name: nextRace.isSprint ? 'Sprint Race' : 'Practice 3', time: new Date(nextRace.sessions.fp3) },
    { id: 'quali', name: 'Qualifying', time: new Date(nextRace.sessions.quali) },
    { id: 'race', name: 'Race', time: new Date(nextRace.sessions.race) }
  ];

  for (const session of sessionsList) {
    const sessionStart = session.time.getTime();
    // Rough session duration (1 hr for practice/quali, 2 hrs for race)
    const durationHours = session.id === 'race' ? 2 : 1; 
    const sessionEnd = sessionStart + (durationHours * 60 * 60 * 1000); 
    
    if (now.getTime() < sessionStart) {
      targetCountdown = session.time.toISOString();
      targetSessionName = session.name;
      break;
    } else if (now.getTime() >= sessionStart && now.getTime() <= sessionEnd) {
      targetCountdown = session.time.toISOString(); 
      targetSessionName = session.name;
      isSessionLive = true;
      break;
    }
  }

  // If no sessions caught it, the race has finished but it's still before the Monday expiration.
  if (!targetCountdown && !isSessionLive) {
    isWeekendFinished = true;
  }
}

// --- 5. FETCH LIVE WEATHER FOR NEXT RACE ---
if (nextRace) {
  nextRace.weather = { temp: 21, condition: "Partly Cloudy", icon: "⛅" };

  try {
    const apiKey = import.meta.env.OPENWEATHER_API_KEY;
    const lat = nextRace.Circuit.Location.coordinates.lat;
    const lon = nextRace.Circuit.Location.coordinates.lon;

    if (apiKey) {
      const weatherRes = await fetch(
        `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`
      );
      
      if (weatherRes.ok) {
        const weatherData = await weatherRes.json();
        if (weatherData && weatherData.main && weatherData.weather?.length > 0) {
          const temp = Math.round(weatherData.main.temp);
          const condition = weatherData.weather[0].main; 
          const iconCode = weatherData.weather[0].icon;

          const getWeatherEmoji = (icon: string) => {
            const map: Record<string, string> = {
              '01d': '☀️', '01n': '🌙', '02d': '⛅', '02n': '☁️',
              '03d': '☁️', '03n': '☁️', '04d': '☁️', '04n': '☁️',
              '09d': '🌧️', '09n': '🌧️', '10d': '🌦️', '10n': '🌧️',
              '11d': '⛈️', '11n': '⛈️', '13d': '⚡', '13n': '⚡',
              '50d': '🌫️', '50n': '🌫️'
            };
            return map[icon] || '🌡️';
          };

          nextRace.weather = { temp: temp, condition: condition, icon: getWeatherEmoji(iconCode) };
        }
      }
    }
  } catch (error) {
    console.error("Failed to fetch OpenWeather data for calendar:", error);
  }
}

// Helpers
function formatMonth(dateStr: string) { return new Date(dateStr).toLocaleString('en-US', { month: 'short' }).toUpperCase(); }
function formatDay(dateStr: string) { return new Date(dateStr).toLocaleString('en-US', { day: '2-digit' }); }
function getFlagCode(country: string) {
  const map: Record<string, string> = {
    'Bahrain': 'bh', 'Saudi Arabia': 'sa', 'Australia': 'au', 'Japan': 'jp', 'China': 'cn',
    'USA': 'us', 'United States': 'us', 'Italy': 'it', 'Monaco': 'mc', 'Canada': 'ca', 'Spain': 'es',
    'UK': 'gb', 'Austria': 'at', 'Hungary': 'hu', 'Belgium': 'be', 'Netherlands': 'nl',
    'Azerbaijan': 'az', 'Singapore': 'sg', 'Mexico': 'mx', 'Brazil': 'br', 'Qatar': 'qa', 'UAE': 'ae'
  };
  return map[country] || 'un';
}
function getGuideSlug(raceName: string) { return `/circuits-live/circuit-guides/${raceName.toLowerCase().replace(/\s+/g, '-')}`; }
function getSlug(raceName: string) { return raceName.toLowerCase().replace(/\s+/g, '-'); }

const getSessionArray = (race: Race) => [
  { id: 'fp1', name: 'Practice 1', utc: race.sessions.fp1, results: race.sessionResults?.fp1 },
  { id: 'fp2', name: race.isSprint ? 'Sprint Quali' : 'Practice 2', utc: race.sessions.fp2, results: race.sessionResults?.fp2 },
  { id: 'fp3', name: race.isSprint ? 'Sprint Race' : 'Practice 3', utc: race.sessions.fp3, results: race.sessionResults?.fp3 },
  { id: 'quali', name: 'Qualifying', utc: race.sessions.quali, results: race.sessionResults?.quali },
  { id: 'race', name: 'Race', utc: race.sessions.race, results: race.sessionResults?.race }
];
---

<Layout 
  title="F1 Race Calendar | Schedule & Countdown | My Grand Prix Hub"
  description="Live Formula 1 World Championship race calendar, schedule, and live countdown to the next Grand Prix session."
>
  <main class="page-container">
    <header class="section-header">
      <span class="badge">Race Calendar</span>
      <h1>World Championship Schedule</h1>
      <p>The complete 2026 calendar. Track dates, locations, and watch the live countdown to the next session.</p>
    </header>

    {nextRace && (
      <section class="next-race-hero">
        <div class="hero-bg-accent"></div>
        
        <!-- Hero Top: Info & Countdown -->
        <div class="next-race-content">
          <div class="next-race-meta">
            <div class="badge-row">
              <span class="round-pill">Round {nextRace.round} &bull; Up Next</span>
              {nextRace.isSprint && (
                <span class="sprint-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  Sprint Weekend
                </span>
              )}
            </div>
            
            <div class="title-row">
              <img 
                src={`https://flagcdn.com/w40/${getFlagCode(nextRace.Circuit.Location.country)}.png`}
                width="32" height="24" alt={nextRace.Circuit.Location.country} class="hero-flag" 
              />
