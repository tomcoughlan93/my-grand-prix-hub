</Layout>

<script is:inline>
  function formatSessionTimes() {
    const rows = document.querySelectorAll('.js-schedule-row');
    rows.forEach(row => {
      const utcStr = row.getAttribute('data-utc');
      const trackTz = row.getAttribute('data-tz');
      if (!utcStr || !trackTz) return;

      const dateObj = new Date(utcStr);
      
      const trackFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: trackTz, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false
      });
      const localFormatter = new Intl.DateTimeFormat('en-US', {
        weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false
      });

      const tdTrack = row.querySelector('.js-track-td');
      const tdLocal = row.querySelector('.js-local-td');
      
      if(tdTrack) tdTrack.textContent = trackFormatter.format(dateObj);
      if(tdLocal) tdLocal.textContent = localFormatter.format(dateObj);
    });
  }

  function formatHeroSchedule() {
    const cards = document.querySelectorAll('.js-session-card');

    cards.forEach(card => {
      const utcStr = card.getAttribute('data-utc');
      const trackTz = card.getAttribute('data-tz');
      if (!utcStr || !trackTz) return;

      const dateObj = new Date(utcStr);

      const trackFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: trackTz, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false
      });
      const localFormatter = new Intl.DateTimeFormat('en-US', {
        weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false
      });

      const trackSpan = card.querySelector('.js-track-time');
      const localSpan = card.querySelector('.js-local-time');
      
      if(trackSpan) trackSpan.textContent = trackFormatter.format(dateObj);
      if(localSpan) localSpan.textContent = localFormatter.format(dateObj);
    });
  }

  function setupAccordions() {
    const btns = document.querySelectorAll('.expand-btn');
    btns.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        const targetId = newBtn.getAttribute('data-target');
        const targetDiv = document.getElementById(targetId);
        if (!targetDiv) return;

        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        newBtn.setAttribute('aria-expanded', !isExpanded);
        
        if (isExpanded) {
          targetDiv.style.maxHeight = null;
          targetDiv.classList.remove('open');
        } else {
          targetDiv.classList.add('open');
          targetDiv.style.maxHeight = targetDiv.scrollHeight + 100 + "px";
        }
      });
    });
  }

  // --- NEW SCRIPT: ANTI-SPOILER LOGIC ---
  function setupSpoilers() {
    const revealButtons = document.querySelectorAll('.js-reveal-btn');
    
    revealButtons.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', (e) => {
        const container = e.target.closest('.js-spoiler-container');
        const podium = container.querySelector('.js-race-podium');
        
        newBtn.classList.add('is-hidden');
        podium.classList.remove('is-hidden');
      });
    });
  }
  // --------------------------------------

  function initCountdown() {
    const timerElement = document.getElementById('f1-countdown');
    if (!timerElement) return;

    const targetDateStr = timerElement.getAttribute('data-target');
    if (!targetDateStr) return;

    const targetDate = new Date(targetDateStr).getTime();
    
    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minsEl = document.getElementById('cd-mins');
    const secsEl = document.getElementById('cd-secs');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        if(daysEl) daysEl.innerText = "00";
        if(hoursEl) hoursEl.innerText = "00";
        if(minsEl) minsEl.innerText = "00";
        if(secsEl) secsEl.innerText = "00";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if(daysEl) daysEl.innerText = days.toString().padStart(2, '0');
      if(hoursEl) hoursEl.innerText = hours.toString().padStart(2, '0');
      if(minsEl) minsEl.innerText = minutes.toString().padStart(2, '0');
      if(secsEl) secsEl.innerText = seconds.toString().padStart(2, '0');
    };

    updateTimer(); 
    setInterval(updateTimer, 1000); 
  }

  function runAllScripts() {
    formatSessionTimes();
    formatHeroSchedule();
    setupAccordions();
    setupSpoilers(); // <-- Added to our main runner
    initCountdown();
  }

  document.addEventListener('DOMContentLoaded', runAllScripts);
  document.addEventListener('astro:page-load', runAllScripts);
</script>

