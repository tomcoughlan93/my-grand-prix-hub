  { pos: 5, driverNumber: "44", driverName: "Lewis Hamilton", driverCode: "HAM", team: "Ferrari", teamKey: "ferrari", countryCode: "gb", nationality: "GBR", points: 190, wins: 1, behindLeader: 95, form: formMap["HAM"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["HAM"] || defaultFullSeason },
  { pos: 6, driverNumber: "63", driverName: "George Russell", driverCode: "RUS", team: "Mercedes", teamKey: "mercedes", countryCode: "gb", nationality: "GBR", points: 165, wins: 1, behindLeader: 120, form: formMap["RUS"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["RUS"] || defaultFullSeason },
  { pos: 7, driverNumber: "12", driverName: "Kimi Antonelli", driverCode: "ANT", team: "Mercedes", teamKey: "mercedes", countryCode: "it", nationality: "ITA", points: 98, wins: 0, behindLeader: 187, form: formMap["ANT"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["ANT"] || defaultFullSeason },
  { pos: 8, driverNumber: "14", driverName: "Fernando Alonso", driverCode: "ALO", team: "Aston Martin", teamKey: "astonmartin", countryCode: "es", nationality: "ESP", points: 64, wins: 0, behindLeader: 221, form: formMap["ALO"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["ALO"] || defaultFullSeason },
  { pos: 9, driverNumber: "18", driverName: "Lance Stroll", driverCode: "STR", team: "Aston Martin", teamKey: "astonmartin", countryCode: "ca", nationality: "CAN", points: 36, wins: 0, behindLeader: 249, form: formMap["STR"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["STR"] || defaultFullSeason },
  { pos: 10, driverNumber: "37", driverName: "Isack Hadjar", driverCode: "HAD", team: "Red Bull Racing", teamKey: "redbull", countryCode: "fr", nationality: "FRA", points: 30, wins: 0, behindLeader: 255, form: formMap["HAD"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["HAD"] || defaultFullSeason },
  { pos: 11, driverNumber: "22", driverName: "Yuki Tsunoda", driverCode: "TSU", team: "Racing Bulls", teamKey: "rb", countryCode: "jp", nationality: "JPN", points: 28, wins: 0, behindLeader: 257, form: formMap["TSU"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["TSU"] || defaultFullSeason },
  { pos: 12, driverNumber: "30", driverName: "Liam Lawson", driverCode: "LAW", team: "Racing Bulls", teamKey: "rb", countryCode: "nz", nationality: "NZL", points: 20, wins: 0, behindLeader: 265, form: formMap["LAW"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["LAW"] || defaultFullSeason },
  { pos: 13, driverNumber: "23", driverName: "Alexander Albon", driverCode: "ALB", team: "Williams", teamKey: "williams", countryCode: "th", nationality: "THA", points: 18, wins: 0, behindLeader: 267, form: formMap["ALB"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["ALB"] || defaultFullSeason },
  { pos: 14, driverNumber: "55", driverName: "Carlos Sainz", driverCode: "SAI", team: "Williams", teamKey: "williams", countryCode: "es", nationality: "ESP", points: 16, wins: 0, behindLeader: 269, form: formMap["SAI"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["SAI"] || defaultFullSeason },
  { pos: 15, driverNumber: "27", driverName: "Nico Hülkenberg", driverCode: "HUL", team: "Audi F1 Team", teamKey: "audi", countryCode: "de", nationality: "GER", points: 14, wins: 0, behindLeader: 271, form: formMap["HUL"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["HUL"] || defaultFullSeason },
  { pos: 16, driverNumber: "5", driverName: "Gabriel Bortoleto", driverCode: "BOR", team: "Audi F1 Team", teamKey: "audi", countryCode: "br", nationality: "BRA", points: 8, wins: 0, behindLeader: 277, form: formMap["BOR"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["BOR"] || defaultFullSeason },
  { pos: 17, driverNumber: "10", driverName: "Pierre Gasly", driverCode: "GAS", team: "Alpine", teamKey: "alpine", countryCode: "fr", nationality: "FRA", points: 10, wins: 0, behindLeader: 275, form: formMap["GAS"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["GAS"] || defaultFullSeason },
  { pos: 18, driverNumber: "7", driverName: "Jack Doohan", driverCode: "DOO", team: "Alpine", teamKey: "alpine", countryCode: "au", nationality: "AUS", points: 2, wins: 0, behindLeader: 283, form: formMap["DOO"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["DOO"] || defaultFullSeason },
  { pos: 19, driverNumber: "31", driverName: "Esteban Ocon", driverCode: "OCO", team: "Haas F1 Team", teamKey: "haas", countryCode: "fr", nationality: "FRA", points: 8, wins: 0, behindLeader: 277, form: formMap["OCO"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["OCO"] || defaultFullSeason },
  { pos: 20, driverNumber: "87", driverName: "Oliver Bearman", driverCode: "BEA", team: "Haas F1 Team", teamKey: "haas", countryCode: "gb", nationality: "GBR", points: 6, wins: 0, behindLeader: 279, form: formMap["BEA"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["BEA"] || defaultFullSeason },
  { pos: 21, driverNumber: "43", driverName: "Franco Colapinto", driverCode: "COL", team: "Alpine", teamKey: "alpine", countryCode: "ar", nationality: "ARG", points: 4, wins: 0, behindLeader: 281, form: formMap["COL"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["COL"] || defaultFullSeason },
  { pos: 22, driverNumber: "11", driverName: "Sergio Perez", driverCode: "PER", team: "Cadillac F1 Team", teamKey: "cadillac", countryCode: "mx", nationality: "MEX", points: 2, wins: 0, behindLeader: 283, form: formMap["PER"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["PER"] || defaultFullSeason },
  { pos: 23, driverNumber: "77", driverName: "Valtteri Bottas", driverCode: "BOT", team: "Cadillac F1 Team", teamKey: "cadillac", countryCode: "fi", nationality: "FIN", points: 1, wins: 0, behindLeader: 284, form: formMap["BOT"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["BOT"] || defaultFullSeason },
  { pos: 24, driverNumber: "3", driverName: "Arvid Lindblad", driverCode: "LIN", team: "Racing Bulls", teamKey: "rb", countryCode: "gb", nationality: "GBR", points: 0, wins: 0, behindLeader: 285, form: formMap["LIN"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["LIN"] || defaultFullSeason },
];

let constructors: ConstructorStanding[] = [
  { pos: 1, team: "McLaren", teamKey: "mclaren", points: 475, wins: 6, behindLeader: 0 },
  { pos: 2, team: "Ferrari", teamKey: "ferrari", points: 425, wins: 4, behindLeader: 50 },
  { pos: 3, team: "Red Bull Racing", teamKey: "redbull", points: 285, wins: 7, behindLeader: 190 },
  { pos: 4, team: "Mercedes", teamKey: "mercedes", points: 263, wins: 1, behindLeader: 212 },
  { pos: 5, team: "Aston Martin", teamKey: "astonmartin", points: 100, wins: 0, behindLeader: 375 },
  { pos: 6, team: "Racing Bulls", teamKey: "rb", points: 48, wins: 0, behindLeader: 427 },
  { pos: 7, team: "Williams", teamKey: "williams", points: 34, wins: 0, behindLeader: 441 },
  { pos: 8, team: "Audi F1 Team", teamKey: "audi", points: 22, wins: 0, behindLeader: 453 },
  { pos: 9, team: "Alpine", teamKey: "alpine", points: 16, wins: 0, behindLeader: 459 },
  { pos: 10, team: "Haas F1 Team", teamKey: "haas", points: 14, wins: 0, behindLeader: 461 },
  { pos: 11, team: "Cadillac F1 Team", teamKey: "cadillac", points: 3, wins: 0, behindLeader: 472 },
];

// Server-side API sync
try {
  const [driverRes, constrRes] = await Promise.all([
    fetch('https://api.jolpi.ca/ergast/f1/current/driverStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
    fetch('https://api.jolpi.ca/ergast/f1/current/constructorStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
  ]);

  if (driverRes.ok && constrRes.ok) {
    const dData = await driverRes.json();
    const cData = await constrRes.json();

    const dList = dData?.MRData?.StandingsTable?.StandingsLists?.[0]?.DriverStandings;
    const cList = cData?.MRData?.StandingsTable?.StandingsLists?.[0]?.ConstructorStandings;

    if (dList && dList.length > 0) {
      const topPoints = parseFloat(dList[0].points) || 0;
      drivers = dList.map((item: any) => {
        const pts = parseFloat(item.points) || 0;
        const driverId = item.Driver.driverId || '';
        const driverCode = item.Driver.code || item.Driver.familyName.substring(0, 3).toUpperCase();
        const constructorId = (item.Constructors?.[0]?.constructorId || '').toLowerCase().replace(/[^a-z]/g, '');
        const countryInfo = DRIVER_COUNTRIES[driverId] || { 
          code: item.Driver.nationality?.substring(0, 2).toLowerCase() || 'un', 
          nat: item.Driver.nationality?.substring(0, 3).toUpperCase() || 'FIA' 
        };

        const form = formMap[driverCode] || ['-', '-', '-', '-', '-'];
        const fullResults = fullResultsMap[driverCode] || defaultFullSeason;

        return {
          pos: parseInt(item.position),
          driverNumber: item.Driver.permanentNumber || String(item.position),
          driverName: `${item.Driver.givenName} ${item.Driver.familyName}`,
          driverCode: driverCode,
          team: item.Constructors?.[0]?.name || 'Independent',
          teamKey: constructorId,
          countryCode: countryInfo.code,
          nationality: countryInfo.nat,
          points: pts,
          wins: parseInt(item.wins) || 0,
          behindLeader: topPoints - pts,
          form,
          fullResults
        };
      });
    }

    if (cList && cList.length > 0) {
      const topPoints = parseFloat(cList[0].points) || 0;
      constructors = cList.map((item: any) => {
        const pts = parseFloat(item.points) || 0;
        const constructorId = (item.Constructor.constructorId || '').toLowerCase().replace(/[^a-z]/g, '');
        return {
          pos: parseInt(item.position),
          team: item.Constructor.name,
          teamKey: constructorId,
          points: pts,
          wins: parseInt(item.wins) || 0,
          behindLeader: topPoints - pts,
        };
      });
    }
  }
} catch {
  // Graceful fallback to static dataset
}

function getFormBadgeClass(result: number | string): string {
  const resStr = String(result).toUpperCase().trim();
  if (resStr === 'RET') return 'badge-ret';
  if (resStr === 'DNS' || resStr === 'DSQ') return 'badge-dns'; // <-- Add this line!
  if (resStr === '-' || resStr === '') return 'badge-dnp';
  
  const num = parseInt(resStr, 10);
  if (!isNaN(num)) {
    if (num === 1) return 'badge-p1';
    if (num === 2) return 'badge-p2';
    if (num === 3) return 'badge-p3';
    if (num <= 10) return 'badge-points';
  }
  return 'badge-out';
}
---

<Layout 
  title="F1 Championship Standings | Drivers & Constructors | My Grand Prix Hub"
  description="Live Formula 1 World Championship points standings, circular form guides, and constructor leaderboards."
>
  <main class="standings-wrapper">
    <!-- Header Section -->
    <header class="standings-header">
      <div class="header-badge">
        <span class="pulse-dot"></span>
        <span>FIA Formula One World Championship</span>
      </div>
      <h1>World Championship Standings</h1>
      <p class="subtitle">Official standings, recent race form guide, and points classification.</p>
    </header>

    <!-- SECTION 1: DRIVERS CHAMPIONSHIP -->
    <section class="section-container">
      <div class="section-header-row">
        <div>
          <h2>Drivers' Championship</h2>
          <span class="section-desc">Click any driver to view their complete 2026 season results</span>
        </div>
        <span class="count-badge">{drivers.length} Drivers Classified</span>
      </div>

      <div class="standings-card">
        <div class="table-container">
          <table class="f1-table">
            <thead>
              <tr>
                <th class="col-pos">Pos</th>
                <th class="col-driver">Driver</th>
                <th class="col-nat">Nat</th>
                <th class="col-form">Last 5 Races</th>
                <th class="col-wins">Wins</th>
                <th class="col-gap">Gap</th>
                <th class="col-pts">Points</th>
              </tr>
            </thead>
            <tbody>
              {drivers.map((d) => (
                <>
                  <tr class={`row-item team-border-${d.teamKey} ${d.pos <= 3 ? 'podium-row' : ''} js-driver-row`} data-target={`expanded-${d.driverCode}`}>
                    <td class="col-pos">
                      <span class={`pos-badge pos-${d.pos}`}>{d.pos}</span>
                    </td>
                    <td class="col-driver">
                      <div class="driver-cell">
                        <span class="driver-number">{d.driverNumber}</span>
                        <div class="driver-info-block">
                          <div class="driver-name-row">
                            <!-- NEW DYNAMIC LINK HERE -->
                            <a href={`/drivers/${getDriverSlug(d.driverCode, d.driverName)}`} class="driver-profile-link">
                              <span class="driver-fullname">{d.driverName}</span>
                              <span class="driver-code-tag">{d.driverCode}</span>
                            </a>
                          </div>
                          <span class="driver-sub-team">{d.team}</span>
                        </div>
                      </div>
                    </td>
                    <td class="col-nat">
                      <div class="nat-stack">
                        <img 
                          src={`https://flagcdn.com/w40/${d.countryCode}.png`}
                          width="20"
                          height="15"
                          alt={d.nationality}
                          class="flag-img"
                          loading="lazy"
                          onerror="this.style.display='none';"
                        />
                        <span class="nat-text">{d.nationality}</span>
                      </div>
                    </td>
                    <td class="col-form">
                      <div class="form-grid-wrapper">
                        <div class="form-grid">
                          {d.form.map((res) => (
                            <span class={`form-circle ${getFormBadgeClass(res)}`}>
                              {res}
                            </span>
                          ))}
                        </div>
                      </div>
                    </td>
                    <td class="col-wins">
                      <span class="stat-num">{d.wins}</span>
                    </td>
                    <td class="col-gap">
                      {d.behindLeader === 0 ? (
                        <span class="leader-badge">LEADER</span>
                      ) : (
                        <span class="gap-text">-{d.behindLeader}</span>
                      )}
                    </td>
                    <td class="col-pts">
                      <div class="pts-accordion-wrapper">
                        <div>
                          <span class="pts-value">{d.points}</span>
                          <span class="pts-label">PTS</span>
                        </div>
                        <svg class="row-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                      </div>
                    </td>
                  </tr>
                  
                  {/* EXPANDED FULL SEASON ROW */}
                  <tr class="expanded-row" id={`expanded-${d.driverCode}`}>
                    <td colspan="7">
                      <div class="expanded-content">
                        <span class="expanded-title">2026 Full Season Classification &bull; {d.driverName}</span>
                        <div class="full-season-grid">
                          {d.fullResults.map((res, index) => {
                            const raceInfo = ROUND_DATA[index];
                            return (
                              <div class="season-race-box">
                                <img 
                                  src={`https://flagcdn.com/w20/${raceInfo.flag}.png`} 
                                  alt={raceInfo.name} 
                                  class="race-card-flag" 
                                  loading="lazy"
                                />
                                <span class="race-round">{raceInfo.name}</span>
                                <span class={`form-circle ${getFormBadgeClass(res)}`}>{res}</span>
                              </div>
                            )
                          })}
                        </div>
                      </div>
                    </td>
                  </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- SECTION 2: CONSTRUCTORS CHAMPIONSHIP -->
    <section class="section-container constructors-section">
      <div class="section-header-row">
        <div>
          <h2>Constructors' Championship</h2>
          <span class="section-desc">Team points classification and race win records</span>
        </div>
        <span class="count-badge">{constructors.length} Teams</span>
      </div>

      <div class="standings-card">
        <div class="table-container">
          <table class="f1-table">
            <thead>
              <tr>
                <th class="col-pos">Pos</th>
                <th class="col-team-title">Constructor</th>
                <th class="col-wins">Wins</th>
                <th class="col-gap">Gap</th>
                <th class="col-pts">Points</th>
              </tr>
            </thead>
            <tbody>
              {constructors.map((c) => (
                <tr class={`row-item team-border-${c.teamKey} ${c.pos <= 3 ? 'podium-row' : ''}`}>
                  <td class="col-pos">
                    <span class={`pos-badge pos-${c.pos}`}>{c.pos}</span>
                  </td>
                  <!-- Replace this cell in the Constructors table -->
<td class="col-team-title">
  <a href={`/teams/${getTeamSlug(c.teamKey)}`} class="team-profile-link">
    <div class="team-cell">
      <div class={`team-color-indicator team-bg-${c.teamKey}`}></div>
      <span class="team-name-text">{c.team}</span>
    </div>
  </a>
</td>
                  <td class="col-wins">
                    <span class="stat-num">{c.wins}</span>
                  </td>
                  <td class="col-gap">
                    {c.behindLeader === 0 ? (
                      <span class="leader-badge">LEADER</span>
                    ) : (
                      <span class="gap-text">-{c.behindLeader}</span>
                    )}
                  </td>
                  <td class="col-pts">
                    <span class="pts-value">{c.points}</span>
                    <span class="pts-label">PTS</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  function setupAccordions() {
    const rows = document.querySelectorAll('.js-driver-row');
    
    // Remove old listeners to prevent stacking
    rows.forEach(row => {
      const newRow = row.cloneNode(true);
      row.parentNode.replaceChild(newRow, row);
      
      newRow.addEventListener('click', (e) => {
        // Prevent accordion toggle if the user clicks the profile link!
        if (e.target.closest('.driver-profile-link')) return;

        const targetId = newRow.getAttribute('data-target');
        const targetRow = document.getElementById(targetId);
        if (!targetRow) return;

        const isExpanded = newRow.classList.contains('is-expanded');

        if (isExpanded) {
          newRow.classList.remove('is-expanded');
          targetRow.classList.remove('open');
        } else {
          newRow.classList.add('is-expanded');
          targetRow.classList.add('open');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupAccordions);
  document.addEventListener('astro:page-load', setupAccordions);
</script>

