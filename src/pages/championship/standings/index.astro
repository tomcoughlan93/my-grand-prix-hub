---
// src/pages/championship/standings.astro
import Layout from '@/layouts/Layout.astro';
// 1. Import our new Master Results Grid!
import seasonData from '@/content/results/season-2026.json';

// --- NEW: DRIVER SLUG MAPPING HELPER ---
const DRIVER_SLUGS: Record<string, string> = {
  VER: 'max-verstappen',
  NOR: 'lando-norris',
  LEC: 'charles-leclerc',
  PIA: 'oscar-piastri',
  HAM: 'lewis-hamilton',
  RUS: 'george-russell',
  ANT: 'kimi-antonelli',
  ALO: 'fernando-alonso',
  STR: 'lance-stroll',
  HAD: 'isack-hadjar',
  TSU: 'yuki-tsunoda',
  LAW: 'liam-lawson',
  ALB: 'alexander-albon',
  SAI: 'carlos-sainz',
  HUL: 'nico-hulkenberg',
  BOR: 'gabriel-bortoleto',
  GAS: 'pierre-gasly',
  DOO: 'jack-doohan',
  OCO: 'esteban-ocon',
  BEA: 'oliver-bearman',
  COL: 'franco-colapinto',
  PER: 'sergio-perez',
  BOT: 'valtteri-bottas',
  LIN: 'arvid-lindblad',
};

function getDriverSlug(code?: string, name?: string): string {
  if (code && DRIVER_SLUGS[code.toUpperCase()]) {
    return DRIVER_SLUGS[code.toUpperCase()];
  }
  if (name) {
    return name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }
  return '#';
}
// ---------------------------------------

// --- NEW: TEAM SLUG MAPPING HELPER ---
const TEAM_SLUGS: Record<string, string> = {
  mclaren: 'mclaren',
  ferrari: 'ferrari',
  redbull: 'red-bull-racing',
  mercedes: 'mercedes',
  astonmartin: 'aston-martin',
  rb: 'rb',
  williams: 'williams',
  audi: 'audi',
  alpine: 'alpine',
  haas: 'haas',
  cadillac: 'cadillac'
};

function getTeamSlug(teamKey: string): string {
  return TEAM_SLUGS[teamKey.toLowerCase()] || teamKey.toLowerCase();
}
// -------------------------------------

interface DriverStanding {
  pos: number;
  driverNumber: string;
  driverName: string;
  driverCode: string;
  team: string;
  teamKey: string;
  countryCode: string;
  nationality: string;
  points: number;
  wins: number;
  behindLeader: number;
  form: (number | string)[];
  fullResults: (number | string)[]; 
}

interface ConstructorStanding {
  pos: number;
  team: string;
  teamKey: string;
  points: number;
  wins: number;
  behindLeader: number;
}

const DRIVER_COUNTRIES: Record<string, { code: string; nat: string }> = {
  max_verstappen: { code: 'nl', nat: 'NED' },
  norris: { code: 'gb', nat: 'GBR' },
  leclerc: { code: 'mc', nat: 'MON' },
  piastri: { code: 'au', nat: 'AUS' },
  hamilton: { code: 'gb', nat: 'GBR' },
  russell: { code: 'gb', nat: 'GBR' },
  antonelli: { code: 'it', nat: 'ITA' },
  alonso: { code: 'es', nat: 'ESP' },
  stroll: { code: 'ca', nat: 'CAN' },
  tsunoda: { code: 'jp', nat: 'JPN' },
  lawson: { code: 'nz', nat: 'NZL' },
  albon: { code: 'th', nat: 'THA' },
  sainz: { code: 'es', nat: 'ESP' },
  hulkenberg: { code: 'de', nat: 'GER' },
  bortoleto: { code: 'br', nat: 'BRA' },
  gasly: { code: 'fr', nat: 'FRA' },
  doohan: { code: 'au', nat: 'AUS' },
  ocon: { code: 'fr', nat: 'FRA' },
  bearman: { code: 'gb', nat: 'GBR' },
  lindblad: { code: 'gb', nat: 'GBR' },
  colapinto: { code: 'ar', nat: 'ARG' },
  bottas: { code: 'fi', nat: 'FIN' },
  perez: { code: 'mx', nat: 'MEX' },
  hadjar: { code: 'fr', nat: 'FRA' },
  herta: { code: 'us', nat: 'USA' },
};

// 2026 Calendar Map for the Expanded Accordion
const ROUND_DATA = [
  { round: 1, name: 'AUS', flag: 'au' },
  { round: 2, name: 'CHN', flag: 'cn' },
  { round: 3, name: 'JPN', flag: 'jp' },
  { round: 4, name: 'MIA', flag: 'us' },
  { round: 5, name: 'CAN', flag: 'ca' },
  { round: 6, name: 'MON', flag: 'mc' },
  { round: 7, name: 'ESP', flag: 'es' },
  { round: 8, name: 'AUT', flag: 'at' },
  { round: 9, name: 'GBR', flag: 'gb' },
  { round: 10, name: 'BEL', flag: 'be' },
  { round: 11, name: 'HUN', flag: 'hu' },
  { round: 12, name: 'NED', flag: 'nl' },
  { round: 13, name: 'ITA', flag: 'it' },
  { round: 14, name: 'MAD', flag: 'es' },
  { round: 15, name: 'AZE', flag: 'az' },
  { round: 16, name: 'SIN', flag: 'sg' },
  { round: 17, name: 'USA', flag: 'us' },
  { round: 18, name: 'MEX', flag: 'mx' },
  { round: 19, name: 'BRA', flag: 'br' },
  { round: 20, name: 'LVG', flag: 'us' },
  { round: 21, name: 'QAT', flag: 'qa' },
  { round: 22, name: 'ABU', flag: 'ae' },
];

// 1. DYNAMIC FORM GUIDE & FULL SEASON FROM MASTER GRID
const formMap: Record<string, (string | number)[]> = {};
const fullResultsMap: Record<string, (string | number)[]> = {};

if (seasonData && seasonData.drivers) {
  const activeRounds: string[] = [];
  
  // Find which rounds have actually happened
  for (let i = 1; i <= 22; i++) {
    const roundKey = `r${i}`;
    const hasResult = seasonData.drivers.some((d: any) => d[roundKey] && String(d[roundKey]).trim() !== "");
    if (hasResult) {
      activeRounds.push(roundKey);
    }
  }

  const last5Rounds = activeRounds.slice(-5);

  seasonData.drivers.forEach((d: any) => {
    if (d && d.code) {
      const code = String(d.code).toUpperCase().trim();
      
      // Build the last 5 form guide
      const recentList = last5Rounds.map(roundKey => {
        const val = d[roundKey] ? String(d[roundKey]).trim().toUpperCase() : '-';
        if (val === 'RET' || val === 'DNF' || val === 'DSQ') return 'RET';
        if (val === '-' || val === '') return '-';
        const num = parseInt(val, 10);
        return isNaN(num) ? val : num;
      });

      while (recentList.length < 5) {
        recentList.unshift('-'); 
      }
      formMap[code] = recentList;

      // Build the FULL season array (R1 to R22) for the new accordion
      const fullList = [];
      for(let i = 1; i <= 22; i++) {
        const val = d[`r${i}`] ? String(d[`r${i}`]).trim().toUpperCase() : '-';
        if (val === 'RET' || val === 'DNF' || val === 'DSQ') fullList.push('RET');
        else if (val === '-' || val === '') fullList.push('-');
        else {
          const num = parseInt(val, 10);
          fullList.push(isNaN(num) ? val : num);
        }
      }
      fullResultsMap[code] = fullList;
    }
  });
}

const defaultFullSeason = Array(22).fill('-');

// Fallback baseline data 
