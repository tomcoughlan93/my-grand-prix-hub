  { pos: 2, driverNumber: "4", driverName: "Lando Norris", driverCode: "NOR", team: "McLaren", teamKey: "mclaren", countryCode: "gb", nationality: "GBR", points: 260, wins: 4, behindLeader: 25, form: formMap["NOR"] || ['-', '-', '-', '-', '-'], fullResults: fullResultsMap["NOR"] || defaultFullSeason },
