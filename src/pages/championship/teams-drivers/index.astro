// --- NEW: DRIVER SLUG MAPPING HELPER ---
const DRIVER_SLUGS: Record<string, string> = {
  VER: 'max-verstappen',
  NOR: 'lando-norris',
  LEC: 'charles-leclerc',
  PIA: 'oscar-piastri',
  HAM: 'lewis-hamilton',
  RUS: 'george-russell',
  ANT: 'kimi-antonelli',
  ALO: 'fernando-alonso',
  STR: 'lance-stroll',
  HAD: 'isack-hadjar',
  TSU: 'yuki-tsunoda',
  LAW: 'liam-lawson',
  ALB: 'alexander-albon',
  SAI: 'carlos-sainz',
  HUL: 'nico-hulkenberg',
  BOR: 'gabriel-bortoleto',
  GAS: 'pierre-gasly',
  DOO: 'jack-doohan',
  OCO: 'esteban-ocon',
  BEA: 'oliver-bearman',
  COL: 'franco-colapinto',
  PER: 'sergio-perez',
  BOT: 'valtteri-bottas',
  LIN: 'arvid-lindblad',
};

function getDriverSlug(code?: string, name?: string): string {
  if (code && DRIVER_SLUGS[code.toUpperCase()]) {
    return DRIVER_SLUGS[code.toUpperCase()];
  }
  if (name) {
    return name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }
  return '#';
}
// ---------------------------------------

// --- NEW: TEAM SLUG MAPPING HELPER ---
const TEAM_SLUGS: Record<string, string> = {
  mclaren: 'mclaren',
  ferrari: 'ferrari',
  redbull: 'red-bull-racing',
  mercedes: 'mercedes',
  astonmartin: 'aston-martin',
  rb: 'rb',
  williams: 'williams',
  audi: 'audi',
  alpine: 'alpine',
  haas: 'haas',
  cadillac: 'cadillac'
};

function getTeamSlug(teamKey: string): string {
  return TEAM_SLUGS[teamKey.toLowerCase()] || teamKey.toLowerCase();
}
