---

<Layout 
  title="F1 Teams & Drivers | FIA Formula One World Championship | My Grand Prix Hub"
  description="Explore the complete Formula 1 grid: team profiles, bases, power units, driver pairings, and official social media channels."
>
  <main class="page-container directory-page">
    <!-- Header Section -->
    <header class="section-header">
      <span class="badge">Championship Directory</span>
      <h1>Teams & Drivers</h1>
      <p>Technical profiles, team headquarters, engine suppliers, driver pairings, and official links for the 2026 Formula 1 grid.</p>
    </header>

    <!-- Teams List -->
    <div class="teams-stack">
      {TEAMS_DATA.map((team) => (
        <article class={`team-card team-border-${team.teamKey}`}>
          
          <!-- Team Header -->
          <div class="team-header">
            <!-- NEW LINK WRAPPER -->
            <a href={`/teams/${getTeamSlug(team.teamKey)}`} class="team-profile-link">
              <div class="team-identity">
                <div class={`team-color-indicator team-bg-${team.teamKey}`}></div>
                <h2>{team.name}</h2>
                {team.isChampion ? (
                  <div class="champion-icon" title="Defending Constructors' Champion">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M4.222 19.778c.026.173.082.342.164.502.19.373.498.665.875.83A2.08 2.08 0 0 0 6.222 21h11.556a2.08 2.08 0 0 0 .961-.102c.377-.165.685-.457.875-.83.082-.16.138-.329.164-.502L22 6.556a1 1 0 0 0-1.572-.818l-4.606 3.29-2.934-5.867a1 1 0 0 0-1.776 0l-2.934 5.867-4.606-3.29A1 1 0 0 0 2 6.556l2.222 13.222zM6 19l-1.63-9.778 3.52 2.514a1 1 0 0 0 1.258-.176L12 6.16l2.852 5.4a1 1 0 0 0 1.258.176l3.52-2.514L18 19H6z"/>
                      <path d="M12 21v-2H6v2h12v-2h-6z"/>
                    </svg>
                  </div>
                ) : null}
              </div>
            </a>
            
            <div class="social-links-group">
              <a href={team.website} target="_blank" rel="noopener noreferrer" class="social-btn website-btn" title={`${team.name} Official Website`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span>Website ↗</span>
              </a>
              <a href={team.x} target="_blank" rel="noopener noreferrer" class="social-btn icon-btn" title="X / Twitter">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href={team.instagram} target="_blank" rel="noopener noreferrer" class="social-btn icon-btn" title="Instagram">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            </div>
          </div>

          <!-- Team Specs -->
          <div class="specs-grid">
            <div class="spec-item">
              <span class="spec-label">Headquarters</span>
              <span class="spec-value">{team.base}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Team Principal</span>
              <span class="spec-value">{team.principal}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Power Unit</span>
              <span class="spec-value">{team.powerUnit}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">World Titles</span>
              <span class="spec-value">{team.championships > 0 ? `${team.championships} Constructors` : 'None'}</span>
            </div>
          </div>

          <!-- Drivers Container -->
          <div class="drivers-section">
            <span class="section-tag">Race Drivers</span>
            <div class="drivers-grid">
              {team.drivers.map((driver) => (
                <div class="driver-card">
                  <div class="driver-left">
                    <span class="driver-number">{driver.number}</span>
                    <div class="driver-meta">
                      <div class="driver-name-row">
                        <img 
                          src={`https://flagcdn.com/w40/${driver.countryCode}.png`}
                          width="18"
                          height="13"
                          alt={driver.nationality}
                          class="driver-flag"
                          loading="lazy"
                        />
                        
                        <a href={`/drivers/${getDriverSlug(driver.code, driver.name)}`} class="driver-profile-link">
                          <span class="driver-fullname">{driver.name}</span>
                          <span class="driver-code-tag">{driver.code}</span>
                        </a>

                        {driver.isChampion ? (
                          <div class="champion-icon" title="Defending Drivers' Champion">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M4.222 19.778c.026.173.082.342.164.502.19.373.498.665.875.83A2.08 2.08 0 0 0 6.222 21h11.556a2.08 2.08 0 0 0 .961-.102c.377-.165.685-.457.875-.83.082-.16.138-.329.164-.502L22 6.556a1 1 0 0 0-1.572-.818l-4.606 3.29-2.934-5.867a1 1 0 0 0-1.776 0l-2.934 5.867-4.606-3.29A1 1 0 0 0 2 6.556l2.222 13.222z"/>
                            </svg>
                          </div>
                        ) : null}
                        {driver.wdc ? (
                          <span class="wdc-count-pill" title={`${driver.wdc}x World Champion`}>{driver.wdc}x WDC</span>
                        ) : null}
                      </div>
                    </div>
                  </div>

                  <!-- Driver Socials -->
                  <div class="driver-socials">
                    {driver.x ? (
                      <a href={driver.x} target="_blank" rel="noopener noreferrer" class="driver-icon-btn" title={`${driver.name} on X`}>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                      </a>
                    ) : null}
                    {driver.instagram ? (
                      <a href={driver.instagram} target="_blank" rel="noopener noreferrer" class="driver-icon-btn" title={`${driver.name} on Instagram`}>
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                      </a>
                    ) : null}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style is:global>
  /* Base Container matching existing pages */
  .directory-page.page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .directory-page .section-header {
    margin-bottom: 3rem;
  }

  .directory-page .badge {
    display: inline-block;
    background-color: var(--color-primary, #e10600);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .directory-page h1 {
    font-size: 2.5rem;
    margin: 0.75rem 0 0.5rem 0;
    font-weight: 800;
    color: #f8fafc;
  }

  .directory-page .section-header p {
    color: var(--color-muted, #94a3b8);
    font-size: 1.15rem;
    margin: 0;
    max-width: 700px;
  }

  /* Teams Stack */
  .directory-page .teams-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Team Card */
  .directory-page .team-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    border-left: 5px solid #334155;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .directory-page .team-card:hover {
    transform: translateY(-2px);
    border-color: #475569;
  }

  /* Team Accent Ribbons */
  .directory-page .team-border-redbull { border-left-color: #3671c6; }
  .directory-page .team-border-ferrari { border-left-color: #e8002d; }
  .directory-page .team-border-mclaren { border-left-color: #ff8000; }
  .directory-page .team-border-mercedes { border-left-color: #27f4d2; }
  .directory-page .team-border-astonmartin { border-left-color: #229971; }
  .directory-page .team-border-alpine { border-left-color: #ff87bc; }
  .directory-page .team-border-williams { border-left-color: #64c4ff; }
  .directory-page .team-border-rb { border-left-color: #6692ff; }
  .directory-page .team-border-audi { border-left-color: #00e700; }
  .directory-page .team-border-cadillac { border-left-color: #d4af37; }
  .directory-page .team-border-haas { border-left-color: #b6babd; }

  /* Team Color Dots */
  .directory-page .team-color-indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .directory-page .team-bg-redbull { background: #3671c6; }
  .directory-page .team-bg-ferrari { background: #e8002d; }
  .directory-page .team-bg-mclaren { background: #ff8000; }
  .directory-page .team-bg-mercedes { background: #27f4d2; }
  .directory-page .team-bg-astonmartin { background: #229971; }
  .directory-page .team-bg-alpine { background: #ff87bc; }
  .directory-page .team-bg-williams { background: #64c4ff; }
  .directory-page .team-bg-rb { background: #6692ff; }
  .directory-page .team-bg-audi { background: #00e700; }
  .directory-page .team-bg-cadillac { background: #d4af37; }
  .directory-page .team-bg-haas { background: #b6babd; }

  /* Team Header */
  .directory-page .team-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid #334155;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* --- NEW TEAM PROFILE LINK STYLES --- */
  .directory-page .team-profile-link {
    text-decoration: none;
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .directory-page .team-profile-link:hover {
    transform: translateX(2px);
  }

  .directory-page .team-profile-link:hover h2 {
