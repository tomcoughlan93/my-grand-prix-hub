---
import Layout from '@/layouts/Layout.astro';
import Parser from 'rss-parser';

// Structured Data for Google Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mygrandprixhub.com/#website",
      "url": "https://mygrandprixhub.com/",
      "name": "My Grand Prix Hub",
      "description": "Your ultimate Formula 1 fan companion for the 2026 season: 2026 race calendar, grandstand reviews, travel logistics, and track guides.",
      "inLanguage": "en-GB"
    },
    {
      "@type": "SportsOrganization",
      "name": "Formula 1 Hub Fan Community",
      "url": "https://mygrandprixhub.com/",
      "sport": "Formula 1"
    }
  ]
};

// --- NEW 1: FETCH TOP 3 STANDINGS ---
let topDrivers: any[] = [];
let topConstructors: any[] = [];

try {
  const [driverRes, constrRes] = await Promise.all([
    fetch('https://api.jolpi.ca/ergast/f1/current/driverStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
    fetch('https://api.jolpi.ca/ergast/f1/current/constructorStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } })
  ]);
  if (driverRes.ok) {
    const dData = await driverRes.json();
    topDrivers = dData?.MRData?.StandingsTable?.StandingsLists?.[0]?.DriverStandings?.slice(0, 3) || [];
  }
  if (constrRes.ok) {
    const cData = await constrRes.json();
    topConstructors = cData?.MRData?.StandingsTable?.StandingsLists?.[0]?.ConstructorStandings?.slice(0, 3) || [];
  }
} catch (e) {
  // Silent fallback
}

// --- NEW 2: RSS PARSER FOR LATEST 3 ARTICLES ---
interface CustomFeedItem { mediaContent?: any; mediaThumbnail?: any; enclosure?: { url?: string }; contentEncoded?: string; description?: string; content?: string; summary?: string; contentSnippet?: string; title?: string; link?: string; pubDate?: string; image?: any; }
const parser: Parser<{}, CustomFeedItem> = new Parser({ customFields: { item: [['media:content', 'mediaContent', { keepArray: true }], ['media:thumbnail', 'mediaThumbnail', { keepArray: true }], ['media:group', 'mediaGroup', { keepArray: true }], ['content:encoded', 'contentEncoded'], ['description', 'description'], ['image', 'image']] } });
const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' },
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;
  if (item.enclosure && item.enclosure.url) url = item.enclosure.url;
  if (!url && item.mediaContent && Array.isArray(item.mediaContent)) { const found = item.mediaContent.find((m: any) => m.$?.url || m.url); if (found) url = found.$?.url || found.url; }
  if (!url && item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) { const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url); if (found) url = found.$?.url || found.url; }
  if (!url && (item as any).mediaGroup && Array.isArray((item as any).mediaGroup)) { const group = (item as any).mediaGroup[0]; if (group && group['media:content'] && Array.isArray(group['media:content'])) { const found = group['media:content'].find((m: any) => m.$?.url || m.url); if (found) url = found.$?.url || found.url; } }
  if (!url && item.image) { if (typeof item.image === 'string') url = item.image; else if (item.image.url) url = item.image.url; else if (item.image.$ && item.image.$.url) url = item.image.$.url; }
  if (!url) { const htmlString = [item.contentEncoded, item.content, item.summary, item.description, item.contentSnippet].filter(Boolean).join(' '); const dataSrcMatch = htmlString.match(/<img[^>]+data-src\s*=\s*["']([^"']+)["']/i); if (dataSrcMatch && dataSrcMatch[1]) url = dataSrcMatch[1]; else { const srcMatch = htmlString.match(/<img[^>]+src\s*=\s*["']([^"']+)["']/i); if (srcMatch && srcMatch[1]) url = srcMatch[1]; } }
  if (!url) { const itemStr = JSON.stringify(item); const regex = /(https?:\/\/[^"'\s>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\s>]*)?)/i; const match = itemStr.match(regex); if (match && match[1]) url = match[1]; }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  return url;
}

let latestNews: any[] = [];
try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems = [];
      for (const item of feed.items || []) {
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!hasValidDate) continue;
        const imageUrl = extractImage(item, src.name);
        if (src.name === 'RacingNews365' && !imageUrl) continue;
        if (!imageUrl) continue;
        
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDateStr: new Date(item.pubDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase(),
          source: src.name,
          snippet: cleanSnippet(item.contentEncoded || item.content || item.summary || item.description || item.contentSnippet),
          imageUrl,
          timestamp: new Date(item.pubDate!).getTime(),
        });
        if (validItems.length >= 3) break;
      }
      return validItems;
    } catch (err) { return []; }
  });
  const results = await Promise.all(feedPromises);
  latestNews = results.flat().sort((a, b) => b.timestamp - a.timestamp).slice(0, 3);
} catch (e) {}
---

<Layout 
  title="My Grand Prix Hub | F1 2026 Calendar & Fan Guide"
  description="Your complete Formula 1 fan companion for 2026. Explore track guides, grandstand reviews, race calendar countdowns, and travel tips."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-container">
      <span class="f1-badge">2026 Formula 1 Fan & Travel Guide</span>
      <h1>Plan Your Ultimate Grand Prix Weekend</h1>
      <p>
        Unbiased grandstand reviews, trackside city guides, and 2026 championship calendar countdowns for Formula 1 fans worldwide.
      </p>
      
      <div class="hero-actions">
        <a href="/championship/calendar" class="btn primary-btn">
          <span>2026 Race Calendar</span> 📅
        </a>
        <a href="/circuits-live/grandstands" class="btn secondary-btn">
          Grandstand Reviews 💺
        </a>
        <a href="/tv-guides" class="btn secondary-btn">
          Where to Watch 📺
        </a>
      </div>
    </div>
  </section>

  <main class="page-container">
    
    <!-- CHAMPIONSHIP SNAPSHOT -->
    {topDrivers.length > 0 && topConstructors.length > 0 && (
      <section class="section-block snapshot-section">
        <div class="section-title-row">
          <h2>2026 Championship Leaders</h2>
          <a href="/championship/standings" class="view-all-link">Full Standings &rarr;</a>
        </div>
        
        <div class="snapshot-grid">
          <!-- Drivers Standings -->
          <div class="standings-list-wrap">
            <h3 class="list-title">Drivers</h3>
            <div class="standings-list">
              {topDrivers.map((d: any) => (
                <div class="standing-row">
                  <div class="name-col">
                    <span class="pos-badge">P{d.position}</span>
                    <span class="d-code">{d.Driver.code}</span>
                    <span class="d-name">{d.Driver.familyName}</span>
                  </div>
                  <span class="pts-col">{d.points} <span class="pts-lbl">PTS</span></span>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Constructors Standings -->
          <div class="standings-list-wrap">
            <h3 class="list-title">Constructors</h3>
            <div class="standings-list">
              {topConstructors.map((c: any) => (
                <div class="standing-row">
                  <div class="name-col">
                    <span class="pos-badge">P{c.position}</span>
                    <span class="d-name">{c.Constructor.name}</span>
                  </div>
                  <span class="pts-col">{c.points} <span class="pts-lbl">PTS</span></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- FEATURED PILLARS / CORE HUBS -->
    <section class="section-block">
      <div class="section-title-row">
        <div class="title-stack">
          <h2>Explore The Hub</h2>
          <p>Everything you need whether attending trackside or following the race from home.</p>
        </div>
      </div>

      <div class="pillar-grid">
        <a href="/championship/calendar" class="pillar-card">
          <div class="pillar-icon">📅</div>
          <h3>2026 Race Calendar</h3>
          <p>Session timetables in your local time, session countdowns, Pirelli tyre allocations, and live track weather.</p>
          <span class="pillar-link">View 2026 Schedule &rarr;</span>
        </a>

        <a href="/circuits-live/circuit-guides" class="pillar-card">
          <div class="pillar-icon">🏎️</div>
          <h3>Circuit Guides</h3>
          <p>In-depth track layouts, overtaking hotspots, gate entry guidelines, and trackside amenities.</p>
          <span class="pillar-link">Browse All Tracks &rarr;</span>
        </a>

        <a href="/circuits-live/grandstands" class="pillar-card">
          <div class="pillar-icon">💺</div>
          <h3>Grandstand Reviews</h3>
          <p>Community-sourced seat views, TV screen sightlines, comfort ratings, and value-for-money tips.</p>
          <span class="pillar-link">Find Best Seats &rarr;</span>
        </a>

        <a href="/travel-and-tickets" class="pillar-card">
          <div class="pillar-icon">✈️</div>
          <h3>Travel & Tickets</h3>
          <p>Airport transfers, circuit shuttles, camping grounds, accommodation tips, and official ticket onsale dates.</p>
          <span class="pillar-link">Plan Your Trip &rarr;</span>
        </a>

        <a href="/championship" class="pillar-card">
          <div class="pillar-icon">🏆</div>
          <h3>Standings & Teams</h3>
          <p>Drivers' and Constructors' championship points tables, driver moves, and team technical specifications.</p>
          <span class="pillar-link">Check Profiles &rarr;</span>
        </a>

        <a href="/tv-guides" class="pillar-card">
          <div class="pillar-icon">📺</div>
          <h3>Where to Watch</h3>
          <p>Worldwide TV broadcaster directories, streaming options, and weekend broadcast schedules.</p>
          <span class="pillar-link">Find Broadcasters &rarr;</span>
        </a>
      </div>
    </section>

    <!-- LATEST NEWS PREVIEW -->
    {latestNews && latestNews.length > 0 && (
      <section class="section-block">
        <div class="section-title-row">
          <h2>Latest Paddock News</h2>
          <a href="/latest-news" class="view-all-link">View All News &rarr;</a>
        </div>
        
        <div class="news-grid">
          {latestNews.map((article: any) => (
            <a href={article.link} target="_blank" rel="noopener noreferrer" class="news-card">
              {article.imageUrl && (
                <div class="card-image-wrap">
                  <img src={article.imageUrl} alt={article.title} loading="lazy" class="card-image" />
                </div>
              )}
              <div class="news-content">
                <div class="news-meta">
                  <span class="feed-source">{article.source}</span>
                  <span class="news-date">{article.pubDateStr}</span>
                </div>
                <h3 class="news-title">{article.title}</h3>
                {article.snippet && <p class="news-excerpt">{article.snippet}</p>}
                <span class="read-more">Read on {article.source} ↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- SEO KEYWORD PROSE SECTION -->
    <section class="seo-intro-block">
      <h2>Built by Fans, Designed for the Ultimate F1 Experience</h2>
      <p>
        <strong>My Grand Prix Hub</strong> is an independent spectator resource built for Formula 1 fans attending races in person or streaming from home. Whether you are searching for the best grandstand seat at Silverstone, organizing travel to Spa-Francorchamps, or checking local broadcaster listings, we provide comprehensive, unbiased advice to make every race weekend unforgettable.
      </p>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="community-banner">
      <div class="banner-content">
        <span class="pill-red">Community Powered</span>
        <h2>Been Trackside at a Grand Prix?</h2>
        <p>Help fellow motorsport fans pick the best seats! Share your photos, sightline ratings, and grandstand reviews with the global community.</p>
        <a href="/circuits-live/grandstands" class="btn primary-btn">Submit a Review ✍️</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 5rem 1.5rem; width: 100%; box-sizing: border-box; }

  /* Hero Banner */
  .hero { background: linear-gradient(180deg, #1e293b 0%, #0b0f19 100%); border-bottom: 1px solid #334155; padding: 5rem 1.5rem; text-align: center; width: 100%; }
  .hero-container { max-width: 850px; margin: 0 auto; }
  .f1-badge { display: inline-block; background-color: #e10600; color: #ffffff; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; padding: 0.35rem 0.8rem; border-radius: 4px; letter-spacing: 0.05em; }
  .hero h1 { font-size: 3rem; line-height: 1.15; margin: 1.25rem 0 1rem 0; font-weight: 900; color: #f8fafc; letter-spacing: -0.02em; }
  .hero p { font-size: 1.15rem; color: #94a3b8; line-height: 1.6; margin-bottom: 2.25rem; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease; }
  .btn:hover { transform: translateY(-2px); }
  .primary-btn { background-color: #e10600; color: #ffffff; }
  .primary-btn:hover { background-color: #b80500; }
  .secondary-btn { background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; }
  .secondary-btn:hover { background-color: #334155; }

  /* Sections */
  .section-block { margin-top: 3.5rem; margin-bottom: 4rem; }
  .section-title-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid #334155; padding-bottom: 0.75rem; }
  .section-title-row h2 { font-size: 1.8rem; margin: 0 0 0.5rem 0; font-weight: 800; color: #ffffff; }
  .section-title-row p { color: #94a3b8; margin: 0; font-size: 1.05rem; }
  .view-all-link { color: #38bdf8; font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.05em; text-decoration: none; transition: color 0.2s; }
  .view-all-link:hover { color: #7dd3fc; }

  /* Snapshot Grid */
  .snapshot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
  .list-title { font-size: 0.85rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.75rem 0; font-weight: 800; }
  .standings-list { background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25); }
  .standing-row { display: flex; align-items: center; justify-content: space-between; padding: 1.15rem 1.5rem; border-bottom: 1px solid #1e293b; }
  .standing-row:last-child { border-bottom: none; }
  .pos-badge { font-weight: 900; color: #64748b; font-size: 1.1rem; width: 30px; }
  .name-col { display: flex; align-items: center; gap: 0.75rem; flex-grow: 1; }
  .d-code { background: #1e293b; color: #cbd5e1; font-size: 0.75rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid #334155; }
  .d-name { font-weight: 800; color: #f8fafc; font-size: 1.1rem; }
  .pts-col { font-weight: 900; color: #ffffff; font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .pts-lbl { font-size: 0.7rem; color: #e10600; margin-left: 0.25rem; }

  /* Pillars Grid */
  .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .pillar-card { background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 1.75rem; text-decoration: none; color: inherit; transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease; display: flex; flex-direction: column; }
  .pillar-card:hover { border-color: #38bdf8; transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
  .highlight-card { position: relative; background: linear-gradient(135deg, rgba(225, 6, 0, 0.08) 0%, rgba(15, 23, 42, 1) 100%); border: 1px solid rgba(225, 6, 0, 0.3); }
  .highlight-card:hover { border-color: #e10600; box-shadow: 0 8px 30px rgba(225, 6, 0, 0.25); }
  .pillar-icon { font-size: 2rem; margin-bottom: 1rem; }
  .pillar-card h3 { font-size: 1.25rem; font-weight: 800; margin: 0 0 0.5rem 0; color: #f8fafc; }
  .pillar-card p { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; margin: 0 0 1.5rem 0; flex-grow: 1; }
  .pillar-link { color: #38bdf8; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }

  /* News Grid */
  .news-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem; }
  .news-card { background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; text-decoration: none; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; display: flex; flex-direction: column; overflow: hidden; }
  .news-card:hover { transform: translateY(-4px); border-color: #475569; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
  .card-image-wrap { height: 180px; overflow: hidden; background: #0b0f19; border-bottom: 1px solid #1e293b; }
  .card-image { width: 100%; height: 100%; object-fit: cover; }
  .news-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .news-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
  .feed-source { color: #38bdf8; }
  .news-date { color: #64748b; }
  .news-title { font-size: 1.2rem; font-weight: 800; color: #f8fafc; margin: 0 0 0.75rem 0; line-height: 1.4; }
  .news-excerpt { font-size: 0.9rem; color: #94a3b8; line-height: 1.5; margin: 0 0 1.5rem 0; flex-grow: 1; }
  .read-more { font-size: 0.8rem; font-weight: 700; color: #e10600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: auto; }

  /* SEO Prose Section */
  .seo-intro-block { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 2.25rem; margin-bottom: 4rem; }
  .seo-intro-block h2 { font-size: 1.4rem; font-weight: 800; color: #f8fafc; margin: 0 0 0.75rem 0; }
  .seo-intro-block p { color: #94a3b8; font-size: 1rem; line-height: 1.7; margin: 0; }

  /* Community Banner */
  .community-banner { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155; border-left: 4px solid #e10600; border-radius: 12px; padding: 3.5rem 2rem; text-align: center; }
  .banner-content { max-width: 650px; margin: 0 auto; }
  .pill-red { display: inline-block; background-color: rgba(225, 6, 0, 0.15); color: #ff4d4d; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; padding: 0.3rem 0.7rem; border-radius: 4px; letter-spacing: 0.05em; }
  .community-banner h2 { font-size: 2.2rem; font-weight: 800; margin: 0.75rem 0 0.5rem 0; color: #f8fafc; }
  .community-banner p { color: #94a3b8; font-size: 1.05rem; margin-bottom: 2rem; line-height: 1.6; }

  @media (max-width: 768px) {
    .hero { padding: 3.5rem 1rem; }
    .hero h1 { font-size: 2.25rem; }
    .hero-actions { flex-direction: column; }
    .section-title-row { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .section-title-row h2 { font-size: 1.6rem; }
    .snapshot-grid { grid-template-columns: 1fr; }
  }
</style>