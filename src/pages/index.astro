---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const circuits = (await getCollection('circuits')) || [];

// Structured Data for Google Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mygrandprixhub.com/#website",
      "url": "https://mygrandprixhub.com/",
      "name": "My Grand Prix Hub",
      "description": "Your ultimate Formula 1 fan companion for the 2026 season: 2026 race calendar, grandstand reviews, travel logistics, and track guides.",
      "inLanguage": "en-GB"
    },
    {
      "@type": "SportsOrganization",
      "name": "Formula 1 Hub Fan Community",
      "url": "https://mygrandprixhub.com/",
      "sport": "Formula 1"
    }
  ]
};

// Condensed 2026 Calendar using explicit local track time and offsets
const TICKER_RACES = [
  { 
    raceName: "Dutch Grand Prix", 
    isSprint: true, 
    sessions: { 
      fp1: "2026-08-21T12:30:00+02:00", 
      fp2: "2026-08-21T16:00:00+02:00", // Sprint Quali
      fp3: "2026-08-22T11:30:00+02:00", // Sprint Race
      quali: "2026-08-22T16:00:00+02:00", 
      race: "2026-08-23T15:00:00+02:00" 
    } 
  },
  { 
    raceName: "Italian Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-04T13:30:00+02:00", 
      fp2: "2026-09-04T17:00:00+02:00", 
      fp3: "2026-09-05T12:30:00+02:00", 
      quali: "2026-09-05T16:00:00+02:00", 
      race: "2026-09-06T15:00:00+02:00" 
    } 
  },
  { 
    raceName: "Madrid Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-11T13:30:00+02:00", 
      fp2: "2026-09-11T17:00:00+02:00", 
      fp3: "2026-09-12T12:30:00+02:00", 
      quali: "2026-09-12T16:00:00+02:00", 
      race: "2026-09-13T15:00:00+02:00" 
    } 
  },
  { 
    raceName: "Azerbaijan Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-24T13:30:00+04:00", 
      fp2: "2026-09-24T17:00:00+04:00", 
      fp3: "2026-09-25T12:30:00+04:00", 
      quali: "2026-09-25T16:00:00+04:00", 
      race: "2026-09-26T15:00:00+04:00" 
    } 
  },
  { 
    raceName: "Singapore Grand Prix", 
    isSprint: true, 
    sessions: { 
      fp1: "2026-10-09T17:30:00+08:00", // Shifted to Night Race times
      fp2: "2026-10-09T21:30:00+08:00", // Sprint Quali
      fp3: "2026-10-10T17:30:00+08:00", // Sprint Race
      quali: "2026-10-10T21:00:00+08:00", 
      race: "2026-10-11T20:00:00+08:00" 
    } 
  }
];

const now = new Date();
let nextSession = null;

// Determine the very next active session
for (const race of TICKER_RACES) {
  const sessions = [
    { id: 'FP1', name: 'Practice 1', time: new Date(race.sessions.fp1) },
    { id: 'FP2', name: race.isSprint ? 'Sprint Quali' : 'Practice 2', time: new Date(race.sessions.fp2) },
    { id: 'FP3', name: race.isSprint ? 'Sprint Race' : 'Practice 3', time: new Date(race.sessions.fp3) },
    { id: 'QUALI', name: 'Qualifying', time: new Date(race.sessions.quali) },
    { id: 'RACE', name: 'Race', time: new Date(race.sessions.race) }
  ];

  for (const session of sessions) {
    // Check if the session is still happening (adds a 1-hour buffer after start time)
    const sessionEndTime = new Date(session.time.getTime() + (60 * 60 * 1000));
    
    if (sessionEndTime > now) {
      nextSession = { 
        race: race.raceName, 
        name: session.name, 
        utcTime: session.time.toISOString() 
      };
      break;
    }
  }
  if (nextSession) break;
}
---

<Layout 
  title="My Grand Prix Hub | F1 2026 Calendar & Grandstand Reviews"
  description="Your complete Formula 1 fan companion for 2026. Explore track guides, grandstand reviews, race calendar countdowns, and travel tips."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-container">
      <span class="f1-badge">2026 Formula 1 Fan & Travel Guide</span>
      <h1>Plan Your Ultimate Grand Prix Weekend</h1>
      <p>
        Unbiased grandstand reviews, trackside city guides, and 2026 championship calendar countdowns for Formula 1 fans worldwide.
      </p>
      
      <div class="hero-actions">
        <a href="/championship/calendar" class="btn primary-btn">
          <span>2026 Race Calendar</span> 📅
        </a>
        <a href="/circuits-live/grandstands" class="btn secondary-btn">
          Grandstand Reviews 💺
        </a>
      </div>
    </div>
  </section>

  <!-- NEXT SESSION TICKER -->
  {nextSession && (
    <div class="session-ticker-wrapper">
      <div class="session-ticker">
        <div class="ticker-left">
          <span class="ticker-badge">NEXT SESSION</span>
          <span class="ticker-race">{nextSession.race} <span class="divider">|</span> {nextSession.name}</span>
        </div>
        <div class="ticker-right">
          <!-- The Countdown Timer -->
          <div class="ticker-countdown js-ticker-countdown">
            <span class="cd-section"><span class="cd-val js-cd-d">00</span><span class="cd-lbl">D</span></span>
            <span class="cd-sep">:</span>
            <span class="cd-section"><span class="cd-val js-cd-h">00</span><span class="cd-lbl">H</span></span>
            <span class="cd-sep">:</span>
            <span class="cd-section"><span class="cd-val js-cd-m">00</span><span class="cd-lbl">M</span></span>
            <span class="cd-sep">:</span>
            <span class="cd-section"><span class="cd-val js-cd-s">00</span><span class="cd-lbl">S</span></span>
          </div>

          <!-- Local Time -->
          <div class="ticker-local">
            <span class="ticker-label">Local Time:</span>
            <span class="ticker-time js-ticker-time" data-utc={nextSession.utcTime}>Loading...</span>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- MAIN PAGE CONTENT -->
  <main class="page-container">
    
    <!-- FEATURED PILLARS / CORE HUBS -->
    <section class="section-block" aria-labelledby="core-features-title">
      <div class="section-title-row">
        <h2 id="core-features-title">Explore The Grand Prix Hub</h2>
        <p>Everything you need whether attending trackside or following the race from home.</p>
      </div>

      <div class="pillar-grid">
        <!-- 1. 2026 RACE CALENDAR -->
        <a href="/championship/calendar" class="pillar-card">
          <div class="pillar-icon">📅</div>
          <h3>2026 Race Calendar</h3>
          <p>Session timetables in your local time, session countdowns, Pirelli tyre allocations, and live track weather.</p>
          <span class="pillar-link">View 2026 Schedule &rarr;</span>
        </a>

        <!-- 2. CIRCUITS & TRACK GUIDES -->
        <a href="/circuits-live/circuit-guides" class="pillar-card">
          <div class="pillar-icon">🏎️</div>
          <h3>Circuit Guides</h3>
          <p>In-depth track layouts, overtaking hotspots, gate entry guidelines, and trackside amenities.</p>
          <span class="pillar-link">Browse All Tracks &rarr;</span>
        </a>

        <!-- 3. GRANDSTAND REVIEWS -->
        <a href="/circuits-live/grandstands" class="pillar-card">
          <div class="pillar-icon">💺</div>
          <h3>Grandstand Reviews</h3>
          <p>Community-sourced seat views, TV screen sightlines, comfort ratings, and value-for-money tips.</p>
          <span class="pillar-link">Find Best Seats &rarr;</span>
        </a>

        <!-- 4. CHAMPIONSHIP STANDINGS -->
        <a href="/championship" class="pillar-card">
          <div class="pillar-icon">🏆</div>
          <h3>2026 Standings & Teams</h3>
          <p>Drivers' and Constructors' championship points tables, 2026 driver moves, and technical specifications.</p>
          <span class="pillar-link">Check Standings &rarr;</span>
        </a>

        <!-- 5. TRAVEL & TICKETS -->
        <a href="/travel-and-tickets" class="pillar-card">
          <div class="pillar-icon">✈️</div>
          <h3>Travel & Tickets</h3>
          <p>Airport transfers, circuit shuttles, camping grounds, accommodation tips, and official ticket onsale dates.</p>
          <span class="pillar-link">Plan Your Trip &rarr;</span>
        </a>

        <!-- 6. WHERE TO WATCH & BROADCASTERS -->
        <a href="/tv-guides" class="pillar-card">
          <div class="pillar-icon">📺</div>
          <h3>Where to Watch</h3>
          <p>Worldwide TV broadcaster directories, F1 TV Pro availability, streaming options, and weekend schedules.</p>
          <span class="pillar-link">Find Broadcasters &rarr;</span>
        </a>

        <!-- 7. PODCASTS & CREATORS -->
        <a href="/creators" class="pillar-card">
          <div class="pillar-icon">🎙️</div>
          <h3>Podcasts & Creators</h3>
          <p>Curated directory of top F1 YouTubers, technical analysis channels, and paddock podcasts.</p>
          <span class="pillar-link">Discover Creators &rarr;</span>
        </a>

        <!-- 8. LATEST NEWS & EDITORIALS -->
        <a href="/latest-news" class="pillar-card highlight-card">
          <div class="card-badge-row">
            <span class="pillar-icon">📰</span>
          </div>
          <h3>Latest News & Editorials</h3>
          <p>Read expert race previews, weekend summaries, and deep-dive editorial pieces from around the paddock.</p>
          <span class="pillar-link">Read Articles &rarr;</span>
        </a>
      </div>
    </section>

    <!-- SEO KEYWORD PROSE SECTION -->
    <section class="seo-intro-block">
      <h2>Built by Fans, Designed for the Ultimate F1 Experience</h2>
      <p>
        <strong>My Grand Prix Hub</strong> is an independent spectator resource built for Formula 1 fans attending races in person or streaming from home. Whether you are searching for the best grandstand seat at Silverstone, organizing travel to Spa-Francorchamps, checking live session timing for the Dutch Grand Prix, or looking for local broadcaster listings, we provide comprehensive, unbiased advice to make every race weekend unforgettable.
      </p>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="community-banner" aria-labelledby="community-heading">
      <div class="banner-content">
        <span class="pill-red">Community Powered</span>
        <h2 id="community-heading">Been Trackside at a Grand Prix?</h2>
        <p>Help fellow motorsport fans pick the best seats! Share your photos, sightline ratings, and grandstand reviews with the global community.</p>
        <a href="/circuits-live/grandstands" class="btn primary-btn">Submit a Review ✍️</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const timeEl = document.querySelector('.js-ticker-time');
    const countdownEl = document.querySelector('.js-ticker-countdown');
    let targetDate = null;

    // 1. Timezone Conversion
    if (timeEl) {
      const utcStr = timeEl.getAttribute('data-utc');
      if (utcStr) {
        targetDate = new Date(utcStr);
        const formatter = new Intl.DateTimeFormat('en-US', {
          weekday: 'short', month: 'short', day: 'numeric', 
          hour: '2-digit', minute: '2-digit', hour12: true
        });
        timeEl.textContent = formatter.format(targetDate);
      }
    }

    // 2. Countdown Timer Initialization
    if (countdownEl && targetDate) {
      const elDays = countdownEl.querySelector('.js-cd-d');
      const elHours = countdownEl.querySelector('.js-cd-h');
      const elMins = countdownEl.querySelector('.js-cd-m');
      const elSecs = countdownEl.querySelector('.js-cd-s');

      function updateCountdown() {
        const now = new Date().getTime();
        const distance = targetDate.getTime() - now;

        if (distance < 0) {
          if (elDays) elDays.textContent = "00";
          if (elHours) elHours.textContent = "00";
          if (elMins) elMins.textContent = "00";
          if (elSecs) elSecs.textContent = "00";
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (elDays) elDays.textContent = String(days).padStart(2, '0');
        if (elHours) elHours.textContent = String(hours).padStart(2, '0');
        if (elMins) elMins.textContent = String(minutes).padStart(2, '0');
        if (elSecs) elSecs.textContent = String(seconds).padStart(2, '0');
      }

      updateCountdown(); // Run immediately so there's no delay
      setInterval(updateCountdown, 1000); // Tick every second
    }
  });
</script>

<style>
  /* Container Constraints */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Hero Banner */
  .hero {
    background: linear-gradient(180deg, #1e293b 0%, #0b0f19 100%);
    border-bottom: 1px solid #334155;
    padding: 5rem 1.5rem;
    text-align: center;
    width: 100%;
  }

  .hero-container {
    max-width: 850px;
    margin: 0 auto;
  }

  .f1-badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .hero h1 {
    font-size: 3rem;
    line-height: 1.15;
    margin: 1.25rem 0 1rem 0;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .hero p {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .primary-btn {
    background-color: #e10600;
    color: #ffffff;
  }

  .primary-btn:hover {
    background-color: #b80500;
  }

  .secondary-btn {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
  }

  .secondary-btn:hover {
    background-color: #334155;
  }

  /* ========================================= */
  /* TICKER STYLING                            */
  /* ========================================= */
  .session-ticker-wrapper {
    background: linear-gradient(90deg, #0b0f19 0%, #1e293b 50%, #0b0f19 100%);
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    margin-bottom: 3.5rem;
  }

  .session-ticker {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .ticker-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ticker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #facc15;
    color: #000000;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    box-shadow: 0 0 12px rgba(250, 204, 21, 0.3);
  }

  .ticker-badge::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: #000000;
    border-radius: 50%;
    animation: tickerPulse 1.5s infinite;
  }

  @keyframes tickerPulse {
    0% { transform: scale(0.9); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.5; }
    100% { transform: scale(0.9); opacity: 1; }
  }

  .ticker-race {
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ticker-race .divider {
    color: #475569;
    margin: 0 0.5rem;
    font-weight: 300;
  }

  /* Right Side layout: Countdown + Local Time */
  .ticker-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Countdown Module */
  .ticker-countdown {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cd-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0b0f19;
    border: 1px solid #334155;
    border-radius: 4px;
    min-width: 46px;
    padding: 0.35rem 0.2rem;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.6);
  }

  .cd-val {
    font-size: 1.2rem;
    font-weight: 900;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .cd-lbl {
    font-size: 0.6rem;
    font-weight: 800;
    color: #e10600; /* F1 Red accent */
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cd-sep {
    color: #475569;
    font-weight: 900;
    font-size: 1.25rem;
    line-height: 1;
    margin-top: -0.75rem; /* Visually aligns the colon with the numbers, ignoring the labels */
  }

  /* Local Time Module */
  .ticker-local {
    background: #0f172a;
    border: 1px solid #334155;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
  }

  .ticker-label {
    color: #94a3b8;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-right: 0.5rem;
  }

  .ticker-time {
    color: #34d399;
    font-weight: 800;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .ticker-right {
      flex-wrap: wrap;
    }
  }
  
  @media (max-width: 768px) {
    .session-ticker {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    
    .ticker-right {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .ticker-countdown {
      justify-content: center;
      padding: 0.5rem;
    }

    .ticker-local {
      justify-content: space-between;
    }
  }
  /* ========================================= */

  /* Section Spacing */
  .section-block {
    margin-top: 3.5rem;
    margin-bottom: 4rem;
  }

  .section-title-row {
    margin-bottom: 2rem;
  }

  .section-title-row h2 {
    font-size: 2.1rem;
    margin: 0 0 0.5rem 0;
    font-weight: 800;
    color: #f8fafc;
  }

  .section-title-row p {
    color: #94a3b8;
    margin: 0;
    font-size: 1.05rem;
  }

  /* Grid Layout */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .pillar-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .pillar-card:hover {
    border-color: #e10600;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .pillar-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .pillar-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    color: #f8fafc;
  }

  .pillar-card p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .pillar-link {
    color: #38bdf8;
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* SEO Prose Section */
  .seo-intro-block {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2.25rem;
    margin-bottom: 4rem;
  }

  .seo-intro-block h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.75rem 0;
  }

  .seo-intro-block p {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Community Banner */
  .community-banner {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155;
    border-left: 4px solid #e10600;
    border-radius: 8px;
    padding: 3.5rem 2rem;
    text-align: center;
  }

  .banner-content {
    max-width: 650px;
    margin: 0 auto;
  }

  .pill-red {
    display: inline-block;
    background-color: rgba(225, 6, 0, 0.15);
    color: #ff4d4d;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .banner-content h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0.75rem 0 0.5rem 0;
    color: #f8fafc;
  }

  .banner-content p {
    color: #94a3b8;
    font-size: 1.05rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero { padding: 3.5rem 1rem; }
    .hero h1 { font-size: 2.25rem; }
    .hero-actions { flex-direction: column; }
    .section-title-row h2 { font-size: 1.75rem; }
  }
</style>