---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import tinaResults from '@/content/results/current.json';

const circuits = (await getCollection('circuits')) || [];

// Structured Data for Google Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mygrandprixhub.com/#website",
      "url": "https://mygrandprixhub.com/",
      "name": "My Grand Prix Hub",
      "description": "Your ultimate Formula 1 fan companion for the 2026 season: 2026 race calendar, grandstand reviews, travel logistics, and track guides.",
      "inLanguage": "en-GB"
    },
    {
      "@type": "SportsOrganization",
      "name": "Formula 1 Hub Fan Community",
      "url": "https://mygrandprixhub.com/",
      "sport": "Formula 1"
    }
  ]
};

// Condensed 2026 Calendar with explicit track times & offsets
const TICKER_RACES = [
  { 
    id: "dutch-gp",
    raceName: "Dutch Grand Prix", 
    isSprint: true, 
    sessions: { 
      fp1: "2026-08-21T12:30:00+02:00", 
      fp2: "2026-08-21T16:00:00+02:00",
      fp3: "2026-08-22T11:30:00+02:00",
      quali: "2026-08-22T16:00:00+02:00", 
      race: "2026-08-23T15:00:00+02:00" 
    } 
  },
  { 
    id: "italian-gp",
    raceName: "Italian Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-04T13:30:00+02:00", 
      fp2: "2026-09-04T17:00:00+02:00", 
      fp3: "2026-09-05T12:30:00+02:00", 
      quali: "2026-09-05T16:00:00+02:00", 
      race: "2026-09-06T15:00:00+02:00" 
    } 
  },
  { 
    id: "madrid-gp",
    raceName: "Madrid Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-11T13:30:00+02:00", 
      fp2: "2026-09-11T17:00:00+02:00", 
      fp3: "2026-09-12T12:30:00+02:00", 
      quali: "2026-09-12T16:00:00+02:00", 
      race: "2026-09-13T15:00:00+02:00" 
    } 
  },
  { 
    id: "azerbaijan-gp",
    raceName: "Azerbaijan Grand Prix", 
    isSprint: false, 
    sessions: { 
      fp1: "2026-09-24T13:30:00+04:00", 
      fp2: "2026-09-24T17:00:00+04:00", 
      fp3: "2026-09-25T12:30:00+04:00", 
      quali: "2026-09-25T16:00:00+04:00", 
      race: "2026-09-26T15:00:00+04:00" 
    } 
  },
  { 
    id: "singapore-gp",
    raceName: "Singapore Grand Prix", 
    isSprint: true, 
    sessions: { 
      fp1: "2026-10-09T17:30:00+08:00", 
      fp2: "2026-10-09T21:30:00+08:00", 
      fp3: "2026-10-10T17:30:00+08:00", 
      quali: "2026-10-10T21:00:00+08:00", 
      race: "2026-10-11T20:00:00+08:00" 
    } 
  }
];

const now = new Date();
let nextSession: any = null;
let recentFinishedRace: any = null;

// Helper to calculate the Monday 00:00 cutoff immediately following a Sunday race
function getMondayCutoff(raceDate: Date) {
  const d = new Date(raceDate);
  // Roll to Monday 00:00:00
  d.setDate(d.getDate() + (1 + 7 - d.getDay()) % 7 || 1);
  d.setHours(0, 0, 0, 0);
  return d;
}

// 1. Check if the current race has recently concluded and has results
const currentRaceObj = TICKER_RACES[0];
const currentRaceStartTime = new Date(currentRaceObj.sessions.race);
const currentMondayCutoff = getMondayCutoff(currentRaceStartTime);

const hasRaceResults = Boolean(tinaResults?.race?.first);

if (now >= currentRaceStartTime) {
  recentFinishedRace = {
    raceName: currentRaceObj.raceName,
    podium: tinaResults?.race,
    hasResults: hasRaceResults
  };
}

// 2. Determine whether to show Sunday post-race banner OR roll to next race
for (const race of TICKER_RACES) {
  const raceStartTime = new Date(race.sessions.race);
  const mondayCutoff = getMondayCutoff(raceStartTime);

  const sessions = [
    { id: 'FP1', name: 'Practice 1', time: new Date(race.sessions.fp1), durationHours: 1 },
    { id: 'FP2', name: race.isSprint ? 'Sprint Quali' : 'Practice 2', time: new Date(race.sessions.fp2), durationHours: 1 },
    { id: 'FP3', name: race.isSprint ? 'Sprint Race' : 'Practice 3', time: new Date(race.sessions.fp3), durationHours: 1 },
    { id: 'QUALI', name: 'Qualifying', time: new Date(race.sessions.quali), durationHours: 1 },
    { id: 'RACE', name: 'Race', time: raceStartTime, durationHours: 2 }
  ];

  // If we are before Monday 00:00 post-race, keep active weekend in focus
  if (now < mondayCutoff) {
    for (const session of sessions) {
      const sessionStart = session.time.getTime();
      const sessionEnd = sessionStart + (session.durationHours * 60 * 60 * 1000);

      if (now.getTime() < sessionStart) {
        nextSession = {
          race: race.raceName,
          name: session.name,
          utcTime: session.time.toISOString(),
          utcEndTime: new Date(sessionEnd).toISOString(),
          state: 'UPCOMING'
        };
        break;
      } else if (now.getTime() >= sessionStart && now.getTime() <= sessionEnd) {
        nextSession = {
          race: race.raceName,
          name: session.name,
          utcTime: session.time.toISOString(),
          utcEndTime: new Date(sessionEnd).toISOString(),
          state: 'LIVE'
        };
        break;
      }
    }

    // Race is finished, but we haven't reached Monday yet
    if (!nextSession && now.getTime() > raceStartTime.getTime()) {
      nextSession = {
        race: race.raceName,
        name: 'Grand Prix Race',
        utcTime: raceStartTime.toISOString(),
        utcEndTime: new Date(raceStartTime.getTime() + (2 * 60 * 60 * 1000)).toISOString(),
        state: hasRaceResults ? 'SHOW_RESULTS' : 'AWAITING_RESULTS',
        podium: tinaResults?.race
      };
    }
  }

  if (nextSession) break;
}
---

<Layout 
  title="My Grand Prix Hub | F1 2026 Calendar & Grandstand Reviews"
  description="Your complete Formula 1 fan companion for 2026. Explore track guides, grandstand reviews, race calendar countdowns, and travel tips."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-container">
      <span class="f1-badge">2026 Formula 1 Fan & Travel Guide</span>
      <h1>Plan Your Ultimate Grand Prix Weekend</h1>
      <p>
        Unbiased grandstand reviews, trackside city guides, and 2026 championship calendar countdowns for Formula 1 fans worldwide.
      </p>
      
      <div class="hero-actions">
        <a href="/championship/calendar" class="btn primary-btn">
          <span>2026 Race Calendar</span> 📅
        </a>
        <a href="/circuits-live/grandstands" class="btn secondary-btn">
          Grandstand Reviews 💺
        </a>
        <a href="/tv-guides" class="btn secondary-btn">
          Where to Watch   📺
        </a>
      </div>
    </div>
  </section>

  <!-- NEXT SESSION TICKER -->
  {nextSession && (
    <div class="session-ticker-wrapper">
      <div class="session-ticker">
        <div class="ticker-left">
          <span 
            class={`ticker-badge ${nextSession.state === 'LIVE' ? 'badge-live' : nextSession.state === 'SHOW_RESULTS' || nextSession.state === 'AWAITING_RESULTS' ? 'badge-awaiting' : ''}`} 
            id="ticker-badge-el"
          >
            {nextSession.state === 'LIVE' ? '● LIVE NOW' : nextSession.state === 'SHOW_RESULTS' || nextSession.state === 'AWAITING_RESULTS' ? '🏁 RACE COMPLETED' : 'NEXT SESSION'}
          </span>
          <span class="ticker-race">{nextSession.race} <span class="divider">|</span> {nextSession.name}</span>
        </div>

        <div class="ticker-right">
          {nextSession.state === 'SHOW_RESULTS' ? (
            <div class="spoiler-results-wrapper">
              <button type="button" class="btn-reveal js-btn-reveal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Reveal Results</span>
              </button>
              <div class="spoiler-podium js-spoiler-podium hidden">
                <span class="pod-step">🥇 {nextSession.podium.first}</span>
                <span class="pod-step">🥈 {nextSession.podium.second}</span>
                <span class="pod-step">🥉 {nextSession.podium.third}</span>
              </div>
            </div>
          ) : nextSession.state === 'AWAITING_RESULTS' ? (
            <div class="ticker-awaiting-indicator">
              <span>Awaiting Official Results...</span>
            </div>
          ) : (
            <>
              <!-- The Countdown Timer -->
              <div 
                class="ticker-countdown js-ticker-countdown" 
                data-utc={nextSession.utcTime} 
                data-utc-end={nextSession.utcEndTime} 
                data-state={nextSession.state}
              >
                <span class="cd-section"><span class="cd-val js-cd-d">00</span><span class="cd-lbl">D</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-h">00</span><span class="cd-lbl">H</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-m">00</span><span class="cd-lbl">M</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-s">00</span><span class="cd-lbl">S</span></span>
              </div>

              <!-- Local Time -->
              <div class="ticker-local">
                <span class="ticker-label">Local Time:</span>
                <span class="ticker-time js-ticker-time" data-utc={nextSession.utcTime}>Loading...</span>
              </div>
            </>
          )}
        </div>
      </div>

      <!-- MONDAY ONWARDS RECENT RESULTS SPOILER SUB-BANNER -->
      {now >= currentMondayCutoff && recentFinishedRace?.hasResults && (
        <div class="sub-recent-banner">
          <div class="sub-recent-inner">
            <div class="sub-left">
              <span class="sub-badge">LATEST GP</span>
              <span class="sub-text"><strong>{recentFinishedRace.raceName}</strong> Podium</span>
            </div>
            <div class="spoiler-results-wrapper">
              <button type="button" class="btn-reveal js-btn-reveal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Reveal Results</span>
              </button>
              <div class="spoiler-podium js-spoiler-podium hidden">
                <span class="pod-step">🥇 {recentFinishedRace.podium.first}</span>
                <span class="pod-step">🥈 {recentFinishedRace.podium.second}</span>
                <span class="pod-step">🥉 {recentFinishedRace.podium.third}</span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )}

  <!-- MAIN PAGE CONTENT -->
  <main class="page-container">
    
    <!-- FEATURED PILLARS / CORE HUBS -->
    <section class="section-block" aria-labelledby="core-features-title">
      <div class="section-title-row">
        <h2 id="core-features-title">Explore The Grand Prix Hub</h2>
        <p>Everything you need whether attending trackside or following the race from home.</p>
      </div>

      <div class="pillar-grid">
        <!-- 1. 2026 RACE CALENDAR -->
        <a href="/championship/calendar" class="pillar-card">
          <div class="pillar-icon">📅</div>
          <h3>2026 Race Calendar</h3>
          <p>Session timetables in your local time, session countdowns, Pirelli tyre allocations, and live track weather.</p>
          <span class="pillar-link">View 2026 Schedule &rarr;</span>
        </a>

        <!-- 2. CIRCUITS & TRACK GUIDES -->
        <a href="/circuits-live/circuit-guides" class="pillar-card">
          <div class="pillar-icon">🏎️</div>
          <h3>Circuit Guides</h3>
          <p>In-depth track layouts, overtaking hotspots, gate entry guidelines, and trackside amenities.</p>
          <span class="pillar-link">Browse All Tracks &rarr;</span>
        </a>

        <!-- 3. GRANDSTAND REVIEWS -->
        <a href="/circuits-live/grandstands" class="pillar-card">
          <div class="pillar-icon">💺</div>
          <h3>Grandstand Reviews</h3>
          <p>Community-sourced seat views, TV screen sightlines, comfort ratings, and value-for-money tips.</p>
          <span class="pillar-link">Find Best Seats &rarr;</span>
        </a>

        <!-- 4. CHAMPIONSHIP STANDINGS -->
        <a href="/championship" class="pillar-card">
          <div class="pillar-icon">🏆</div>
          <h3>2026 Standings & Teams</h3>
          <p>Drivers' and Constructors' championship points tables, 2026 driver moves, and technical specifications.</p>
          <span class="pillar-link">Check Standings &rarr;</span>
        </a>

        <!-- 5. TRAVEL & TICKETS -->
        <a href="/travel-and-tickets" class="pillar-card">
          <div class="pillar-icon">✈️</div>
          <h3>Travel & Tickets</h3>
          <p>Airport transfers, circuit shuttles, camping grounds, accommodation tips, and official ticket onsale dates.</p>
          <span class="pillar-link">Plan Your Trip &rarr;</span>
        </a>

        <!-- 6. WHERE TO WATCH & BROADCASTERS -->
        <a href="/tv-guides" class="pillar-card">
          <div class="pillar-icon">📺</div>
          <h3>Where to Watch</h3>
          <p>Worldwide TV broadcaster directories, streaming options, and weekend broadcast schedules.</p>
          <span class="pillar-link">Find Broadcasters &rarr;</span>
        </a>

        <!-- 7. PODCASTS & CREATORS -->
        <a href="/creators" class="pillar-card">
          <div class="pillar-icon">🎙️</div>
          <h3>Podcasts & Creators</h3>
          <p>Curated directory of top F1 YouTubers, technical analysis channels, and paddock podcasts.</p>
          <span class="pillar-link">Discover Creators &rarr;</span>
        </a>

        <!-- 8. LATEST NEWS & EDITORIALS -->
        <a href="/latest-news" class="pillar-card">
          <div class="card-badge-row">
            <span class="pillar-icon">📰</span>
          </div>
          <h3>Latest News & Editorials</h3>
          <p>Read expert race previews, weekend summaries, and deep-dive editorial pieces from around the paddock.</p>
          <span class="pillar-link">Read Articles &rarr;</span>
        </a>
      </div>
    </section>

    <!-- SEO KEYWORD PROSE SECTION -->
    <section class="seo-intro-block">
      <h2>Built by Fans, Designed for the Ultimate F1 Experience</h2>
      <p>
        <strong>My Grand Prix Hub</strong> is an independent spectator resource built for Formula 1 fans attending races in person or streaming from home. Whether you are searching for the best grandstand seat at Silverstone, organizing travel to Spa-Francorchamps, or checking local broadcaster listings, we provide comprehensive, unbiased advice to make every race weekend unforgettable.
      </p>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="community-banner" aria-labelledby="community-heading">
      <div class="banner-content">
        <span class="pill-red">Community Powered</span>
        <h2 id="community-heading">Been Trackside at a Grand Prix?</h2>
        <p>Help fellow motorsport fans pick the best seats! Share your photos, sightline ratings, and grandstand reviews with the global community.</p>
        <a href="/circuits-live/grandstands" class="btn primary-btn">Submit a Review ✍️</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  function setupHomepageTicker() {
    // 1. Timezone conversion
    const timeEl = document.querySelector('.js-ticker-time');
    if (timeEl) {
      const utcStr = timeEl.getAttribute('data-utc');
      if (utcStr) {
        const targetDate = new Date(utcStr);
        const formatter = new Intl.DateTimeFormat('en-US', {
          weekday: 'short', month: 'short', day: 'numeric', 
          hour: '2-digit', minute: '2-digit', hour12: true
        });
        timeEl.textContent = formatter.format(targetDate);
      }
    }

    // 2. Countdown Timer
    const countdownEl = document.querySelector('.js-ticker-countdown');
    const badgeEl = document.getElementById('ticker-badge-el');

    if (countdownEl) {
      const startStr = countdownEl.getAttribute('data-utc');
      const endStr = countdownEl.getAttribute('data-utc-end');
      if (startStr && endStr) {
        const startDate = new Date(startStr).getTime();
        const endDate = new Date(endStr).getTime();

        const elDays = countdownEl.querySelector('.js-cd-d');
        const elHours = countdownEl.querySelector('.js-cd-h');
        const elMins = countdownEl.querySelector('.js-cd-m');
        const elSecs = countdownEl.querySelector('.js-cd-s');

        function updateCountdown() {
          const now = new Date().getTime();

          if (now >= startDate && now <= endDate) {
            if (badgeEl) {
              badgeEl.className = 'ticker-badge badge-live';
              badgeEl.textContent = '● LIVE NOW';
            }
            countdownEl.innerHTML = `
              <div class="ticker-live-indicator">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <span class="ticker-live-dot"></span>
                  <span class="ticker-live-text">ON TRACK NOW</span>
                </div>
                <span class="ticker-live-sub">Live session in progress</span>
              </div>
            `;
            return;
          }

          if (now > endDate) {
            if (badgeEl) {
              badgeEl.className = 'ticker-badge badge-awaiting';
              badgeEl.textContent = '🏁 RACE COMPLETED';
            }
            countdownEl.innerHTML = `
              <div class="ticker-awaiting-indicator">
                <span>Awaiting Results...</span>
              </div>
            `;
            return;
          }

          const distance = startDate - now;
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if (elDays) elDays.textContent = String(days).padStart(2, '0');
          if (elHours) elHours.textContent = String(hours).padStart(2, '0');
          if (elMins) elMins.textContent = String(minutes).padStart(2, '0');
          if (elSecs) elSecs.textContent = String(seconds).padStart(2, '0');
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
      }
    }

    // 3. Spoiler Reveal Buttons
    const revealBtns = document.querySelectorAll('.js-btn-reveal');
    revealBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.spoiler-results-wrapper');
        if (!parent) return;
        const podium = parent.querySelector('.js-spoiler-podium');
        if (podium) {
          btn.classList.add('hidden');
          podium.classList.remove('hidden');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupHomepageTicker);
  document.addEventListener('astro:page-load', setupHomepageTicker);
</script>

<style>
  /* Container Constraints */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Hero Banner */
  .hero {
    background: linear-gradient(180deg, #1e293b 0%, #0b0f19 100%);
    border-bottom: 1px solid #334155;
    padding: 5rem 1.5rem;
    text-align: center;
    width: 100%;
  }

  .hero-container {
    max-width: 850px;
    margin: 0 auto;
  }

  .f1-badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .hero h1 {
    font-size: 3rem;
    line-height: 1.15;
    margin: 1.25rem 0 1rem 0;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .hero p {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .primary-btn {
    background-color: #e10600;
    color: #ffffff;
  }

  .primary-btn:hover {
    background-color: #b80500;
  }

  .secondary-btn {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
  }

  .secondary-btn:hover {
    background-color: #334155;
  }

  /* ========================================= */
  /* TICKER STYLING                            */
  /* ========================================= */
  .session-ticker-wrapper {
    background: linear-gradient(90deg, #0b0f19 0%, #1e293b 50%, #0b0f19 100%);
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    margin-bottom: 3.5rem;
  }

  .session-ticker {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .ticker-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ticker-badge {
    display: inline-flex;
    align-items: center;
    background-color: #facc15;
    color: #000000;
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    box-shadow: 0 0 12px rgba(250, 204, 21, 0.3);
  }

  .badge-live {
    background-color: #e10600 !important;
    color: #ffffff !important;
    box-shadow: 0 0 15px rgba(225, 6, 0, 0.5) !important;
    animation: livePulse 1.5s infinite;
  }

  .badge-awaiting {
    background-color: #334155 !important;
    color: #e2e8f0 !important;
    box-shadow: none !important;
  }

  @keyframes livePulse {
    0% { transform: scale(0.98); opacity: 1; }
    50% { transform: scale(1.02); opacity: 0.85; }
    100% { transform: scale(0.98); opacity: 1; }
  }

  .ticker-race {
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ticker-race .divider {
