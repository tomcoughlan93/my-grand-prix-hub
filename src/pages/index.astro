---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import tinaResults from '@/content/results/current.json';
import Parser from 'rss-parser';

const circuits = (await getCollection('circuits')) || [];

// Structured Data for Google Rich Snippets
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mygrandprixhub.com/#website",
      "url": "https://mygrandprixhub.com/",
      "name": "My Grand Prix Hub",
      "description": "Your ultimate Formula 1 fan companion for the 2026 season: 2026 race calendar, grandstand reviews, travel logistics, and track guides.",
      "inLanguage": "en-GB"
    },
    {
      "@type": "SportsOrganization",
      "name": "Formula 1 Hub Fan Community",
      "url": "https://mygrandprixhub.com/",
      "sport": "Formula 1"
    }
  ]
};

// Condensed 2026 Calendar
const TICKER_RACES = [
  { id: "dutch-gp", raceName: "Dutch Grand Prix", isSprint: true, sessions: { fp1: "2026-08-21T12:30:00+02:00", fp2: "2026-08-21T16:00:00+02:00", fp3: "2026-08-22T11:30:00+02:00", quali: "2026-08-22T16:00:00+02:00", race: "2026-08-23T15:00:00+02:00" } },
  { id: "italian-gp", raceName: "Italian Grand Prix", isSprint: false, sessions: { fp1: "2026-09-04T13:30:00+02:00", fp2: "2026-09-04T17:00:00+02:00", fp3: "2026-09-05T12:30:00+02:00", quali: "2026-09-05T16:00:00+02:00", race: "2026-09-06T15:00:00+02:00" } },
  { id: "madrid-gp", raceName: "Madrid Grand Prix", isSprint: false, sessions: { fp1: "2026-09-11T13:30:00+02:00", fp2: "2026-09-11T17:00:00+02:00", fp3: "2026-09-12T12:30:00+02:00", quali: "2026-09-12T16:00:00+02:00", race: "2026-09-13T15:00:00+02:00" } },
  { id: "azerbaijan-gp", raceName: "Azerbaijan Grand Prix", isSprint: false, sessions: { fp1: "2026-09-24T13:30:00+04:00", fp2: "2026-09-24T17:00:00+04:00", fp3: "2026-09-25T12:30:00+04:00", quali: "2026-09-25T16:00:00+04:00", race: "2026-09-26T15:00:00+04:00" } },
  { id: "singapore-gp", raceName: "Singapore Grand Prix", isSprint: true, sessions: { fp1: "2026-10-09T17:30:00+08:00", fp2: "2026-10-09T21:30:00+08:00", fp3: "2026-10-10T17:30:00+08:00", quali: "2026-10-10T21:00:00+08:00", race: "2026-10-11T20:00:00+08:00" } }
];

const now = new Date();
let nextSession: any = null;
let recentFinishedRace: any = null;

function getMondayCutoff(raceDate: Date) {
  const d = new Date(raceDate);
  d.setDate(d.getDate() + (1 + 7 - d.getDay()) % 7 || 1);
  d.setHours(0, 0, 0, 0);
  return d;
}

const currentRaceObj = TICKER_RACES[0];
const currentRaceStartTime = new Date(currentRaceObj.sessions.race);
const currentMondayCutoff = getMondayCutoff(currentRaceStartTime);
const hasRaceResults = Boolean(tinaResults?.race?.first);

if (now >= currentRaceStartTime) {
  recentFinishedRace = { raceName: currentRaceObj.raceName, podium: tinaResults?.race, hasResults: hasRaceResults };
}

for (const race of TICKER_RACES) {
  const raceStartTime = new Date(race.sessions.race);
  const mondayCutoff = getMondayCutoff(raceStartTime);

  const sessions = [
    { id: 'FP1', name: 'Practice 1', time: new Date(race.sessions.fp1), durationHours: 1 },
    { id: 'FP2', name: race.isSprint ? 'Sprint Quali' : 'Practice 2', time: new Date(race.sessions.fp2), durationHours: 1 },
    { id: 'FP3', name: race.isSprint ? 'Sprint Race' : 'Practice 3', time: new Date(race.sessions.fp3), durationHours: 1 },
    { id: 'QUALI', name: 'Qualifying', time: new Date(race.sessions.quali), durationHours: 1 },
    { id: 'RACE', name: 'Race', time: raceStartTime, durationHours: 2 }
  ];

  if (now < mondayCutoff) {
    for (const session of sessions) {
      const sessionStart = session.time.getTime();
      const sessionEnd = sessionStart + (session.durationHours * 60 * 60 * 1000);

      if (now.getTime() < sessionStart) {
        nextSession = { race: race.raceName, name: session.name, utcTime: session.time.toISOString(), utcEndTime: new Date(sessionEnd).toISOString(), state: 'UPCOMING' };
        break;
      } else if (now.getTime() >= sessionStart && now.getTime() <= sessionEnd) {
        nextSession = { race: race.raceName, name: session.name, utcTime: session.time.toISOString(), utcEndTime: new Date(sessionEnd).toISOString(), state: 'LIVE' };
        break;
      }
    }
    if (!nextSession && now.getTime() > raceStartTime.getTime()) {
      nextSession = { race: race.raceName, name: 'Grand Prix Race', utcTime: raceStartTime.toISOString(), utcEndTime: new Date(raceStartTime.getTime() + (2 * 60 * 60 * 1000)).toISOString(), state: hasRaceResults ? 'SHOW_RESULTS' : 'AWAITING_RESULTS', podium: tinaResults?.race };
    }
  }
  if (nextSession) break;
}

// --- NEW 1: FETCH TOP 3 STANDINGS ---
let topDrivers: any[] = [];
let topConstructors: any[] = [];

try {
  const [driverRes, constrRes] = await Promise.all([
    fetch('https://api.jolpi.ca/ergast/f1/current/driverStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
    fetch('https://api.jolpi.ca/ergast/f1/current/constructorStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } })
  ]);
  if (driverRes.ok) {
    const dData = await driverRes.json();
    topDrivers = dData?.MRData?.StandingsTable?.StandingsLists?.[0]?.DriverStandings?.slice(0, 3) || [];
  }
  if (constrRes.ok) {
    const cData = await constrRes.json();
    topConstructors = cData?.MRData?.StandingsTable?.StandingsLists?.[0]?.ConstructorStandings?.slice(0, 3) || [];
  }
} catch (e) {
  // Silent fallback
}

// --- NEW 2: RSS PARSER FOR LATEST 3 ARTICLES ---
interface CustomFeedItem { mediaContent?: any; mediaThumbnail?: any; enclosure?: { url?: string }; contentEncoded?: string; description?: string; content?: string; summary?: string; contentSnippet?: string; title?: string; link?: string; pubDate?: string; image?: any; }
const parser: Parser<{}, CustomFeedItem> = new Parser({ customFields: { item: [['media:content', 'mediaContent', { keepArray: true }], ['media:thumbnail', 'mediaThumbnail', { keepArray: true }], ['media:group', 'mediaGroup', { keepArray: true }], ['content:encoded', 'contentEncoded'], ['description', 'description'], ['image', 'image']] } });
const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' },
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;
  if (item.enclosure && item.enclosure.url) url = item.enclosure.url;
  if (!url && item.mediaContent && Array.isArray(item.mediaContent)) { const found = item.mediaContent.find((m: any) => m.$?.url || m.url); if (found) url = found.$?.url || found.url; }
  if (!url && item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) { const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url); if (found) url = found.$?.url || found.url; }
  if (!url && (item as any).mediaGroup && Array.isArray((item as any).mediaGroup)) { const group = (item as any).mediaGroup[0]; if (group && group['media:content'] && Array.isArray(group['media:content'])) { const found = group['media:content'].find((m: any) => m.$?.url || m.url); if (found) url = found.$?.url || found.url; } }
  if (!url && item.image) { if (typeof item.image === 'string') url = item.image; else if (item.image.url) url = item.image.url; else if (item.image.$ && item.image.$.url) url = item.image.$.url; }
  if (!url) { const htmlString = [item.contentEncoded, item.content, item.summary, item.description, item.contentSnippet].filter(Boolean).join(' '); const dataSrcMatch = htmlString.match(/<img[^>]+data-src\s*=\s*["']([^"']+)["']/i); if (dataSrcMatch && dataSrcMatch[1]) url = dataSrcMatch[1]; else { const srcMatch = htmlString.match(/<img[^>]+src\s*=\s*["']([^"']+)["']/i); if (srcMatch && srcMatch[1]) url = srcMatch[1]; } }
  if (!url) { const itemStr = JSON.stringify(item); const regex = /(https?:\/\/[^"'\s>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\s>]*)?)/i; const match = itemStr.match(regex); if (match && match[1]) url = match[1]; }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  return url;
}

let latestNews: any[] = [];
try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems = [];
      for (const item of feed.items || []) {
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!hasValidDate) continue;
        const imageUrl = extractImage(item, src.name);
        if (src.name === 'RacingNews365' && !imageUrl) continue;
        if (!imageUrl) continue;
        
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDateStr: new Date(item.pubDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase(),
          source: src.name,
          snippet: cleanSnippet(item.contentEncoded || item.content || item.summary || item.description || item.contentSnippet),
          imageUrl,
          timestamp: new Date(item.pubDate!).getTime(),
        });
        if (validItems.length >= 3) break;
      }
      return validItems;
    } catch (err) { return []; }
  });
  const results = await Promise.all(feedPromises);
  latestNews = results.flat().sort((a, b) => b.timestamp - a.timestamp).slice(0, 3);
} catch (e) {}
---

<Layout 
  title="My Grand Prix Hub | F1 2026 Calendar & Fan Guide"
  description="Your complete Formula 1 fan companion for 2026. Explore track guides, grandstand reviews, race calendar countdowns, and travel tips."
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-container">
      <span class="f1-badge">2026 Formula 1 Fan & Travel Guide</span>
      <h1>Plan Your Ultimate Grand Prix Weekend</h1>
      <p>
        Unbiased grandstand reviews, trackside city guides, and 2026 championship calendar countdowns for Formula 1 fans worldwide.
      </p>
      
      <div class="hero-actions">
        <a href="/championship/calendar" class="btn primary-btn">
          <span>2026 Race Calendar</span> 📅
        </a>
        <a href="/circuits-live/grandstands" class="btn secondary-btn">
          Grandstand Reviews 💺
        </a>
        <a href="/tv-guides" class="btn secondary-btn">
          Where to Watch 📺
        </a>
      </div>
    </div>
  </section>

  <!-- NEXT SESSION TICKER -->
  {nextSession && (
    <div class="session-ticker-wrapper">
      <div class="session-ticker">
        <div class="ticker-left">
          <span 
            class={`ticker-badge ${nextSession.state === 'LIVE' ? 'badge-live' : nextSession.state === 'SHOW_RESULTS' || nextSession.state === 'AWAITING_RESULTS' ? 'badge-awaiting' : ''}`} 
            id="ticker-badge-el"
          >
            {nextSession.state === 'LIVE' ? '● LIVE NOW' : nextSession.state === 'SHOW_RESULTS' || nextSession.state === 'AWAITING_RESULTS' ? '🏁 RACE COMPLETED' : 'NEXT SESSION'}
          </span>
          <span class="ticker-race">{nextSession.race} <span class="divider">|</span> {nextSession.name}</span>
        </div>

        <div class="ticker-right">
          {nextSession.state === 'SHOW_RESULTS' ? (
            <div class="spoiler-results-wrapper">
              <button type="button" class="btn-reveal js-btn-reveal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Reveal Results</span>
              </button>
              <div class="spoiler-podium js-spoiler-podium hidden">
                <span class="pod-step pod-1">🥇 <span class="pod-name">{nextSession.podium.first}</span></span>
                <span class="pod-step pod-2">🥈 <span class="pod-name">{nextSession.podium.second}</span></span>
                <span class="pod-step pod-3">🥉 <span class="pod-name">{nextSession.podium.third}</span></span>
              </div>
            </div>
          ) : nextSession.state === 'AWAITING_RESULTS' ? (
            <div class="ticker-awaiting-indicator">
              <span>Awaiting Official Results...</span>
            </div>
          ) : (
            <>
              <!-- The Countdown Timer -->
              <div class="ticker-countdown js-ticker-countdown" data-utc={nextSession.utcTime} data-utc-end={nextSession.utcEndTime} data-state={nextSession.state}>
                <span class="cd-section"><span class="cd-val js-cd-d">00</span><span class="cd-lbl">D</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-h">00</span><span class="cd-lbl">H</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-m">00</span><span class="cd-lbl">M</span></span>
                <span class="cd-sep">:</span>
                <span class="cd-section"><span class="cd-val js-cd-s">00</span><span class="cd-lbl">S</span></span>
              </div>

              <!-- Local Time -->
              <div class="ticker-local">
                <span class="ticker-label">Local Time:</span>
                <span class="ticker-time js-ticker-time" data-utc={nextSession.utcTime}>Loading...</span>
              </div>
            </>
          )}
        </div>
      </div>

      <!-- MONDAY ONWARDS RECENT RESULTS SPOILER SUB-BANNER -->
      {now >= currentMondayCutoff && recentFinishedRace?.hasResults && (
        <div class="sub-recent-banner">
          <div class="sub-recent-inner">
            <div class="sub-left">
              <span class="sub-badge">LATEST GP</span>
              <span class="sub-text"><strong>{recentFinishedRace.raceName}</strong> Podium</span>
            </div>
            <div class="spoiler-results-wrapper">
              <button type="button" class="btn-reveal js-btn-reveal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Reveal Results</span>
              </button>
              <div class="spoiler-podium js-spoiler-podium hidden">
                <span class="pod-step pod-1">🥇 <span class="pod-name">{recentFinishedRace.podium.first}</span></span>
                <span class="pod-step pod-2">🥈 <span class="pod-name">{recentFinishedRace.podium.second}</span></span>
                <span class="pod-step pod-3">🥉 <span class="pod-name">{recentFinishedRace.podium.third}</span></span>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )}

  <main class="page-container">
    
    <!-- NEW: CHAMPIONSHIP SNAPSHOT -->
    {topDrivers.length > 0 && topConstructors.length > 0 && (
      <section class="section-block snapshot-section">
        <div class="section-title-row">
          <h2>2026 Championship Leaders</h2>
          <a href="/championship" class="view-all-link">Full Standings &rarr;</a>
        </div>
        
        <div class="snapshot-grid">
          <!-- Drivers Standings -->
          <div class="standings-list-wrap">
            <h3 class="list-title">Drivers</h3>
            <div class="standings-list">
              {topDrivers.map((d: any) => (
                <div class="standing-row">
                  <div class="name-col">
                    <span class="pos-badge">P{d.position}</span>
                    <span class="d-code">{d.Driver.code}</span>
                    <span class="d-name">{d.Driver.familyName}</span>
                  </div>
                  <span class="pts-col">{d.points} <span class="pts-lbl">PTS</span></span>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Constructors Standings -->
          <div class="standings-list-wrap">
            <h3 class="list-title">Constructors</h3>
            <div class="standings-list">
              {topConstructors.map((c: any) => (
                <div class="standing-row">
                  <div class="name-col">
                    <span class="pos-badge">P{c.position}</span>
                    <span class="d-name">{c.Constructor.name}</span>
                  </div>
                  <span class="pts-col">{c.points} <span class="pts-lbl">PTS</span></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- FEATURED PILLARS / CORE HUBS -->
    <section class="section-block">
      <div class="section-title-row">
        <div class="title-stack">
          <h2>Explore The Hub</h2>
          <p>Everything you need whether attending trackside or following the race from home.</p>
        </div>
      </div>

      <div class="pillar-grid">
        <a href="/championship/calendar" class="pillar-card">
          <div class="pillar-icon">📅</div>
          <h3>2026 Race Calendar</h3>
          <p>Session timetables in your local time, session countdowns, Pirelli tyre allocations, and live track weather.</p>
          <span class="pillar-link">View 2026 Schedule &rarr;</span>
        </a>

        <a href="/circuits-live/circuit-guides" class="pillar-card">
          <div class="pillar-icon">🏎️</div>
          <h3>Circuit Guides</h3>
          <p>In-depth track layouts, overtaking hotspots, gate entry guidelines, and trackside amenities.</p>
          <span class="pillar-link">Browse All Tracks &rarr;</span>
        </a>

        <a href="/circuits-live/grandstands" class="pillar-card highlight-card">
          <div class="pillar-icon">💺</div>
          <h3>Grandstand Reviews</h3>
          <p>Community-sourced seat views, TV screen sightlines, comfort ratings, and value-for-money tips.</p>
          <span class="pillar-link">Find Best Seats &rarr;</span>
        </a>

        <a href="/travel-and-tickets" class="pillar-card">
          <div class="pillar-icon">✈️</div>
          <h3>Travel & Tickets</h3>
          <p>Airport transfers, circuit shuttles, camping grounds, accommodation tips, and official ticket onsale dates.</p>
          <span class="pillar-link">Plan Your Trip &rarr;</span>
        </a>

        <a href="/championship" class="pillar-card">
          <div class="pillar-icon">🏆</div>
          <h3>Standings & Teams</h3>
          <p>Drivers' and Constructors' championship points tables, driver moves, and team technical specifications.</p>
          <span class="pillar-link">Check Profiles &rarr;</span>
        </a>

        <a href="/tv-guides" class="pillar-card">
          <div class="pillar-icon">📺</div>
          <h3>Where to Watch</h3>
          <p>Worldwide TV broadcaster directories, streaming options, and weekend broadcast schedules.</p>
          <span class="pillar-link">Find Broadcasters &rarr;</span>
        </a>
      </div>
    </section>

    <!-- NEW: LATEST NEWS PREVIEW -->
    {latestNews && latestNews.length > 0 && (
      <section class="section-block">
        <div class="section-title-row">
          <h2>Latest Paddock News</h2>
          <a href="/latest-news" class="view-all-link">View All News &rarr;</a>
        </div>
        
        <div class="news-grid">
          {latestNews.map((article: any) => (
            <a href={article.link} target="_blank" rel="noopener noreferrer" class="news-card">
              {article.imageUrl && (
                <div class="card-image-wrap">
                  <img src={article.imageUrl} alt={article.title} loading="lazy" class="card-image" />
                </div>
              )}
              <div class="news-content">
                <div class="news-meta">
                  <span class="feed-source">{article.source}</span>
                  <span class="news-date">{article.pubDateStr}</span>
                </div>
                <h3 class="news-title">{article.title}</h3>
                {article.snippet && <p class="news-excerpt">{article.snippet}</p>}
                <span class="read-more">Read on {article.source} ↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- SEO KEYWORD PROSE SECTION -->
    <section class="seo-intro-block">
      <h2>Built by Fans, Designed for the Ultimate F1 Experience</h2>
      <p>
        <strong>My Grand Prix Hub</strong> is an independent spectator resource built for Formula 1 fans attending races in person or streaming from home. Whether you are searching for the best grandstand seat at Silverstone, organizing travel to Spa-Francorchamps, or checking local broadcaster listings, we provide comprehensive, unbiased advice to make every race weekend unforgettable.
      </p>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="community-banner">
      <div class="banner-content">
        <span class="pill-red">Community Powered</span>
        <h2>Been Trackside at a Grand Prix?</h2>
        <p>Help fellow motorsport fans pick the best seats! Share your photos, sightline ratings, and grandstand reviews with the global community.</p>
        <a href="/circuits-live/grandstands" class="btn primary-btn">Submit a Review ✍️</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  function setupHomepageTicker() {
    const timeEl = document.querySelector('.js-ticker-time');
    if (timeEl) {
      const utcStr = timeEl.getAttribute('data-utc');
      if (utcStr) {
        const targetDate = new Date(utcStr);
        const formatter = new Intl.DateTimeFormat('en-US', {
          weekday: 'short', month: 'short', day: 'numeric', 
          hour: '2-digit', minute: '2-digit', hour12: true
        });
        timeEl.textContent = formatter.format(targetDate);
      }
    }

    const countdownEl = document.querySelector('.js-ticker-countdown');
    const badgeEl = document.getElementById('ticker-badge-el');

    if (countdownEl) {
      const startStr = countdownEl.getAttribute('data-utc');
      const endStr = countdownEl.getAttribute('data-utc-end');
      if (startStr && endStr) {
        const startDate = new Date(startStr).getTime();
        const endDate = new Date(endStr).getTime();

        const elDays = countdownEl.querySelector('.js-cd-d');
        const elHours = countdownEl.querySelector('.js-cd-h');
        const elMins = countdownEl.querySelector('.js-cd-m');
        const elSecs = countdownEl.querySelector('.js-cd-s');

        function updateCountdown() {
          const now = new Date().getTime();

          if (now >= startDate && now <= endDate) {
            if (badgeEl) { badgeEl.className = 'ticker-badge badge-live'; badgeEl.textContent = '● LIVE NOW'; }
            countdownEl.innerHTML = `
              <div class="ticker-live-indicator">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <span class="ticker-live-dot"></span>
                  <span class="ticker-live-text">ON TRACK NOW</span>
                </div>
                <span class="ticker-live-sub">Live session in progress</span>
              </div>
            `;
            return;
          }

          if (now > endDate) {
            if (badgeEl) { badgeEl.className = 'ticker-badge badge-awaiting'; badgeEl.textContent = '🏁 RACE COMPLETED'; }
            countdownEl.innerHTML = `<div class="ticker-awaiting-indicator"><span>Awaiting Results...</span></div>`;
            return;
          }

          const distance = startDate - now;
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if (elDays) elDays.textContent = String(days).padStart(2, '0');
          if (elHours) elHours.textContent = String(hours).padStart(2, '0');
          if (elMins) elMins.textContent = String(minutes).padStart(2, '0');
          if (elSecs) elSecs.textContent = String(seconds).padStart(2, '0');
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
      }
    }

    const revealBtns = document.querySelectorAll('.js-btn-reveal');
    revealBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.spoiler-results-wrapper');
        if (!parent) return;
        const podium = parent.querySelector('.js-spoiler-podium');
        if (podium) {
          btn.classList.add('hidden');
          podium.classList.remove('hidden');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupHomepageTicker);
  document.addEventListener('astro:page-load', setupHomepageTicker);
</script>

