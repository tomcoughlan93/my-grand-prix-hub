---
// src/pages/news/[slug].astro
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('news');
  return articles.map((entry: any) => ({
    // NEW: Fall back to entry.id if entry.slug is undefined
    params: { slug: entry.slug || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Automatically calculate estimated reading time based on word count
const wordCount = entry.body.split(/\s+/g).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = new Date(entry.data.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

// Fetch up to 3 related articles for the bottom of the page
const allArticles = await getCollection('news');
const relatedArticles = allArticles
  // NEW: Safely check against ID or Slug
  .filter((a: any) => (a.slug || a.id) !== (entry.slug || entry.id))
  .sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 3);

// --- SEO STRUCTURED DATA ---
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.date,
  "author": {
    "@type": "Organization",
    "name": "My Grand Prix Hub"
  },
  "publisher": {
    "@type": "Organization",
    "name": "My Grand Prix Hub",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mygrandprixhub.com/logo.png"
    }
  }
};
---

<Layout 
  title={`${entry.data.title} | The Racing Line | My Grand Prix Hub`}
  description={entry.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="page-container article-page">
    
    <!-- BACK NAVIGATION -->
    <a href="/latest-news/the-racing-line" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to The Racing Line
    </a>

    <!-- ARTICLE HEADER -->
    <header class="article-header">
      <span class="badge">Hub Exclusive</span>
      <h1 class="gradient-title">{entry.data.title}</h1>
      
      {entry.data.description && (
        <p class="article-lead">{entry.data.description}</p>
      )}

      <div class="article-meta">
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>{formattedDate}</span>
        </div>
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{readingTime} Min Read</span>
        </div>
        <div class="meta-item author-item">
          <span class="author-avatar">H</span>
          <span>By My Grand Prix Hub</span>
        </div>
      </div>
    </header>

    <!-- HERO IMAGE PLACEHOLDER (Blueprint Aesthetic) -->
    <div class="article-hero-image">
      <div class="grid-overlay"></div>
      <svg class="hero-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="1.5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
    </div>

    <!-- MARKDOWN CONTENT RENDERING -->
    <article class="prose-container">
      <div class="prose">
        <Content />
      </div>
    </article>

    <!-- SOCIAL SHARE / FOOTER -->
    <div class="article-footer">
      <div class="author-bio">
        <div class="bio-avatar">H</div>
        <div class="bio-text">
          <strong>My Grand Prix Hub</strong>
          <p>Your ultimate trackside companion for the 2026 Formula 1 Season. Bringing you data-driven guides and paddock insights.</p>
        </div>
      </div>
      
      <div class="share-actions">
        <span>Share this guide:</span>
        <button class="btn-share" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Copy Link
        </button>
      </div>
    </div>

    <!-- RELATED ARTICLES -->
    {relatedArticles.length > 0 && (
      <section class="related-section">
        <h3>Keep Reading</h3>
        <div class="related-grid">
          {relatedArticles.map((rel: any) => (
            <a href={`/news/${rel.slug || rel.id}`} class="related-card">
              <span class="rel-date">{new Date(rel.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <h4>{rel.data.title}</h4>
              <span class="read-btn">Read Article &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>

<style>
  .page-container {
    max-width: 860px; /* Narrower width for optimal reading line length */
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 3rem;
    transition: color 0.2s ease;
  }
  
  .back-link:hover { color: #38bdf8; }

  /* Header */
  .article-header {
    margin-bottom: 2.5rem;
  }

  .badge {
    display: inline-block;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .gradient-title { 
    font-size: 3.25rem; 
    margin: 0 0 1.25rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.15; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .article-lead {
    color: #cbd5e1;
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    font-weight: 400;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid #1e293b;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .author-item {
    padding-left: 1.5rem;
    border-left: 1px solid #1e293b;
    color: #f1f5f9;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    background: #e10600;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 900;
  }

  /* Hero Image / Placeholder */
  .article-hero-image {
    width: 100%;
    aspect-ratio: 21 / 9;
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    margin-bottom: 3.5rem;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(56, 189, 248, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56, 189, 248, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: 1;
  }

  .hero-icon {
    position: relative;
    z-index: 2;
    opacity: 0.5;
  }

  /* --- STYLED MARKDOWN PROSE --- */
  .prose-container {
    margin-bottom: 4rem;
  }

  /* Paragraphs */
  .prose :global(p) {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.75;
    margin-top: 0;
    margin-bottom: 1.75rem;
  }

  /* Headings */
  .prose :global(h2) {
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    color: #f1f5f9;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  /* Links */
  .prose :global(a) {
    color: #38bdf8;
    text-decoration: none;
    border-bottom: 1px solid rgba(56, 189, 248, 0.4);
    transition: all 0.2s;
  }
  .prose :global(a:hover) {
    color: #7dd3fc;
    border-bottom-color: #7dd3fc;
  }

  /* Lists */
  .prose :global(ul), .prose :global(ol) {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.75;
    margin-top: 0;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(li::marker) {
    color: #64748b;
  }

  /* Blockquotes */
  .prose :global(blockquote) {
    border-left: 4px solid #e10600;
    background: rgba(225, 6, 0, 0.05);
    padding: 1.25rem 1.5rem;
    margin: 2.5rem 0;
    border-radius: 0 8px 8px 0;
  }
  .prose :global(blockquote p) {
    color: #f1f5f9;
    font-size: 1.25rem;
    font-style: italic;
    margin: 0;
  }

  /* Bold & Strong */
  .prose :global(strong), .prose :global(b) {
    color: #ffffff;
    font-weight: 700;
  }

  /* Inline Code */
  .prose :global(code) {
    background: #1e293b;
    color: #38bdf8;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: monospace;
  }

  /* Images inside markdown */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2.5rem 0;
    border: 1px solid #1e293b;
  }

  /* Footer & Author */
  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.5rem;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    margin-bottom: 5rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .author-bio {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 500px;
  }

  .bio-avatar {
    width: 56px;
    height: 56px;
    background: #e10600;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .bio-text strong {
    display: block;
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .bio-text p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.5;
  }

  .share-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .share-actions span {
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .btn-share {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-share:hover {
    background: #1e293b;
    color: #ffffff;
    border-color: #475569;
  }

  /* Related Articles */
  .related-section {
    border-top: 1px solid #1e293b;
    padding-top: 4rem;
  }

  .related-section h3 {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 2rem 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
  }

  .rel-date {
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .related-card h4 {
    color: #f8fafc;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.4;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .read-btn {
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive Constraints */
  @media (max-width: 768px) {
    .gradient-title { font-size: 2.4rem; }
    .article-lead { font-size: 1.1rem; }
    
    .article-meta { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .author-item { padding-left: 0; border-left: none; }
    
    .prose :global(p), .prose :global(ul) { font-size: 1.05rem; }
    .prose :global(h2) { font-size: 1.6rem; }
    
    .article-footer { padding: 1.5rem; flex-direction: column; align-items: flex-start; }
    .share-actions { width: 100%; }
    .btn-share { width: 100%; justify-content: center; }
  }
</style>