---
import Layout from '@/layouts/Layout.astro';
import Parser from 'rss-parser';
import { getCollection } from 'astro:content';

// --- 1. FETCH INTERNAL EXCLUSIVES (With Safe Fallback) ---
let sortedHubNews: any[] = [];
try {
  const allHubNews = await getCollection('news');
  if (allHubNews) {
    sortedHubNews = allHubNews.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
  }
} catch (e) {
  console.warn('Notice: Could not load internal news collection.');
}

// --- 2. RSS PARSER SETUP (Upgraded Version) ---
interface CustomFeedItem {
  mediaContent?: any;
  mediaThumbnail?: any;
  enclosure?: { url?: string };
  contentEncoded?: string;
  description?: string;
  content?: string;
  summary?: string;
  contentSnippet?: string;
  title?: string;
  link?: string;
  pubDate?: string;
  image?: any;
}

const parser: Parser<{}, CustomFeedItem> = new Parser({
  customFields: {
    item: [
      ['media:content', 'mediaContent', { keepArray: true }],
      ['media:thumbnail', 'mediaThumbnail', { keepArray: true }],
      ['media:group', 'mediaGroup', { keepArray: true }],
      ['content:encoded', 'contentEncoded'],
      ['description', 'description'],
      ['image', 'image']
    ],
  },
});

const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' },
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

interface NewsItem {
  title: string;
  link: string;
  pubDate: string;
  source: string;
  snippet: string;
  imageUrl?: string;
  dateObj: Date;
}

function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;

  if (item.enclosure && item.enclosure.url) url = item.enclosure.url;

  if (!url && item.mediaContent && Array.isArray(item.mediaContent)) {
    const found = item.mediaContent.find((m: any) => m.$?.url || m.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) {
    const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && (item as any).mediaGroup && Array.isArray((item as any).mediaGroup)) {
    const group = (item as any).mediaGroup[0];
    if (group && group['media:content'] && Array.isArray(group['media:content'])) {
      const found = group['media:content'].find((m: any) => m.$?.url || m.url);
      if (found) url = found.$?.url || found.url;
    }
  }
  if (!url && item.image) {
    if (typeof item.image === 'string') url = item.image;
    else if (item.image.url) url = item.image.url;
    else if (item.image.$ && item.image.$.url) url = item.image.$.url;
  }
  if (!url) {
    const htmlString = [item.contentEncoded, item.content, item.summary, item.description, item.contentSnippet].filter(Boolean).join(' ');
    const dataSrcMatch = htmlString.match(/<img[^>]+data-src\s*=\s*["']([^"']+)["']/i);
    if (dataSrcMatch && dataSrcMatch[1]) url = dataSrcMatch[1];
    else {
      const srcMatch = htmlString.match(/<img[^>]+src\s*=\s*["']([^"']+)["']/i);
      if (srcMatch && srcMatch[1]) url = srcMatch[1];
    }
  }
  if (!url) {
    const itemStr = JSON.stringify(item);
    const regex = /(https?:\/\/[^"'\s>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\s>]*)?)/i;
    const match = itemStr.match(regex);
    if (match && match[1]) url = match[1];
  }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') {
    url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  }
  return url;
}

// --- 3. FETCH AND SORT EXTERNAL RSS FEEDS ---
let articles: NewsItem[] = [];

try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems: NewsItem[] = [];
      
      for (const item of feed.items || []) {
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!hasValidDate) continue;

        const imageUrl = extractImage(item, src.name);
        
        // Skip RN365 articles if the image parser failed to find one
        if (src.name === 'RacingNews365' && !imageUrl) continue;
        if (!imageUrl) continue; // Require images for all layout cards
        
        const dateObj = new Date(item.pubDate!);
        
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDate: dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase(),
          source: src.name,
          snippet: cleanSnippet(item.contentEncoded || item.content || item.summary || item.description || item.contentSnippet),
          imageUrl,
          dateObj,
        });
        
        if (validItems.length >= 8) break; // Grab slightly more from each feed
      }
      return validItems;
    } catch (err) {
      console.warn(`[RSS Notice] Could not fetch ${src.name}:`, err);
      return [];
    }
  });
  const results = await Promise.all(feedPromises);
  articles = results.flat().sort((a, b) => b.dateObj.getTime() - a.dateObj.getTime());
} catch (e) {
  console.error('Error loading news feeds:', e);
}
---

<Layout title="Latest F1 News & Headlines | My Grand Prix Hub">
  <main class="page-container">
    
    <header class="section-header">
      <span class="badge">Latest News</span>
      <h1>Latest F1 News</h1>
      <p>The latest headlines, paddock updates, and technical analysis.</p>
    </header>

    <!-- SECTION 1: EXCLUSIVES (INTERNAL CONTENT) -->
    {sortedHubNews.length > 0 && (
      <section class="exclusive-section">
        <div class="section-title-row">
          <h2>From The Hub Desk</h2>
          <span class="section-badge">Exclusives</span>
        </div>
        <div class="exclusive-grid">
          {sortedHubNews.map((article) => (
            <a href={`/news/${article.id}`} class="exclusive-card">
              <div class="card-content">
                <span class="exclusive-badge">★ Hub Feature</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description || 'In-depth preview and analysis from the My Grand Prix Hub team.'}</p>
                <span class="read-more">Read Full Article →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- SECTION 2: EXTERNAL RSS FEED -->
    <section class="rss-section">
      <div class="section-title-row">
        <h2>Around The Paddock</h2>
        <span class="section-badge">Global Feed</span>
      </div>
      
      {articles.length === 0 ? (
        <div class="news-empty-state">
          <p>Currently scouting the paddock for the latest updates. Check back soon!</p>
        </div>
      ) : (
        <div class="news-grid">
          {articles.map((item) => (
            <a href={item.link} target="_blank" rel="noopener noreferrer" class="news-card">
              <div class="card-image-wrap">
                <img src={item.imageUrl} alt={item.title} loading="lazy" class="card-image" />
              </div>
              <div class="news-content">
                <div class="news-meta">
                  <span class="feed-source">{item.source}</span>
                  <span class="news-date">{item.pubDate}</span>
                </div>
                <h3 class="news-title">{item.title}</h3>
                {item.snippet && <p class="news-excerpt">{item.snippet}</p>}
                <span class="read-more">Read on {item.source} ↗</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

  </main>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    color: #f1f5f9;
    box-sizing: border-box;
  }

  /* Header Styles */
  .section-header {
    margin-bottom: 3.5rem;
  }
  
  .badge {
    background: #e10600;
    color: white;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  h1 {
    font-size: 3.25rem;
    color: #ffffff;
    margin: 1rem 0 0.5rem 0;
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  
  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    max-width: 600px;
    line-height: 1.5;
  }
  
  /* Shared Section Titles */
  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.75rem;
  }

  .section-title-row h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .section-badge {
    background: #0f172a;
    color: #38bdf8;
    border: 1px solid #334155;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  /* Exclusive Internal Section */
  .exclusive-section {
    margin-bottom: 4rem;
  }
  
  .exclusive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .exclusive-card {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    border: 1px solid #475569;
    border-radius: 12px;
    text-decoration: none;
    display: flex;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    min-height: 200px;
  }
  
  .exclusive-card:hover {
    transform: translateY(-4px);
    border-color: #e10600;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }
  
  .card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  
  .exclusive-badge {
    color: #e10600;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }
  
  .exclusive-card h3 {
    color: #ffffff;
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    line-height: 1.3;
    font-weight: 900;
  }
  
  .exclusive-card p {
    color: #cbd5e1;
    font-size: 1rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    line-height: 1.6;
  }
  
  /* Unified RSS News Grid */
  .rss-section {
    margin-bottom: 4rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .news-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .news-card:hover {
    transform: translateY(-4px);
    border-color: #475569;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }

  .card-image-wrap {
    height: 180px;
    overflow: hidden;
    background: #0b0f19;
    border-bottom: 1px solid #1e293b;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .news-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .feed-source {
    color: #38bdf8;
  }

  .news-date {
    color: #64748b;
  }

  .news-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .news-excerpt {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .read-more {
    font-size: 0.8rem;
    font-weight: 700;
    color: #e10600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
    margin-top: auto;
  }

  .news-card:hover .read-more {
    color: #f87171;
  }

  .news-empty-state {
    background: #0f172a;
    border: 1px dashed #334155;
    padding: 3rem 1.5rem;
    border-radius: 12px;
    text-align: center;
  }

  .news-empty-state p {
    color: #64748b;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  @media (max-width: 768px) {
    h1 { font-size: 2.5rem; }
  }
</style>