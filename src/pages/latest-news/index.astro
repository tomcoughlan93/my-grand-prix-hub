---
// src/pages/latest-news/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch the 3 most recent SEO blog posts to feature on the portal
let latestFeatures: any[] = [];
try {
  const allFeatures = await getCollection('news');
  if (allFeatures) {
    latestFeatures = allFeatures
      .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
      .slice(0, 3);
  }
} catch (e) {
  console.warn('Notice: Could not load features collection.');
}
---

<Layout 
  title="F1 News & Features | My Grand Prix Hub"
  description="Your ultimate source for live Formula 1 paddock updates and in-depth evergreen F1 features, guides, and analysis."
>
  <main class="page-container">
    
    <!-- ALIGNED HEADER (Matches City/Circuit Directories) -->
    <div class="header-container">
      <header class="section-header">
        <span class="badge">Media Hub</span>
        <h1 class="gradient-title">News & Features</h1>
        <p>Choose your feed. Get up-to-the-minute updates from the paddock, or dive into our deep-dive guides and historical F1 features.</p>
      </header>
    </div>

    <div class="gateway-grid">
      
      <!-- GATEWAY 1: LIVE PADDOCK NEWS (RSS) -->
      <a href="/latest-news/paddock" class="gateway-card paddock-card">
        <div class="card-bg-image paddock-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-content">
          <div class="card-meta">
            <span class="live-pulse"></span>
            <span class="meta-text">Updated 24/7</span>
          </div>
          <h2>Paddock News</h2>
          <p>Live, aggregated updates from the world's top motorsport publishers. Breaking news, driver quotes, and weekend paddock rumors.</p>
          <span class="btn-gateway">Enter The Paddock &rarr;</span>
        </div>
      </a>

      <!-- GATEWAY 2: SEO BLOG / FEATURES -->
      <a href="/latest-news/the-racing-line" class="gateway-card features-card">
        <div class="card-bg-image features-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-content">
          <div class="card-meta">
            <span class="static-dot"></span>
            <span class="meta-text">Hub Exclusives</span>
          </div>
          <h2>The Racing Line</h2>
          <p>In-depth Formula 1 guides, technical explainers, historical deep-dives, and evergreen motorsport features created by our team.</p>
          <span class="btn-gateway">Read Features &rarr;</span>
        </div>
      </a>

    </div>

    <!-- PREVIEW OF LATEST SEO ARTICLES -->
    {latestFeatures.length > 0 && (
      <section class="latest-features-section">
        <div class="section-title-row">
          <h3>Latest From The Racing Line</h3>
          <a href="/latest-news/features" class="view-all-link">View All Articles &rarr;</a>
        </div>
        
        <div class="features-preview-grid">
          {latestFeatures.map((article) => (
            <a href={`/news/${article.id}`} class="feature-preview-card">
              <div class="feature-preview-content">
                <span class="feature-date">{new Date(article.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                <h4>{article.data.title}</h4>
                <p>{article.data.description}</p>
                <span class="read-more-text">Read Article &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Standardized Header */
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .section-header {
    max-width: 650px;
  }

  .badge {
    display: inline-block;
    background-color: #38bdf8;
    color: #0f172a;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Gateway Split Grid */
  .gateway-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .gateway-card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 450px;
    text-decoration: none;
    border: 1px solid #1e293b;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .gateway-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.3);
  }

  .paddock-card:hover { border-color: #e10600; }
  .features-card:hover { border-color: #38bdf8; }

  .card-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
    z-index: 1;
  }

  .paddock-bg {
    /* Fast, diagonal diamond-mesh pattern with a deep red underglow */
    background-color: #0f172a;
    background-image: 
      repeating-linear-gradient(-45deg, rgba(225, 6, 0, 0.06) 0, rgba(225, 6, 0, 0.06) 1px, transparent 1px, transparent 12px),
      repeating-linear-gradient(45deg, rgba(225, 6, 0, 0.06) 0, rgba(225, 6, 0, 0.06) 1px, transparent 1px, transparent 12px),
      linear-gradient(135deg, #0f172a 0%, #2a0808 100%);
  }

  .features-bg {
    /* Replaces the photo with a sleek, technical grid/telemetry pattern */
    background-color: #0f172a;
    background-image: 
      linear-gradient(rgba(56, 189, 248, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56, 189, 248, 0.07) 1px, transparent 1px),
      linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    background-size: 30px 30px, 30px 30px, 100% 100%;
  }
  .gateway-card:hover .card-bg-image {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.6) 50%, rgba(15, 23, 42, 0.2) 100%);
    z-index: 2;
  }

  .card-content {
    position: relative;
    z-index: 3;
    padding: 3rem 2.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background: #e10600;
    border-radius: 50%;
    box-shadow: 0 0 8px #e10600;
    animation: pulse 1.5s infinite;
  }

  .static-dot {
    width: 8px;
    height: 8px;
    background: #38bdf8;
    border-radius: 50%;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(225, 6, 0, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(225, 6, 0, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(225, 6, 0, 0); }
  }

  .meta-text {
    color: #e2e8f0;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content h2 {
    color: #ffffff;
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .card-content p {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    max-width: 90%;
  }

  .btn-gateway {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .paddock-card:hover .btn-gateway { background: #e10600; border-color: #e10600; }
  .features-card:hover .btn-gateway { background: #38bdf8; border-color: #38bdf8; color: #0b0f19; }

  /* Latest Features Preview */
  .section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .section-title-row h3 {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
  }

  .view-all-link {
    color: #38bdf8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    transition: color 0.2s;
  }

  .view-all-link:hover { color: #7dd3fc; }

  .features-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .feature-preview-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.75rem;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }

  .feature-preview-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 24px rgba(0,0,0,0.3);
  }

  .feature-preview-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .feature-date {
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.75rem;
  }

  .feature-preview-content h4 {
    color: #f8fafc;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .feature-preview-content p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }
  
  .read-more-text {
    color: #e10600;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
    transition: color 0.2s ease;
  }
  
  .feature-preview-card:hover .read-more-text {
    color: #ff1a1a;
  }

  @media (max-width: 900px) {
    .gateway-grid { grid-template-columns: 1fr; }
    .gateway-card { min-height: 350px; }
  }

  @media (max-width: 600px) {
    .gradient-title { font-size: 2.5rem; }
    .card-content h2 { font-size: 2rem; }
    .card-content { padding: 2rem 1.5rem; }
  }
</style>