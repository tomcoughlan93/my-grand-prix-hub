---
// src/pages/latest-news/index.astro
import Layout from '@/layouts/Layout.astro';
import Parser from 'rss-parser';
import { getCollection } from 'astro:content';

// --- 1. FETCH INTERNAL EXCLUSIVES ---
const allHubNews = await getCollection('news');
const sortedHubNews = allHubNews.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// --- 2. FETCH EXTERNAL RSS FEED ---
interface CustomFeedItem { /* ... existing interface ... */
  mediaContent?: any;
  mediaThumbnail?: any;
  enclosure?: { url?: string };
  contentEncoded?: string;
  description?: string;
  content?: string;
  summary?: string;
  contentSnippet?: string;
  title?: string;
  link?: string;
  pubDate?: string;
}

const parser: Parser<{}, CustomFeedItem> = new Parser({
  customFields: {
    item: [
      ['media:content', 'mediaContent', { keepArray: true }],
      ['media:thumbnail', 'mediaThumbnail', { keepArray: true }],
      ['enclosure', 'enclosure'],
      ['content:encoded', 'contentEncoded'],
      ['description', 'description'],
    ],
  },
});

const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' }, // Fixed URL!
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

interface NewsItem {
  title: string;
  link: string;
  pubDate: string;
  source: string;
  snippet: string;
  imageUrl?: string;
  dateObj: Date;
}

// Keep your existing cleanSnippet and extractImage functions here exactly as they were
function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;
  if (item.enclosure?.url) url = item.enclosure.url;
  else if (item.mediaContent && Array.isArray(item.mediaContent)) {
    const found = item.mediaContent.find((m: any) => m.$?.url || m.url);
    if (found) url = found.$?.url || found.url;
  }
  else if (item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) {
    const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url) {
    const html = item.contentEncoded || item.content || item.summary || item.description || '';
    const match = html.match(/<img[^>]+src=["']([^"']+)["']/i);
    if (match && match[1]) url = match[1];
  }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  return url;
}

let articles: NewsItem[] = [];

try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems: NewsItem[] = [];
      for (const item of feed.items || []) {
        const imageUrl = extractImage(item, src.name);
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!imageUrl || !hasValidDate) continue;
        
        const dateObj = new Date(item.pubDate!);
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDate: dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }),
          source: src.name,
          snippet: cleanSnippet(item.contentSnippet || item.content || item.summary || item.description),
          imageUrl,
          dateObj,
        });
        if (validItems.length >= 6) break;
      }
      return validItems;
    } catch (err) {
      console.warn(`[RSS Notice] Could not fetch ${src.name}:`, err);
      return [];
    }
  });
  const results = await Promise.all(feedPromises);
  articles = results.flat().sort((a, b) => b.dateObj.getTime() - a.dateObj.getTime());
} catch (e) {
  console.error('Error loading news feeds:', e);
}
---

<Layout title="Latest F1 News & Headlines | My Grand Prix Hub">
  <main class="page-container">
    
    <header class="section-header">
      <span class="badge">Latest News</span>
      <h1>Latest F1 News</h1>
      <p>The latest headlines, paddock updates, and technical analysis.</p>
    </header>

    <!-- SECTION 1: EXCLUSIVES (AI GENERATED) -->
    {sortedHubNews.length > 0 && (
      <section class="exclusive-section">
        <h2 class="section-title">From The Hub Desk</h2>
        <div class="exclusive-grid">
          {sortedHubNews.map((article) => (
            <a href={`/news/${article.id}`} class="exclusive-card">
              <div class="card-content">
                <span class="exclusive-badge">Exclusive Feature</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description || 'In-depth preview and analysis.'}</p>
                <span class="read-more">Read Full Article →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- SECTION 2: EXTERNAL RSS FEED -->
    <section class="rss-section">
      <h2 class="section-title">Around The Paddock</h2>
      
      {articles.length === 0 ? (
        <div class="empty-state"><p>Unable to load news feed at this moment.</p></div>
      ) : (
        <div class="news-grid">
          {articles.map((item) => (
            <article class="news-card">
              <div class="card-image-wrap">
                <img src={item.imageUrl} alt={item.title} loading="lazy" class="card-image" />
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span class="source-tag">{item.source}</span>
                  <span class="pub-time">{item.pubDate}</span>
                </div>
                <h2><a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a></h2>
                {item.snippet && <p class="snippet">{item.snippet}</p>}
                <a href={item.link} target="_blank" rel="noopener noreferrer" class="read-link">
                  Read on {item.source} ↗
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

  </main>
</Layout>

<style>
  /* Keep all your existing styles! */
  .page-container { max-width: 1200px; margin: 0 auto; padding: 3rem 1.5rem 4rem 1.5rem; }
  .section-header { margin-bottom: 2.5rem; }
  .badge { background: #e10600; color: white; padding: 0.25rem 0.6rem; border-radius: 4px; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; }
  h1 { font-size: 2.5rem; color: #f8fafc; margin: 0.75rem 0 0.5rem 0; font-weight: 800; }
  .section-header p { color: #94a3b8; font-size: 1.15rem; }
  
  .section-title { font-size: 1.5rem; color: #f8fafc; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid #334155; }
  .exclusive-section { margin-bottom: 4rem; }
  
  /* New Styles for AI Articles */
  .exclusive-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .exclusive-card { background: linear-gradient(145deg, #1e293b, #0f172a); border: 1px solid #475569; border-radius: 8px; text-decoration: none; display: flex; transition: transform 0.2s, border-color 0.2s; }
  .exclusive-card:hover { transform: translateY(-4px); border-color: #e10600; }
  .card-content { padding: 2rem; display: flex; flex-direction: column; }
  .exclusive-badge { color: #e10600; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 1rem; }
  .exclusive-card h3 { color: #ffffff; font-size: 1.4rem; margin: 0 0 1rem 0; line-height: 1.3; }
  .exclusive-card p { color: #cbd5e1; font-size: 1rem; margin-bottom: 1.5rem; flex-grow: 1; }
  .read-more { color: #38bdf8; font-weight: 600; font-size: 0.9rem; }
  
  /* Your existing RSS grid styles */
  .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.75rem; }
  .news-card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s; }
  .news-card:hover { transform: translateY(-4px); border-color: #e10600; }
  .card-image-wrap { height: 190px; overflow: hidden; background: #0b0f19; }
  .card-image { width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .card-meta { display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 0.75rem; }
  .source-tag { color: #38bdf8; font-weight: 700; text-transform: uppercase; }
  .pub-time { color: #64748b; }
  .news-card h2 { font-size: 1.2rem; margin: 0 0 0.75rem 0; }
  .news-card h2 a { color: #f8fafc; text-decoration: none; }
  .snippet { color: #94a3b8; font-size: 0.9rem; margin-bottom: 1.25rem; flex-grow: 1; }
  .read-link { color: #e10600; font-weight: 600; font-size: 0.85rem; text-decoration: none; margin-top: auto; }
</style>