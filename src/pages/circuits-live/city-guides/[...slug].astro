---
// src/pages/circuits-live/city-guides/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import { cityGuidesData } from '@/data/cityGuides/index';
import type { CityGuide } from '@/data/types';

export const prerender = true;

export function getStaticPaths() {
  return cityGuidesData.map((city: CityGuide) => ({
    params: { slug: city.slug },
    props: { ...city },
  }));
}

const { 
  slug, // Make sure to destructure the slug!
  city, 
  raceSlug, 
  race, 
  circuitName, 
  country, 
  heroImage, 
  intro, 
  quickFacts, 
  trackCommuteSummary,
  morningSupplies,
  cityTransport,
  practicalities,
  weatherAndVibe,
  itinerary, 
  extendedStay,
  neighborhoods, 
  foodAndDrink,
  watchParties,
  sightseeing 
} = Astro.props as CityGuide & { slug: string }; 

// --- SEO STRUCTURED DATA LOGIC ---
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": `${city} F1 Fan Guide: Travel & Survival for the ${race}`,
  "description": intro,
  "image": heroImage,
  "author": {
    "@type": "Organization",
    "name": "My Grand Prix Hub"
  },
  "publisher": {
    "@type": "Organization",
    "name": "My Grand Prix Hub",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mygrandprixhub.com/logo.png" // Fallback - replace if you have a real URL
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://mygrandprixhub.com/circuits-live/city-guides/${slug}` // Fallback domain
  },
  "about": {
    "@type": "Place",
    "name": city,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": country
    }
  }
};
---

<Layout 
  title={`${city} Fan City Guide | ${race} | My Grand Prix Hub`}
  description={`F1 fan guide to ${city}. Where to stay, post-session dining, non-clashing weekend itinerary, and fast transit routes to ${circuitName}.`}
>
  <!-- SEO STRUCTURED DATA -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <main class="page-container">
    
    <!-- BACK LINK -->
    <a href="/circuits-live/city-guides" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to All City Guides
    </a>

    <!-- HERO HEADER -->
    <header class="city-hero">
      <div class="hero-bg">
        <img src={heroImage} alt={`${city} city`} />
        <div class="hero-gradient"></div>
      </div>
      <div class="hero-content">
        <div class="hero-meta">
          <span class="race-tag">🏎️ Official Host City &bull; {race}</span>
        </div>
        <h1>{city}</h1>
        <p class="subtitle">📍 {country} &bull; Base for {circuitName}</p>
      </div>
    </header>

    <!-- STICKY JUMP NAVIGATION -->
    <nav class="sticky-subnav" id="city-nav">
      <div class="subnav-inner">
        <a href="#commute" class="subnav-link is-active">🚆 Track Commute</a>
        <a href="#itinerary" class="subnav-link">🗓️ Race Weekend Plan</a>
        <a href="#neighborhoods" class="subnav-link">🏨 Where to Stay</a>
        <a href="#dining" class="subnav-link">🍻 Food & Hangouts</a>
        <a href="#explore" class="subnav-link">🏛️ City Sights</a>
      </div>
    </nav>

    <!-- MAIN TWO-COLUMN CONTENT -->
    <div class="content-grid">
      
      <!-- LEFT COLUMN -->
      <div class="main-column">
        
        <!-- INTRO -->
        <section class="guide-card intro-card">
          <p>{intro}</p>
        </section>

        <!-- COMMUTE SPOTLIGHT -->
        <section id="commute" class="guide-card commute-card">
          <div class="card-header">
            <div class="icon-circle bg-sky">🚆</div>
            <div>
              <span class="eyebrow">Fast Morning Transit</span>
              <h2>{trackCommuteSummary.title}</h2>
            </div>
          </div>

          <div class="commute-metrics">
            <div class="metric-box">
              <span class="lbl">Train Travel Time</span>
              <strong class="val text-sky">{trackCommuteSummary.time}</strong>
            </div>
            <div class="metric-box">
              <span class="lbl">Weekend Frequency</span>
              <strong class="val">{trackCommuteSummary.frequency}</strong>
            </div>
          </div>

          <p class="commute-details">{trackCommuteSummary.details}</p>

          <!-- NEW: MORNING SUPPLIES CALLOUT -->
          <div class="supplies-callout">
            <div class="supplies-icon">🏪</div>
            <div class="supplies-text">
              <strong>Morning Track Supplies:</strong> 
              Look for a <em>{morningSupplies.location}</em>. {morningSupplies.tip}
            </div>
          </div>
        </section>

        <!-- F1-AWARE WEEKEND ITINERARY -->
        <section id="itinerary" class="guide-card">
          <div class="section-title-wrap">
            <span class="eyebrow">Non-Clashing Schedule</span>
            <h2>The Perfect F1 City Weekend</h2>
            <p class="section-desc">Designed around official track sessions so you can explore the city without missing lights out.</p>
          </div>

          <div class="timeline-container">
            {itinerary.map((item: any) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <span class="day-bubble">{item.day.slice(0, 3)}</span>
                  <div class="timeline-line"></div>
                </div>
                <div class="timeline-body">
                  <div class="timeline-meta">
                    <span class="day-full">{item.day}</span>
                    <span class="timing-badge">{item.timing}</span>
                  </div>
                  <h3>{item.title}</h3>
                  <p>{item.activity}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- EXTENDED STAY & MOTORSPORT FIX -->
          <div class="extended-stay-box">
            <div class="es-header">
              <h3>{extendedStay.title}</h3>
              <p>{extendedStay.desc}</p>
            </div>
            <div class="es-grid">
              <div class="es-col">
                <h4 class="es-col-title">🏛️ Local Culture</h4>
                <ul class="es-list">
                  {extendedStay.culture.map((item: any) => (
                    <li>
                      <strong>{item.name}:</strong>
                      <span>{item.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="es-col">
                <h4 class="es-col-title">🏁 Motorsport Fix</h4>
                <ul class="es-list">
                  {extendedStay.motorsport.map((item: any) => (
                    <li>
                      <strong>{item.name}:</strong>
                      <span>{item.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- WHERE TO STAY & NEIGHBORHOODS -->
        <section id="neighborhoods" class="guide-card">
          <div class="section-title-wrap">
            <span class="eyebrow">Hotel & Base Guide</span>
            <h2>Best Areas to Stay in {city}</h2>
            <p class="section-desc">Ranked by atmosphere, evening dining, and morning transit convenience to {circuitName}.</p>
          </div>

          <div class="neighborhoods-grid">
            {neighborhoods.map((hood: any) => (
              <div class="hood-card">
                <div class="hood-top">
                  <div class="hood-header">
                    <span class="vibe-tag">{hood.vibe}</span>
                    <span class="commute-badge">⏱️ {hood.commuteTime}</span>
                  </div>
                  <h3>{hood.name}</h3>
                  <p class="hood-route"><strong>Transit Route:</strong> {hood.transitRoute}</p>
                  <p class="hood-desc">{hood.desc}</p>
                </div>
                <a href={hood.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-hood-book">
                  Search Hotels in {hood.name.split('(')[0]} &rarr;
                </a>
              </div>
            ))}
          </div>
        </section>

        <!-- FOOD, PUBS & WATCH PARTIES -->
        <section id="dining" class="guide-card">
          <div class="section-title-wrap">
            <span class="eyebrow">Post-Session Hangouts</span>
            <h2>Food, Pubs & F1 Atmosphere</h2>
          </div>

          <div class="dining-list">
            {foodAndDrink.map((spot: any) => (
              <div class="dining-item">
                <div class="dining-info">
                  <div class="dining-type-badge">{spot.type}</div>
                  <h3>{spot.name}</h3>
                  <p>{spot.desc}</p>
                </div>
                {spot.mapUrl && (
                  <a href={spot.mapUrl} target="_blank" rel="noopener noreferrer" class="btn-map-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    Map
                  </a>
                )}
              </div>
            ))}
          </div>

          <!-- NEW: WATCH PARTIES & FAN ZONES -->
          <div class="watch-parties-wrapper">
            <h3 class="subsection-title">Official Fan Zones & Pub Screenings</h3>
            <p class="subsection-desc">Looking to soak up the atmosphere in the city without a track ticket?</p>
            
            <div class="watch-parties-grid">
              {watchParties.map((party: any) => (
                <div class="wp-card">
                  <span class="wp-tag">{party.type}</span>
                  <h4>{party.name}</h4>
                  <p>{party.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- CITY SIGHTS -->
        <section id="explore" class="guide-card">
          <div class="section-title-wrap">
            <span class="eyebrow">Thursday / Monday Slots</span>
            <h2>Top Sights (Non-Track Days)</h2>
          </div>

          <div class="sight-grid">
            {sightseeing.map((sight: any) => (
              <div class="sight-card">
                <span class="slot-pill">🗓️ {sight.timeSlot}</span>
                <h3>{sight.name}</h3>
                <p>{sight.desc}</p>
                {sight.ticketUrl && (
                  <a href={sight.ticketUrl} target="_blank" rel="noopener noreferrer" class="btn-sight-ticket">
                    Tickets & Information &rarr;
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: SIDEBAR WIDGETS -->
      <aside class="sidebar-column">
        
        <!-- QUICK FACTS WIDGET -->
        <div class="sidebar-widget facts-widget">
          <h3>City Quick Facts</h3>
          <ul class="facts-list">
            <li>
              <span class="lbl">Currency</span>
              <strong class="val">{quickFacts.currency}</strong>
            </li>
            <li>
              <span class="lbl">Local Transit Payments</span>
              <strong class="val">{quickFacts.transitCard}</strong>
            </li>
            <li>
              <span class="lbl">Language</span>
              <strong class="val">{quickFacts.language}</strong>
            </li>
            <li>
              <span class="lbl">Primary Airport</span>
              <strong class="val">{quickFacts.airport}</strong>
            </li>
          </ul>
        </div>

        <!-- NEW: LOCAL KNOW-HOW (Weather & Practicalities) -->
        <div class="sidebar-widget facts-widget">
          <h3>Local Know-How</h3>
          <ul class="facts-list">
            <li>
              <span class="lbl">Weather & Packing Vibe</span>
              <span class="val-desc">{weatherAndVibe.climate} {weatherAndVibe.dressCode}</span>
            </li>
            <li>
              <span class="lbl">Tap Water</span>
              <span class="val-desc">{practicalities.tapWater}</span>
            </li>
            <li>
              <span class="lbl">Tipping Culture</span>
              <span class="val-desc">{practicalities.tipping}</span>
            </li>
            <li>
              <span class="lbl">Power Adaptors</span>
              <span class="val-desc">{practicalities.powerPlugs}</span>
            </li>
          </ul>
        </div>

        <!-- NEW: CITY TRANSPORT (Rideshare & Night Transit) -->
        <div class="sidebar-widget facts-widget">
          <h3>Getting Around Town</h3>
          <ul class="facts-list">
            <li>
              <span class="lbl">Taxis & Rideshare</span>
              <span class="val-desc">{cityTransport.rideshare}</span>
            </li>
            <li>
              <span class="lbl">Late Night / Post-Pub Transit</span>
              <span class="val-desc">{cityTransport.nightTransit}</span>
            </li>
          </ul>
        </div>

        <!-- CROSS LINK TO TICKETS & TRAVEL HUB (Sticky) -->
        <div class="sidebar-widget promo-widget">
          <span class="widget-badge">Trip Planning Hub</span>
          <h3>Attending the {race}?</h3>
          <p>Book grandstand tickets, verify gate rules, and check official ticket resellers on our dedicated logistics hub.</p>
          <a href={`/travel-and-tickets/${raceSlug}`} class="btn-primary w-full justify-center">
            {race} Tickets & Travel &rarr;
          </a>
        </div>

      </aside>

    </div>
  </main>
</Layout>

<script>
  function initScrollSpy() {
    const navLinks = document.querySelectorAll('.subnav-link');
    const sections = document.querySelectorAll('.guide-card[id]');

    if (navLinks.length === 0 || sections.length === 0) return;

    const onScroll = () => {
      let currentId = '';
      
      sections.forEach(section => {
        if (section.getBoundingClientRect().top <= 120) {
          currentId = section.getAttribute('id') || '';
        }
      });

      const isAtBottom = (window.innerHeight + window.scrollY) >= document.documentElement.offsetHeight - 50;
      
      if (isAtBottom) {
        currentId = sections[sections.length - 1].getAttribute('id') || '';
      }

      if (!currentId && sections.length > 0) {
        currentId = sections[0].getAttribute('id') || '';
      }

      navLinks.forEach(link => {
        link.classList.remove('is-active');
        if (currentId && link.getAttribute('href') === `#${currentId}`) {
          link.classList.add('is-active');
        }
      });
    };

    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); 
  }

  document.addEventListener('DOMContentLoaded', initScrollSpy);
  document.addEventListener('astro:page-load', initScrollSpy);
</script>

<style>
  .page-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .w-full { width: 100%; }
  .justify-center { justify-content: center; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #38bdf8; }

  /* Hero Section */
  .city-hero {
    position: relative;
    height: 380px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 2rem;
    display: flex;
    align-items: flex-end;
    padding: 2.5rem;
    border: 1px solid #334155;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .hero-bg { position: absolute; inset: 0; z-index: 1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.98) 0%, rgba(15, 23, 42, 0.4) 60%, transparent 100%);
  }
  .hero-content { position: relative; z-index: 2; }
  .race-tag {
    background: #e10600; color: #ffffff; font-size: 0.75rem; font-weight: 800;
    text-transform: uppercase; padding: 0.35rem 0.75rem; border-radius: 4px;
    display: inline-block; margin-bottom: 0.75rem; letter-spacing: 0.05em;
  }
  .hero-content h1 {
    font-size: 4rem; font-weight: 900; margin: 0 0 0.25rem 0;
    color: #ffffff; letter-spacing: -0.02em; line-height: 1;
  }
  .subtitle { color: #94a3b8; font-size: 1.15rem; margin: 0; }

  /* Sticky Sub-Navigation */
  .sticky-subnav {
    position: sticky;
    top: 0;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid #334155;
    border-bottom: 1px solid #334155;
    padding: 0.75rem 1rem;
    margin-bottom: 2.5rem;
    z-index: 20;
    border-radius: 8px;
  }
  .subnav-inner {
    display: flex; gap: 1.25rem; overflow-x: auto; white-space: nowrap;
  }
  .subnav-link {
    color: #94a3b8; text-decoration: none; font-size: 0.85rem; font-weight: 700;
    padding: 0.35rem 0.75rem; border-radius: 6px; transition: all 0.2s ease;
  }
  .subnav-link.is-active { background: #1e293b; color: #38bdf8; }

  /* Layout */
  .content-grid {
    display: grid; grid-template-columns: 1fr 340px; gap: 2.5rem;
  }
  .main-column {
    display: flex; flex-direction: column; gap: 2.5rem;
  }
  .guide-card {
    background: #0f172a; border: 1px solid #1e293b; border-radius: 12px;
    padding: 2rem; scroll-margin-top: 80px;
  }
  .intro-card p { font-size: 1.15rem; line-height: 1.7; color: #e2e8f0; margin: 0; }
  .section-title-wrap { margin-bottom: 1.75rem; }
  .eyebrow {
    color: #38bdf8; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;
  }
  .section-title-wrap h2 { font-size: 1.65rem; font-weight: 800; color: #ffffff; margin: 0 0 0.5rem 0; }
  .section-desc { color: #94a3b8; font-size: 0.95rem; margin: 0; }

  /* Commute & New Supplies Callout */
  .commute-card { border-left: 4px solid #38bdf8; }
  .card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .icon-circle {
    width: 48px; height: 48px; border-radius: 10px; display: flex;
    align-items: center; justify-content: center; font-size: 1.5rem;
  }
  .bg-sky { background: rgba(56, 189, 248, 0.15); }
  .card-header h2 { font-size: 1.4rem; color: #ffffff; margin: 0; font-weight: 800; }
  .commute-metrics {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: #1e293b;
    border: 1px solid #334155; padding: 1.25rem; border-radius: 8px; margin-bottom: 1.25rem;
  }
  .metric-box { display: flex; flex-direction: column; }
  .metric-box .lbl { font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; }
  .metric-box .val { font-size: 1.25rem; font-weight: 900; }
  .text-sky { color: #38bdf8; }
  .commute-details { color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  
  .supplies-callout {
    display: flex; gap: 1rem; align-items: center; background: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.3); padding: 1rem; border-radius: 8px; margin-top: 1.5rem;
  }
  .supplies-icon { font-size: 1.5rem; }
  .supplies-text { color: #f8fafc; font-size: 0.9rem; line-height: 1.5; }
  .supplies-text strong { color: #facc15; }

  /* Timeline */
  .timeline-container { display: flex; flex-direction: column; }
  .timeline-item { display: flex; gap: 1.5rem; }
  .timeline-marker { display: flex; flex-direction: column; align-items: center; }
  .day-bubble {
    background: #1e293b; border: 1px solid #38bdf8; color: #38bdf8; font-size: 0.75rem;
    font-weight: 900; padding: 0.35rem 0.5rem; border-radius: 6px; text-transform: uppercase;
  }
  .timeline-line { flex-grow: 1; width: 2px; background: #1e293b; margin: 0.5rem 0; }
  .timeline-body { padding-bottom: 2rem; }
  .timeline-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem; }
  .day-full { font-weight: 800; color: #ffffff; font-size: 0.95rem; }
  .timing-badge {
    background: #1e293b; color: #94a3b8; font-size: 0.75rem;
    font-weight: 700; padding: 0.15rem 0.45rem; border-radius: 4px;
  }
  .timeline-body h3 { color: #38bdf8; font-size: 1.15rem; margin: 0 0 0.35rem 0; font-weight: 800; }
  .timeline-body p { color: #cbd5e1; font-size: 0.92rem; line-height: 1.5; margin: 0; }

  /* Extended Stay */
  .extended-stay-box {
    margin-top: 1rem; background: #111827; border: 1px dashed #475569;
    border-radius: 12px; padding: 2rem;
  }
  .es-header { margin-bottom: 1.5rem; }
  .es-header h3 { color: #38bdf8; font-size: 1.3rem; font-weight: 800; margin: 0 0 0.5rem 0; }
  .es-header p { color: #cbd5e1; font-size: 0.95rem; margin: 0; line-height: 1.5; }
  .es-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .es-col { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.5rem; }
  .es-col-title { color: #ffffff; font-size: 1.05rem; margin: 0 0 1rem 0; font-weight: 800; }
  .es-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .es-list li { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.9rem; line-height: 1.5; color: #94a3b8; }
  .es-list strong { color: #e2e8f0; font-size: 0.95rem; }

  /* Neighborhoods */
  .neighborhoods-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; }
  .hood-card {
    background: #1e293b; border: 1px solid #334155; border-radius: 10px;
    display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
  }
  .hood-top { padding: 1.5rem; }
  .hood-header { 
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; 
  }
  .vibe-tag { color: #fbbf24; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; line-height: 1.4; }
  .commute-badge { 
    background: #0f172a; border: 1px solid #38bdf8; color: #38bdf8; font-size: 0.75rem; 
    font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; flex-shrink: 0; white-space: nowrap; 
  }
  .hood-card h3 { color: #ffffff; font-size: 1.25rem; margin: 0 0 0.5rem 0; font-weight: 800; }
  .hood-route { background: #0f172a; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.8rem; color: #94a3b8; margin: 0 0 0.75rem 0; }
  .hood-route strong { color: #f8fafc; }
  .hood-desc { color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0; }
