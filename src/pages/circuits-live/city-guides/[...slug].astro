---
// src/pages/circuits-live/city-guides/[slug].astro
import Layout from '@/layouts/Layout.astro';

export const prerender = true;

// --- DATA MODEL ---
export function getStaticPaths() {
  return [
    {
      params: { slug: 'amsterdam' },
      props: {
        city: 'Amsterdam',
        race: 'Dutch Grand Prix',
        country: 'Netherlands',
        heroImage: 'https://images.unsplash.com/photo-1517736996303-4e64a4f87311?q=80&w=1200&auto=format&fit=crop',
        intro: 'Amsterdam is the ultimate hub for the Dutch Grand Prix. While Zandvoort is a coastal town, the vast majority of fans stay in Amsterdam and commute to the track, combining world-class nightlife and culture with the electric atmosphere of the Orange Army.',
        quickFacts: {
          currency: 'Euro (€)',
          language: 'Dutch (English universally spoken)',
          airport: 'Schiphol Airport (AMS)'
        },
        trackTransport: {
          title: 'Getting to Zandvoort',
          description: 'The commute is incredibly efficient during race weekend. The NS Sprinter train runs every 5 minutes from Amsterdam Centraal directly to Zandvoort aan Zee. The journey takes about 30 minutes, followed by a 15-minute walk to the circuit gates.',
          icon: '🚆'
        },
        neighborhoods: [
          {
            name: 'City Centre (Centrum)',
            vibe: 'Action & Nightlife',
            desc: 'Perfect if you want to be in the middle of the party. It offers the fastest access to Central Station for your morning track commute, but hotels are pricey and it gets very crowded.',
            links: [
              { name: 'Booking.com', url: 'https://www.booking.com/district/nl/amsterdam/amsterdam-city-centre.html', type: 'book' },
              { name: 'Airbnb', url: 'https://www.airbnb.com/s/Amsterdam-Centrum--Amsterdam--Netherlands', type: 'book' }
            ]
          },
          {
            name: 'De Pijp',
            vibe: 'Trendy & Local',
            desc: 'A fantastic neighborhood packed with great brunch spots, bars, and the famous Albert Cuyp Market. You will need to take a quick tram or bike ride to Central Station first.',
            links: [
              { name: 'Booking.com', url: 'https://www.booking.com/district/nl/amsterdam/oud-zuid.html', type: 'book' },
              { name: 'Airbnb', url: 'https://www.airbnb.com/s/De-Pijp--Amsterdam--Netherlands', type: 'book' }
            ]
          }
        ],
        foodAndDrink: [
          {
            name: 'Foodhallen',
            type: 'Indoor Street Food',
            desc: 'A massive indoor market in an old tram depot. Perfect for large groups of fans who all want to eat something different.',
            links: [
              { name: 'Directions', url: 'https://maps.app.goo.gl/FoodhallenAmsterdam', type: 'map' },
              { name: 'Website', url: 'https://foodhallen.nl/amsterdam', type: 'web' }
            ]
          },
          {
            name: 'Leidseplein',
            type: 'Bar District',
            desc: 'The heart of Amsterdam\'s pub scene. During race week, expect this area to be completely taken over by fans in orange.',
            links: [
              { name: 'Directions', url: 'https://maps.app.goo.gl/Leidseplein', type: 'map' }
            ]
          }
        ],
        sightseeing: [
          {
            name: 'Rijksmuseum & Vondelpark',
            desc: 'Spend your Thursday or Monday exploring the museum district and relaxing in the city\'s most famous park.',
            links: [
              { name: 'Museum Tickets', url: 'https://www.rijksmuseum.nl/en/tickets', type: 'ticket' },
              { name: 'Directions', url: 'https://maps.app.goo.gl/Rijksmuseum', type: 'map' }
            ]
          },
          {
            name: 'Canal Boat Tour',
            desc: 'A cliché, but absolutely the best way to see the city. Book an evening cruise with drinks included for the best experience.',
            links: [
              { name: 'Book a Tour', url: 'https://www.getyourguide.com/amsterdam-l36/cruises-boat-tours-tc48/', type: 'ticket' }
            ]
          }
        ]
      }
    }
  ];
}

const { city, race, country, heroImage, intro, quickFacts, trackTransport, neighborhoods, foodAndDrink, sightseeing } = Astro.props;

// SVG Icon Helper for Action Buttons
const getActionIcon = (type: string) => {
  if (type === 'map') {
    return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`;
  }
  if (type === 'web') {
    return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`;
  }
  if (type === 'ticket') {
    return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3c-1.1 0-2 .9-2 2s.9 2 2 2v3H4v-3c1.1 0 2-.9 2-2s-.9-2-2-2V7z"></path><line x1="9" y1="8" x2="15" y2="8"></line><line x1="9" y1="12" x2="15" y2="12"></line></svg>`;
  }
  // Default (Book/External)
  return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg>`;
};
---

<Layout 
  title={`${city} Travel Guide | ${race} | My Grand Prix Hub`}
  description={`F1 fan travel guide to ${city}. Discover where to stay, eat, and how to travel to the ${race}.`}
>
  <main class="page-container">
    
    <!-- BACK LINK -->
    <a href="/circuits-live/city-guides" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to City Guides
    </a>

    <!-- HERO SECTION -->
    <header class="hero-section">
      <div class="hero-bg">
        <img src={heroImage} alt={`${city} city skyline`} />
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <span class="race-badge">🏎️ {race}</span>
        <h1>{city}</h1>
        <p class="country-tag">📍 {country}</p>
      </div>
    </header>

    <!-- CONTENT GRID -->
    <div class="content-grid">
      
      <!-- LEFT COLUMN: Main Guide Content -->
      <div class="main-column">
        
        <section class="guide-section intro-section">
          <p class="intro-text">{intro}</p>
        </section>

        <!-- TRACK TRANSPORT SPOTLIGHT -->
        <section class="guide-section transport-spotlight">
          <div class="spotlight-icon">{trackTransport.icon}</div>
          <div class="spotlight-text">
            <h2>{trackTransport.title}</h2>
            <p>{trackTransport.description}</p>
          </div>
        </section>

        <!-- WHERE TO STAY -->
        <section class="guide-section">
          <div class="section-heading">
            <span class="icon">🏨</span>
            <h2>Where to Stay</h2>
          </div>
          <div class="cards-grid">
            {neighborhoods.map(hood => (
              <div class="info-card">
                <div class="card-text-content">
                  <span class="vibe-pill">{hood.vibe}</span>
                  <h3>{hood.name}</h3>
                  <p>{hood.desc}</p>
                </div>
                
                {hood.links && hood.links.length > 0 && (
                  <div class="action-links">
                    {hood.links.map((link: any) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class={`btn-action action-${link.type}`}>
                        <span class="btn-icon" set:html={getActionIcon(link.type)}></span>
                        {link.name}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- FOOD & DRINK -->
        <section class="guide-section">
          <div class="section-heading">
            <span class="icon">🍻</span>
            <h2>Food & Nightlife</h2>
          </div>
          <div class="list-layout">
            {foodAndDrink.map(place => (
              <div class="list-item">
                <div class="item-header">
                  <h3>{place.name}</h3>
                  <span class="type-tag">{place.type}</span>
                </div>
                <p>{place.desc}</p>
                
                {place.links && place.links.length > 0 && (
                  <div class="action-links">
                    {place.links.map((link: any) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class={`btn-action action-${link.type}`}>
                        <span class="btn-icon" set:html={getActionIcon(link.type)}></span>
                        {link.name}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: Sidebar -->
      <aside class="sidebar-column">
        
        <!-- QUICK FACTS -->
        <div class="sidebar-widget facts-widget">
          <h3>Quick Facts</h3>
          <ul class="facts-list">
            <li>
              <span class="fact-label">Currency</span>
              <span class="fact-val">{quickFacts.currency}</span>
            </li>
            <li>
              <span class="fact-label">Language</span>
              <span class="fact-val">{quickFacts.language}</span>
            </li>
            <li>
              <span class="fact-label">Main Airport</span>
              <span class="fact-val">{quickFacts.airport}</span>
            </li>
          </ul>
        </div>

        <!-- SIGHTSEEING -->
        <div class="sidebar-widget sightseeing-widget">
          <h3>Things to Do</h3>
          <div class="sightseeing-list">
            {sightseeing.map(site => (
              <div class="sight-item">
                <h4>{site.name}</h4>
                <p>{site.desc}</p>
                
                {site.links && site.links.length > 0 && (
                  <div class="action-links">
                    {site.links.map((link: any) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class={`btn-action action-${link.type}`}>
                        <span class="btn-icon" set:html={getActionIcon(link.type)}></span>
                        {link.name}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

      </aside>
    </div>

  </main>
</Layout>

<style is:global>
  /* Base Layout */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #ffffff; }

  /* Hero Section */
  .hero-section {
    position: relative;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 3.5rem;
    display: flex;
    align-items: flex-end;
    padding: 3rem;
    border: 1px solid #334155;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .hero-bg { position: absolute; inset: 0; z-index: 1; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 1) 0%, rgba(15, 23, 42, 0.4) 50%, transparent 100%);
  }

  .hero-content { position: relative; z-index: 2; max-width: 800px; }

  .race-badge {
    display: inline-block;
    background: #e10600; color: #ffffff; font-size: 0.85rem; font-weight: 800;
    text-transform: uppercase; padding: 0.4rem 1rem; border-radius: 6px;
    letter-spacing: 0.05em; margin-bottom: 1rem;
  }

  .hero-content h1 {
    font-size: 4.5rem; font-weight: 900; color: #ffffff;
    margin: 0 0 0.5rem 0; letter-spacing: -0.02em; line-height: 1;
  }

  .country-tag { color: #38bdf8; font-size: 1.25rem; font-weight: 700; margin: 0; }

  /* Content Architecture */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }

  .guide-section { margin-bottom: 3.5rem; }

  .intro-text { font-size: 1.2rem; line-height: 1.7; color: #e2e8f0; margin: 0; }

  .section-heading {
    display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;
    border-bottom: 2px solid #334155; padding-bottom: 0.75rem;
  }
  .section-heading h2 { font-size: 1.8rem; color: #ffffff; font-weight: 800; margin: 0; }
  .section-heading .icon { font-size: 1.8rem; }

  /* Transport Spotlight */
  .transport-spotlight {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #38bdf8; border-radius: 12px; padding: 2rem;
    display: flex; gap: 1.5rem; align-items: flex-start;
  }

  .spotlight-icon { font-size: 3rem; line-height: 1; }
  .spotlight-text h2 { color: #38bdf8; font-size: 1.5rem; margin: 0 0 0.75rem 0; font-weight: 800; }
  .spotlight-text p { color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; margin: 0; }

  /* Cards Grid (Hotels/Neighborhoods) */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .info-card {
    background: #0f172a; border: 1px solid #334155; padding: 1.5rem;
    border-radius: 8px; display: flex; flex-direction: column; justify-content: space-between;
    transition: transform 0.2s;
  }
  .info-card:hover { transform: translateY(-4px); border-color: #475569; }

  .vibe-pill {
    display: inline-block; background: #334155; color: #e2e8f0;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    padding: 0.25rem 0.6rem; border-radius: 4px; margin-bottom: 1rem; letter-spacing: 0.05em;
  }

  .info-card h3 { color: #ffffff; font-size: 1.25rem; margin: 0 0 0.75rem 0; font-weight: 800; }
  .info-card p { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.5rem 0; }

  /* Action Buttons (Premium Pills) */
  .action-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-icon { display: flex; align-items: center; justify-content: center; }

  /* Specific Button Colors */
  .action-book {
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }
  .action-book:hover { background: #38bdf8; color: #0f172a; border-color: #38bdf8; }

  .action-map {
    background: rgba(52, 211, 153, 0.1);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .action-map:hover { background: #34d399; color: #0f172a; border-color: #34d399; }

  .action-web {
    background: rgba(250, 204, 21, 0.1);
    color: #facc15;
    border: 1px solid rgba(250, 204, 21, 0.3);
  }
  .action-web:hover { background: #facc15; color: #0f172a; border-color: #facc15; }

  .action-ticket {
    background: rgba(225, 6, 0, 0.1);
    color: #ff4d4d;
    border: 1px solid rgba(225, 6, 0, 0.3);
  }
  .action-ticket:hover { background: #e10600; color: #ffffff; border-color: #e10600; }


  /* List Layout (Food/Drink) */
  .list-layout { display: flex; flex-direction: column; gap: 1.25rem; }

  .list-item {
    background: #0f172a; border: 1px solid #334155; border-left: 4px solid #facc15;
    padding: 1.5rem; border-radius: 8px;
  }

  .item-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;
  }

  .item-header h3 { color: #ffffff; font-size: 1.25rem; margin: 0; font-weight: 800; }
  .type-tag { font-size: 0.8rem; color: #facc15; font-weight: 700; }
  .list-item p { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin: 0; }

  /* Sidebar */
  .sidebar-column { display: flex; flex-direction: column; gap: 2rem; position: sticky; top: 2rem; }

  .sidebar-widget {
    background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 2rem;
  }

  .sidebar-widget h3 {
    color: #ffffff; font-size: 1.35rem; font-weight: 800; margin: 0 0 1.5rem 0;
    border-bottom: 1px solid #334155; padding-bottom: 0.75rem;
  }

  /* Facts List */
  .facts-list {
    list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem;
  }
  .facts-list li { display: flex; flex-direction: column; gap: 0.25rem; }
  .fact-label { color: #64748b; font-size: 0.8rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; }
  .fact-val { color: #f8fafc; font-size: 1.05rem; font-weight: 600; }
  .fact-val.highlight { color: #38bdf8; }

  /* Sightseeing List */
  .sightseeing-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .sight-item h4 { color: #e2e8f0; font-size: 1.1rem; margin: 0 0 0.4rem 0; font-weight: 700; }
  .sight-item p { color: #94a3b8; font-size: 0.95rem; line-height: 1.5; margin: 0; }

  /* Responsive Design */
  @media (max-width: 900px) {
    .content-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: relative; top: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .hero-section { height: 350px; padding: 2rem; }
    .hero-content h1 { font-size: 3.5rem; }
  }

  @media (max-width: 768px) {
    .sidebar-column { grid-template-columns: 1fr; }
    .transport-spotlight { flex-direction: column; gap: 1rem; }
    .hero-section { height: 300px; padding: 1.5rem; }
    .hero-content h1 { font-size: 2.8rem; }
  }
</style>cccom