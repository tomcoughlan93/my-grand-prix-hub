---
// src/pages/circuits-live/city-guides/index.astro
import Layout from '@/layouts/Layout.astro';
import { cityGuidesData } from '@/data/cityGuides/index';
import type { CityGuide } from '@/data/types';

// Map F1 countries to regional filters
const regionMap: Record<string, string> = {
  'Australia': 'Asia-Pacific', 'China': 'Asia-Pacific', 'Japan': 'Asia-Pacific', 'Singapore': 'Asia-Pacific',
  'Bahrain': 'Middle East', 'Qatar': 'Middle East', 'United Arab Emirates': 'Middle East',
  'United States': 'Americas', 'Canada': 'Americas', 'Mexico': 'Americas', 'Brazil': 'Americas',
  'United Kingdom': 'Europe', 'Netherlands': 'Europe', 'Italy': 'Europe', 'Spain': 'Europe', 'Monaco': 'Europe',
  'Austria': 'Europe', 'Belgium': 'Europe', 'Hungary': 'Europe', 'Azerbaijan': 'Europe'
};

const cities = cityGuidesData.map(city => ({
  ...city,
  region: regionMap[city.country] || 'Other'
}));
---

<Layout 
  title="F1 Host City Guides & Fan Travel Hub | My Grand Prix Hub"
  description="Explore essential F1 host city travel guides. Discover where to stay, top sports pubs, non-clashing weekend itineraries, and fast circuit transit routes."
>
  <main class="page-container">
    
    <div class="header-container">
      <header class="section-header">
        <span class="badge">Trackside City Hubs</span>
        <h1 class="gradient-title">F1 Fan City Guides</h1>
        <p>Planning your Grand Prix trip? Discover the best base neighborhoods, evening dining, fan-favorite sports bars, and morning circuit transit.</p>
      </header>

      <!-- LIVE SEARCH BAR -->
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input 
          type="text" 
          id="city-search" 
          placeholder="Search by city, country, or race..." 
          autocomplete="off"
        />
      </div>
    </div>

    <!-- REGIONAL FILTER BAR -->
    <div class="publisher-filters" id="region-filters">
      <button class="filter-btn is-active" data-region="All">All Cities</button>
      <button class="filter-btn" data-region="Europe">Europe</button>
      <button class="filter-btn" data-region="Americas">Americas</button>
      <button class="filter-btn" data-region="Asia-Pacific">Asia-Pacific</button>
      <button class="filter-btn" data-region="Middle East">Middle East</button>
    </div>

    <!-- CITY CARDS GRID -->
    <div class="city-grid" id="city-grid">
      {cities.map((city) => (
        <article 
          class="city-card js-city-card"
          data-region={city.region}
          data-search={`${city.city.toLowerCase()} ${city.country.toLowerCase()} ${city.race.toLowerCase()} ${city.circuitName.toLowerCase()}`}
        >
          <div class="card-image-wrap">
            <img src={city.heroImage} alt={`${city.city} skyline`} loading="lazy" />
            <div class="card-overlay"></div>
            <span class="race-pill">🏎️ {city.race}</span>
          </div>

          <div class="card-content">
            <div class="card-meta">
              <span class="country-text">📍 {city.country}</span>
              <span class="commute-pill">⏱️ {city.trackCommuteSummary.time}</span>
            </div>

            <h2>{city.city}</h2>
            <p class="card-circuit">Base for <strong>{city.circuitName}</strong></p>
            <p class="card-intro">{city.intro}</p>

            <div class="card-highlights">
              <div class="highlight-item">
                <span class="hl-lbl">Top Airport:</span>
                <span class="hl-val">{city.quickFacts.airport.split('(')[0]}</span>
              </div>
              <div class="highlight-item">
                <span class="hl-lbl">Transit Method:</span>
                <span class="hl-val">{city.trackCommuteSummary.title.split('➔')[1] || 'Direct'}</span>
              </div>
            </div>

            <div class="card-actions">
              <a href={`/circuits-live/city-guides/${city.slug}`} class="btn-city-view">
                Explore {city.city} Guide &rarr;
              </a>
              <a href={`/travel-and-tickets/${city.raceSlug}`} class="btn-tickets-link" title="View Tickets & Travel">
                🎟️
              </a>
            </div>
          </div>
        </article>
      ))}
      
      <div id="no-results" class="empty-state hidden">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p>No city guides found matching your search.</p>
      </div>
    </div>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('city-search') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cityCards = document.querySelectorAll('.js-city-card');
    const noResults = document.getElementById('no-results');

    let currentSearch = '';
    let currentRegion = 'All';

    function updateGrid() {
      let visibleCount = 0;

      cityCards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const regionData = card.getAttribute('data-region') || '';
        
        const matchesSearch = searchData.includes(currentSearch);
        const matchesRegion = currentRegion === 'All' || regionData === currentRegion;

        if (matchesSearch && matchesRegion) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount !== 0);
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        updateGrid();
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentRegion = btn.getAttribute('data-region') || 'All';
        updateGrid();
      });
    });
  });
</script>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .section-header {
    max-width: 600px;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Live Search Bar */
  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 350px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
  }

  #city-search {
    width: 100%;
    background: #0f172a;
    border: 1px solid #334155;
    color: #ffffff;
    padding: 0.85rem 1rem 0.85rem 2.85rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  #city-search:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  /* Regional Filters */
  .publisher-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: #0f172a;
    border: 1px solid #334155;
    color: #94a3b8;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover {
    background: #1e293b;
    color: #cbd5e1;
  }

  .filter-btn.is-active {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #38bdf8;
  }

  /* City Grid */
  .city-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .city-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .city-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .card-image-wrap {
    position: relative;
    height: 190px;
    width: 100%;
    overflow: hidden;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .city-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, transparent 60%);
  }

  .race-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: #e10600;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .country-text {
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .commute-pill {
    background: #1e293b;
    border: 1px solid #334155;
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-content h2 {
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 0.25rem 0;
  }

  .card-circuit {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0 0 1rem 0;
  }

  .card-circuit strong {
    color: #cbd5e1;
  }

  .card-intro {
    color: #cbd5e1;
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-highlights {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .highlight-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed #334155;
  }

  .highlight-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .hl-lbl {
    font-size: 0.7rem;
    color: #64748b;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hl-val {
    font-size: 0.85rem;
    color: #f1f5f9;
    font-weight: 700;
    text-align: right;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-city-view {
    flex-grow: 1;
    text-align: center;
    background: #38bdf8;
    color: #0b0f19;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-city-view:hover {
    background: #7dd3fc;
  }

  .btn-tickets-link {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-tickets-link:hover {
    background: #e10600;
    border-color: #e10600;
  }

  /* Empty State */
  .empty-state {
    grid-column: 1 / -1;
    background: #1e293b;
    border: 1px dashed #475569;
    padding: 4rem 2rem;
    text-align: center;
    border-radius: 12px;
    color: #94a3b8;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .empty-state.hidden {
    display: none !important;
  }

  .empty-state p {
    margin: 0;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .search-wrapper {
      max-width: 100%;
    }
    
    .publisher-filters {
      overflow-x: auto;
      padding-bottom: 0.5rem;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    
    .filter-btn {
      white-space: nowrap;
    }
  }

  @media (max-width: 600px) {
    .gradient-title {
      font-size: 2.5rem;
    }
  }
</style>