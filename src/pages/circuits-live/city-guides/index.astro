---
// src/pages/circuits-live/city-guides/index.astro
import Layout from '@/layouts/Layout.astro';
import { cityGuidesData, type CityGuide } from '@/data/cityGuides';
---

<Layout 
  title="F1 Host City Guides & Fan Travel Hub | My Grand Prix Hub"
  description="Explore essential F1 host city travel guides. Discover where to stay, top sports pubs, non-clashing weekend itineraries, and fast circuit transit routes."
>
  <main class="page-container">
    
    <!-- HEADER -->
    <header class="hub-header">
      <span class="badge">Trackside City Hubs</span>
      <h1>F1 Fan City Guides</h1>
      <p class="subtitle">
        Planning your Grand Prix trip? Discover the best base neighborhoods, evening dining, fan-favorite sports bars, and morning circuit transit for every host city.
      </p>
    </header>

    <!-- CITY CARDS GRID -->
    <div class="city-grid">
      {cityGuidesData.map((city: CityGuide) => (
        <article class="city-card">
          <div class="card-image-wrap">
            <img src={city.heroImage} alt={`${city.city} skyline`} loading="lazy" />
            <div class="card-overlay"></div>
            <span class="race-pill">🏎️ {city.race}</span>
          </div>

          <div class="card-content">
            <div class="card-meta">
              <span class="country-text">📍 {city.country}</span>
              <span class="commute-pill">⏱️ {city.trackCommuteSummary.time}</span>
            </div>

            <h2>{city.city}</h2>
            <p class="card-circuit">Base for <strong>{city.circuitName}</strong></p>
            <p class="card-intro">{city.intro}</p>

            <div class="card-highlights">
              <div class="highlight-item">
                <span class="hl-lbl">Top Airport:</span>
                <span class="hl-val">{city.quickFacts.airport.split('(')[0]}</span>
              </div>
              <div class="highlight-item">
                <span class="hl-lbl">Transit Method:</span>
                <span class="hl-val">{city.trackCommuteSummary.title.split('➔')[1] || 'Direct'}</span>
              </div>
            </div>

            <div class="card-actions">
              <a href={`/circuits-live/city-guides/${city.slug}`} class="btn-city-view">
                Explore {city.city} Guide &rarr;
              </a>
              <a href={`/travel-and-tickets/${city.raceSlug}`} class="btn-tickets-link" title="View Tickets & Travel">
                🎟️
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </main>
</Layout>

<style>
  .page-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .hub-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .badge {
    display: inline-block;
    background: #e10600;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 4px;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .hub-header h1 {
    font-size: 3.25rem;
    margin: 0 0 0.75rem 0;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.15rem;
    margin: 0 auto;
    max-width: 680px;
    line-height: 1.6;
  }

  /* City Grid */
  .city-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .city-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .city-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .card-image-wrap {
    position: relative;
    height: 190px;
    width: 100%;
    overflow: hidden;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .city-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, transparent 60%);
  }

  .race-pill {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: #e10600;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .country-text {
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .commute-pill {
    background: #1e293b;
    border: 1px solid #334155;
    color: #38bdf8;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-content h2 {
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 0.25rem 0;
  }

  .card-circuit {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0 0 1rem 0;
  }

  .card-circuit strong {
    color: #cbd5e1;
  }

  /* Perfectly clamps the intro to 4 lines without cutting words */
  .card-intro {
    color: #cbd5e1;
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Swapped from Grid to a stacked layout */
  .card-highlights {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.85rem 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .highlight-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed #334155;
  }

  .highlight-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .hl-lbl {
    font-size: 0.7rem;
    color: #64748b;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap; /* Keeps label on one line */
  }

  .hl-val {
    font-size: 0.85rem;
    color: #f1f5f9;
    font-weight: 700;
    text-align: right;
    /* Removed white-space: nowrap so long airports can wrap nicely on the right side */
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-city-view {
    flex-grow: 1;
    text-align: center;
    background: #38bdf8;
    color: #0b0f19;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-city-view:hover {
    background: #7dd3fc;
  }

  .btn-tickets-link {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-tickets-link:hover {
    background: #e10600;
    border-color: #e10600;
  }

  @media (max-width: 600px) {
    .hub-header h1 {
      font-size: 2.4rem;
    }
  }
</style>