interface Sector { id: number; name: string; color: string; desc: string; }
interface Tyre { compound: string; type: string; borderColor: string; }
interface Grandstand { name: string; view: string; }
interface ScheduleItem { session: string; time: string; }
interface Winner { year: string; driver: string; team: string; }

interface CircuitProps {
  round: number;
  raceName: string;
  circuitName: string;
  location: string;
  lat: number;
  lon: number;
  flagCode: string;
  firstSessionDate: string;
  stats: { firstGP: number; laps: number; length: string; distance: string; corners: number; drsZones: number; };
  record: { time: string; driver: string; year: string; };
  description: string;
  sectors: Sector[];
  tyres: Tyre[];
  grandstands: Grandstand[];
  schedule: ScheduleItem[];
  pastWinners: Winner[];
  trackSvg: string;
}

const { round, raceName, circuitName, location, lat, lon, flagCode, firstSessionDate, stats, record, description, sectors, tyres, grandstands, schedule, pastWinners, trackSvg } = Astro.props as CircuitProps;

// 2. DYNAMIC PODIUM LOGIC
// Look through the TinaCMS seasonData to find who finished 1st, 2nd, and 3rd for this specific round!
let podium2026 = null;

if (seasonData && seasonData.drivers) {
  // Construct the string for the round key (e.g., "r12" or "r15")
  const roundKey = `r${round}`;
  
  // Find the drivers whose position for this round equals "1", "2", and "3"
  const p1Driver = seasonData.drivers.find((d: any) => String(d[roundKey]) === "1");
  const p2Driver = seasonData.drivers.find((d: any) => String(d[roundKey]) === "2");
  const p3Driver = seasonData.drivers.find((d: any) => String(d[roundKey]) === "3");

  // If all three exist, build the podium object for the HTML template to use
  if (p1Driver && p2Driver && p3Driver) {
    podium2026 = {
      // Extracts the last name (e.g. "Norris" from "Lando Norris") or defaults to driver code
      first: { 
        driver: p1Driver.name ? p1Driver.name.split(' ').pop() : p1Driver.code, 
        team: p1Driver.team || 'Unknown' 
      },
      second: { 
        driver: p2Driver.name ? p2Driver.name.split(' ').pop() : p2Driver.code, 
        team: p2Driver.team || 'Unknown' 
      },
      third: { 
        driver: p3Driver.name ? p3Driver.name.split(' ').pop() : p3Driver.code, 
        team: p3Driver.team || 'Unknown' 
      }
    };
  }
}
