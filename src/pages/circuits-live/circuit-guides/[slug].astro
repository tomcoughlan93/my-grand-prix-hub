  description={`Explore the ${circuitName} 2026 layout, weather, grandstands, tyres, and schedule.`}
>
  <main class="page-container circuit-guide">
    
    <header class="guide-header">
      <div class="title-wrapper">
        <img src={`https://flagcdn.com/w80/${flagCode}.png`} alt={location} class="title-flag" />
        <div>
          <span class="badge">2026 Circuit Guide</span>
          <h1>{circuitName}</h1>
          <p class="subtitle">{location} &bull; {raceName}</p>
        </div>
      </div>
    </header>

    <div class="countdown-card">
      <div class="countdown-header">
        {podium2026 ? (
          <>
            <span class="pulse-dot" style="background: #22c55e; box-shadow: 0 0 8px #22c55e; animation: none;"></span>
            <span>2026 Race Results</span>
          </>
        ) : (
          <>
            <span class="pulse-dot" id="pulse-dot"></span>
            <span id="countdown-title">Countdown to Practice 1</span>
          </>
        )}
      </div>
      
      {podium2026 ? (
        <div class="results-wrapper">
          <div class="podium-display">
            <div class="podium-box p2">
              <span class="pos">P2</span>
              <span class="name">{podium2026.second.driver}</span>
              <span class="team">{podium2026.second.team}</span>
            </div>
            <div class="podium-box p1">
              <span class="pos">P1</span>
              <span class="name">{podium2026.first.driver}</span>
              <span class="team">{podium2026.first.team}</span>
            </div>
            <div class="podium-box p3">
              <span class="pos">P3</span>
              <span class="name">{podium2026.third.driver}</span>
              <span class="team">{podium2026.third.team}</span>
            </div>
          </div>
        </div>
      ) : (
        <>
          <div class="timer-grid" id="f1-countdown" data-target={firstSessionDate} data-round={round}>
            <div class="time-box">
              <span class="time-val" id="cd-days">00</span>
              <span class="time-label">Days</span>
            </div>
            <div class="time-box">
              <span class="time-val" id="cd-hours">00</span>
              <span class="time-label">Hrs</span>
            </div>
            <div class="time-box">
              <span class="time-val" id="cd-mins">00</span>
              <span class="time-label">Min</span>
            </div>
            <div class="time-box">
              <span class="time-val" id="cd-secs">00</span>
              <span class="time-label">Sec</span>
            </div>
          </div>

          <!-- RESULTS FALLBACK BLOCK (Shown if timer hits 0 before CMS is updated) -->
          <div id="f1-results" class="results-wrapper" style="display: none;">
            <div id="awaiting-results" class="awaiting-state">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="spin-icon"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              <span>Awaiting Official FIA Results...</span>
            </div>
          </div>
        </>
      )}
    </div>

    <div class="guide-grid">
      
      <section class="map-section">
        <div class="info-card map-card">
          <div class="map-header">
            <h3>2026 Track Layout & Active Aero</h3>
          </div>
          
          <div class="svg-container">
            <div class="grid-overlay"></div>
            <!-- Render the dynamic SVG provided by the StaticPaths prop -->
            <div class="dynamic-svg-wrapper" set:html={trackSvg}></div>
          </div>
        </div>

        <div class="info-card">
          <h3>2026 Sector Breakdown</h3>
          <div class="sectors-list">
            {sectors.map((sector: Sector) => (
              <div class="sector-row">
                <div class="sector-badge" style={`background-color: ${sector.color}20; color: ${sector.color}; border: 1px solid ${sector.color}50;`}>
                  {sector.name}
                </div>
                <p>{sector.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="info-card">
          <h3>Grandstand & Seating Guide</h3>
          <div class="stand-list">
            {grandstands.map(stand => (
              <div class="stand-item">
                <strong>{stand.name}</strong>
                <p>{stand.view}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="info-card">
          <h3>Recent Winners</h3>
          <div class="winners-table">
            {pastWinners.map(w => (
              <div class="winner-row">
                <span class="win-year">{w.year}</span>
                <span class="win-driver">{w.driver}</span>
                <span class="win-team">{w.team}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Right Column: Stats, Weather, Tyres & Schedule -->
      <section class="info-section">
        
        <div class="info-card overview-card">
          <h3>Track Overview & History</h3>
          <p>{description}</p>
        </div>

        <!-- Dynamic Weather block relying on lat/lon -->
        <CircuitWeather lat={lat} lon={lon} locationName={circuitName} />

        <div class="info-card">
          <div class="card-header-flex">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
            <h3>Nominated Tyre Compounds</h3>
          </div>
          <div class="tyres-grid">
            {tyres.map(t => (
              <div class="tyre-card" style={`border-left: 4px solid ${t.borderColor};`}>
                <span class="tyre-comp">{t.compound}</span>
                <span class="tyre-type">{t.type}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-label">First Grand Prix</span>
            <span class="stat-val">{stats.firstGP}</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Number of Laps</span>
            <span class="stat-val">{stats.laps}</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Circuit Length</span>
            <span class="stat-val">{stats.length}</span>
          </div>
          <div class="stat-box">
            <span class="stat-label">Race Distance</span>
            <span class="stat-val">{stats.distance}</span>
          </div>
        </div>

        <div class="info-card record-card">
          <div class="card-header-flex">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e10600" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h3>Lap Record</h3>
          </div>
          <div class="record-data">
            <span class="record-time">{record.time}</span>
            <div class="record-meta">
              <span class="record-driver">{record.driver}</span>
              <span class="record-year">({record.year})</span>
            </div>
          </div>
        </div>

        <div class="info-card">
          <h3>Weekend Schedule</h3>
          <div class="schedule-list">
            {schedule.map(s => (
              <div class="sched-row">
                <span>{s.session}</span>
                <strong>{s.time}</strong>
              </div>
            ))}
          </div>
        </div>

      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  function initCountdown() {
    if (window.f1Interval) clearInterval(window.f1Interval);

    const timerElement = document.getElementById('f1-countdown');
    if (!timerElement) return;

    const targetDateStr = timerElement.getAttribute('data-target');
    if (!targetDateStr) return;

    const targetDate = new Date(targetDateStr).getTime();
    const resultsElement = document.getElementById('f1-results');
    const headerTitle = document.getElementById('countdown-title');
    const pulseDot = document.getElementById('pulse-dot');
    
    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minsEl = document.getElementById('cd-mins');
    const secsEl = document.getElementById('cd-secs');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = targetDate - now;

      // If Practice 1 has started, swap to Results view
      if (distance < 0) {
        clearInterval(window.f1Interval);
        
        if (timerElement) timerElement.style.display = 'none';
        if (resultsElement) resultsElement.style.display = 'block';
        if (headerTitle) headerTitle.innerText = 'Weekend Concluded';
        if (pulseDot) {
            pulseDot.style.background = '#334155';
            pulseDot.style.boxShadow = 'none';
            pulseDot.style.animation = 'none';
        }
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if(daysEl) daysEl.innerText = days.toString().padStart(2, '0');
      if(hoursEl) hoursEl.innerText = hours.toString().padStart(2, '0');
      if(minsEl) minsEl.innerText = minutes.toString().padStart(2, '0');
      if(secsEl) secsEl.innerText = seconds.toString().padStart(2, '0');
    };

    updateTimer(); 
    window.f1Interval = setInterval(updateTimer, 1000); 
  }

  document.addEventListener('DOMContentLoaded', initCountdown);
  document.addEventListener('astro:page-load', initCountdown);
</script>

<style>
