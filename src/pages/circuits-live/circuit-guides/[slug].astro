              </div>
            ))}
          </div>
        </div>

      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  function initCountdown() {
    const timerElement = document.getElementById('f1-countdown');
    if (!timerElement) return;

    const targetDateStr = timerElement.getAttribute('data-target');
    if (!targetDateStr) return;

    const targetDate = new Date(targetDateStr).getTime();
    
    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minsEl = document.getElementById('cd-mins');
    const secsEl = document.getElementById('cd-secs');

    const updateTimer = () => {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        if(daysEl) daysEl.innerText = "00";
        if(hoursEl) hoursEl.innerText = "00";
        if(minsEl) minsEl.innerText = "00";
        if(secsEl) secsEl.innerText = "00";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if(daysEl) daysEl.innerText = days.toString().padStart(2, '0');
      if(hoursEl) hoursEl.innerText = hours.toString().padStart(2, '0');
      if(minsEl) minsEl.innerText = minutes.toString().padStart(2, '0');
      if(secsEl) secsEl.innerText = seconds.toString().padStart(2, '0');
    };

    updateTimer(); 
    setInterval(updateTimer, 1000); 
  }

  document.addEventListener('DOMContentLoaded', initCountdown);
  document.addEventListener('astro:page-load', initCountdown);
</script>

