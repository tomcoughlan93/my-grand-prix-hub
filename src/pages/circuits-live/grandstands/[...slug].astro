---
// src/pages/circuits-live/grandstands/[slug].astro
import Layout from '@/layouts/Layout.astro';

export const prerender = true;

// --- DATA MODEL ---
// This acts as your database. You will add the full data for each stand here.
export function getStaticPaths() {
  return [
    {
      params: { slug: 'silverstone-becketts' },
      props: {
        circuit: 'Silverstone',
        name: 'Becketts',
        type: 'Grandstand',
        heroImage: 'https://images.unsplash.com/photo-1541348263662-e068f62f4558?q=80&w=1200&auto=format&fit=crop',
        description: 'Becketts is arguably the most famous grandstand in Formula 1. Positioned at the end of the Maggotts/Becketts complex, you get to witness the cars changing direction at mind-bending speeds before they blast down the Hangar Straight.',
        aggregatedScores: {
          overall: 4.8,
          sightline: 5.0,
          comfort: 4.0,
          value: 3.5
        },
        features: [
          { icon: '🌧️', text: 'Covered Seating' },
          { icon: '📺', text: 'Big Screen Visible' },
          { icon: '🏎️', text: 'High Speed Corner' },
          { icon: '🍔', text: 'Food Village Nearby' }
        ],
        pros: [
          'Unmatched view of F1 cars at peak aerodynamic performance.',
          'Covered roof protects from the unpredictable British weather.',
          'Direct line of sight to a large TV screen.'
        ],
        cons: [
          'One of the most expensive grandstands on the calendar.',
          'A very long walk from the main entrance gates.',
          'Bench seating can get uncomfortable after several hours.'
        ],
        reviews: [
          {
            author: 'F1Fan99',
            date: 'July 2025',
            rating: 5,
            text: 'Absolutely unbelievable view. You truly comprehend how fast these cars are when you sit here. Highly recommend bringing binoculars to see them enter from Copse. The food village right behind the stand is a lifesaver.'
          },
          {
            author: 'ApexHunter',
            date: 'July 2024',
            rating: 4.5,
            text: 'The view is 10/10. Docked half a star just because the walk from the parking lot took nearly 45 minutes in the mud. Make sure you wear comfortable shoes!'
          }
        ]
      }
    }
  ];
}

const { circuit, name, type, heroImage, description, aggregatedScores, features, pros, cons, reviews } = Astro.props;

// Helper to render stars
const renderStars = (rating: number) => {
  const rounded = Math.round(rating);
  return "★".repeat(rounded) + "☆".repeat(5 - rounded);
};

// Helper for progress bars (converts 0-5 score to percentage)
const getPercentage = (score: number) => {
  return `${(score / 5) * 100}%`;
};
---

<Layout 
  title={`${name} - ${circuit} View & Reviews | My Grand Prix Hub`}
  description={`Read fan reviews, check sightlines, and see photos from the ${name} ${type} at the ${circuit} Grand Prix.`}
>
  <main class="page-container">
    
    <!-- BACK LINK -->
    <a href="/circuits-live/grandstands" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to All Grandstands
    </a>

    <!-- HERO SECTION -->
    <div class="hero-grid">
      <div class="hero-image-wrap">
        <img src={heroImage} alt={`View from ${name}`} class="hero-image" />
        <span class={`type-badge ${type === 'Grandstand' ? 'badge-gs' : 'badge-ga'}`}>
          {type === 'Grandstand' ? 'Grandstand' : 'General Admission'}
        </span>
      </div>
      
      <div class="hero-info">
        <span class="circuit-tag">📍 {circuit}</span>
        <h1>{name}</h1>
        
        <div class="overall-rating-box">
          <div class="score-large">
            <span class="num">{aggregatedScores.overall.toFixed(1)}</span>
            <span class="max">/5</span>
          </div>
          <div class="score-meta">
            <span class="stars">{renderStars(aggregatedScores.overall)}</span>
            <span class="review-count">Based on {reviews.length} community reviews</span>
          </div>
        </div>

        <p class="description">{description}</p>
      </div>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="content-grid">
      
      <!-- LEFT COLUMN: Specifics & Reviews -->
      <div class="main-column">
        
        <!-- PROS & CONS -->
        <div class="panel pros-cons-panel">
          <div class="pc-column">
            <h3 class="pro-title"><span class="icon">✅</span> Fan Highlights</h3>
            <ul class="pc-list">
              {pros.map(pro => <li>{pro}</li>)}
            </ul>
          </div>
          <div class="divider"></div>
          <div class="pc-column">
            <h3 class="con-title"><span class="icon">❌</span> Things to Consider</h3>
            <ul class="pc-list">
              {cons.map(con => <li>{con}</li>)}
            </ul>
          </div>
        </div>

        <!-- REVIEWS FEED -->
        <div class="reviews-section">
          <div class="reviews-header">
            <h2>Community Reviews</h2>
            <a href="#submit-review" class="btn-outline">Add Your Review</a>
          </div>

          <div class="reviews-list">
            {reviews.map(review => (
              <div class="review-card">
                <div class="review-header">
                  <div class="reviewer-info">
                    <div class="avatar">{review.author.charAt(0)}</div>
                    <div>
                      <span class="author">{review.author}</span>
                      <span class="date">Attended {review.date}</span>
                    </div>
                  </div>
                  <div class="review-rating">
                    <span class="stars">{renderStars(review.rating)}</span>
                  </div>
                </div>
                <p class="review-text">"{review.text}"</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Scorecard & Features -->
      <aside class="sidebar">
        
        <!-- SCORECARD -->
        <div class="panel scorecard-panel">
          <h3>The Scorecard</h3>
          
          <div class="metric-row">
            <div class="metric-labels">
              <span>Sightline & Action</span>
              <span class="metric-num">{aggregatedScores.sightline.toFixed(1)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill fill-blue" style={`width: ${getPercentage(aggregatedScores.sightline)}`}></div>
            </div>
          </div>

          <div class="metric-row">
            <div class="metric-labels">
              <span>Seat Comfort</span>
              <span class="metric-num">{aggregatedScores.comfort.toFixed(1)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill fill-yellow" style={`width: ${getPercentage(aggregatedScores.comfort)}`}></div>
            </div>
          </div>

          <div class="metric-row">
            <div class="metric-labels">
              <span>Value for Money</span>
              <span class="metric-num">{aggregatedScores.value.toFixed(1)}</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill fill-green" style={`width: ${getPercentage(aggregatedScores.value)}`}></div>
            </div>
          </div>
        </div>

        <!-- KEY FEATURES -->
        <div class="panel features-panel">
          <h3>Key Features</h3>
          <div class="features-list">
            {features.map(f => (
              <div class="feature-item">
                <span class="f-icon">{f.icon}</span>
                <span class="f-text">{f.text}</span>
              </div>
            ))}
          </div>
        </div>

      </aside>
    </div>

  </main>
</Layout>

<style is:global>
  /* Base Layout */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #ffffff; }

  /* Hero Section */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
    align-items: center;
  }

  .hero-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #334155;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    letter-spacing: 0.05em;
    backdrop-filter: blur(4px);
  }
  .badge-gs { background: rgba(56, 189, 248, 0.9); color: #0f172a; }
  .badge-ga { background: rgba(167, 139, 250, 0.9); color: #0f172a; }

  .circuit-tag {
    color: #e10600;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 3.5rem;
    margin: 0 0 1.5rem 0;
    color: #ffffff;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .overall-rating-box {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: #1e293b;
    border: 1px solid #334155;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .score-large {
    display: flex;
    align-items: baseline;
  }
  .score-large .num { font-size: 3rem; font-weight: 900; color: #ffffff; line-height: 1; }
  .score-large .max { font-size: 1.2rem; color: #64748b; font-weight: 700; margin-left: 0.2rem; }

  .score-meta { display: flex; flex-direction: column; gap: 0.2rem; }
  .score-meta .stars { color: #facc15; font-size: 1.35rem; letter-spacing: 0.1em; }
  .review-count { color: #94a3b8; font-size: 0.85rem; font-weight: 600; }

  .description {
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Content Grid */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2.5rem;
    align-items: start;
  }

  .panel {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .panel h3 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 1.5rem 0;
  }

  /* Pros & Cons */
  .pros-cons-panel {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 2rem;
    padding: 0;
    overflow: hidden;
  }

  .pc-column { padding: 2rem; }
  .divider { background: #334155; width: 1px; height: 100%; }

  .pro-title { color: #34d399 !important; }
  .con-title { color: #f87171 !important; }

  .pc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pc-list li {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.5;
    position: relative;
    padding-left: 1.25rem;
  }
  .pc-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: #64748b;
  }

  /* Reviews */
  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .reviews-header h2 { color: #ffffff; font-size: 1.8rem; font-weight: 800; margin: 0; }
  
  .btn-outline {
    border: 2px solid #38bdf8;
    color: #38bdf8;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-weight: 800;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .btn-outline:hover { background: #38bdf8; color: #0f172a; }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .review-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .reviewer-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    width: 40px; height: 40px;
    background: #334155;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.2rem;
  }

  .author { display: block; color: #ffffff; font-weight: 700; font-size: 1rem; }
  .date { color: #64748b; font-size: 0.8rem; }
  
  .review-rating .stars { color: #facc15; font-size: 1.1rem; }

  .review-text {
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Scorecard */
  .metric-row { margin-bottom: 1.25rem; }
  .metric-row:last-child { margin-bottom: 0; }

  .metric-labels {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.5rem;
  }
  .metric-labels span { color: #e2e8f0; font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .metric-labels .metric-num { color: #ffffff; font-size: 1.2rem; font-weight: 900; }

  .progress-track {
    width: 100%;
    height: 8px;
    background: #0f172a;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #334155;
  }
  .progress-fill { height: 100%; border-radius: 4px; }
  .fill-blue { background: #38bdf8; }
  .fill-yellow { background: #facc15; }
  .fill-green { background: #34d399; }

  /* Key Features */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #0f172a;
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #334155;
  }
  .f-icon { font-size: 1.25rem; }
  .f-text { color: #ffffff; font-weight: 600; font-size: 0.95rem; }

  /* Responsiveness */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    h1 { font-size: 2.8rem; }
    .content-grid { grid-template-columns: 1fr; }
    .sidebar { order: -1; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .panel { margin-bottom: 0; }
    .pros-cons-panel { margin-top: 2.5rem; }
  }

  @media (max-width: 768px) {
    .sidebar { grid-template-columns: 1fr; }
    .pros-cons-panel { grid-template-columns: 1fr; }
    .divider { width: 100%; height: 1px; }
    .reviews-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
  }
</style>