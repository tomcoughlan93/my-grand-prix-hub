---
// src/pages/circuits-live/grandstands/index.astro
import Layout from '@/layouts/Layout.astro';

// --- DATA MODEL ---
const grandstands = [
  {
    slug: "silverstone-becketts",
    circuit: "Silverstone",
    name: "Becketts",
    type: "Grandstand",
    rating: 4.8,
    reviewCount: 14,
    image: "https://images.unsplash.com/photo-1541348263662-e068f62f4558?q=80&w=800&auto=format&fit=crop",
    features: [
      { icon: "🌧️", text: "Covered" },
      { icon: "📺", text: "Screen Visible" },
      { icon: "🏎️", text: "High Speed View" }
    ]
  },
  {
    slug: "silverstone-club",
    circuit: "Silverstone",
    name: "Club Corner",
    type: "Grandstand",
    rating: 4.9,
    reviewCount: 22,
    image: "https://images.unsplash.com/photo-1532906510137-12b260f8905b?q=80&w=800&auto=format&fit=crop",
    features: [
      { icon: "🌧️", text: "Covered" },
      { icon: "🏆", text: "Podium View" },
      { icon: "📺", text: "Screen Visible" }
    ]
  },
  {
    slug: "silverstone-vale-ga",
    circuit: "Silverstone",
    name: "Vale / Stowe",
    type: "General Admission",
    rating: 3.8,
    reviewCount: 31,
    image: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=800&auto=format&fit=crop",
    features: [
      { icon: "☀️", text: "Uncovered" },
      { icon: "🛑", text: "Heavy Braking" },
      { icon: "🍔", text: "Food Nearby" }
    ]
  },
  {
    slug: "zandvoort-tarzan",
    circuit: "Zandvoort",
    name: "Tarzan Incline",
    type: "Grandstand",
    rating: 4.5,
    reviewCount: 18,
    image: "https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=800&auto=format&fit=crop",
    features: [
      { icon: "☀️", text: "Uncovered" },
      { icon: "⚔️", text: "Action Spot" },
      { icon: "📺", text: "Screen Visible" }
    ]
  },
  {
    slug: "spa-kemmel-ga",
    circuit: "Spa-Francorchamps",
    name: "Kemmel Straight Bank",
    type: "General Admission",
    rating: 4.2,
    reviewCount: 45,
    image: "https://images.unsplash.com/photo-1517026575980-3e1e2dedeab4?q=80&w=800&auto=format&fit=crop",
    features: [
      { icon: "🌲", text: "Forest Setting" },
      { icon: "🪑", text: "Bring a Chair" },
      { icon: "🏎️", text: "High Speed View" }
    ]
  }
];

// Helper to render stars based on average rating
const renderStars = (rating: number) => {
  const rounded = Math.round(rating);
  return "★".repeat(rounded) + "☆".repeat(5 - rounded);
};

// Extract unique circuits for the filter buttons
const uniqueCircuits = ["All Tracks", ...new Set(grandstands.map(g => g.circuit))];
---

<Layout 
  title="Compare Grandstands & GA | My Grand Prix Hub"
  description="Compare Formula 1 grandstands and General Admission views side-by-side. Read fan reviews, check screen visibility, and find the best seats."
>
  <main class="page-container">
    
    <div class="header-container">
      <header class="section-header">
        <span class="badge">Trackside Spectator Hub</span>
        <h1 class="gradient-title">Compare Grandstands</h1>
        <p>Compare sightlines, cover, and aggregated fan ratings to find your perfect race weekend ticket.</p>
      </header>

      <!-- LIVE SEARCH BAR -->
      <div class="search-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input 
          type="text" 
          id="gs-search" 
          placeholder="Search tracks or grandstands..." 
          autocomplete="off"
        />
      </div>
    </div>

    <!-- DYNAMIC CIRCUIT FILTERS -->
    <div class="filter-row">
      <div class="filter-group" id="circuit-filters">
        {uniqueCircuits.map((circuit, index) => (
          <button class={`filter-btn ${index === 0 ? 'is-active' : ''}`} data-filter={circuit === 'All Tracks' ? 'All' : circuit}>
            {circuit}
          </button>
        ))}
      </div>
    </div>

    <!-- COMPARISON LIST HEADERS (Desktop Only) -->
    <!-- Switched to CSS Grid for perfect alignment -->
    <div class="list-headers">
      <div>View</div>
      <div>Grandstand & Track</div>
      <div>Fan Rating</div>
      <div>Key Features</div>
      <div style="text-align: right;"></div>
    </div>

    {grandstands.length === 0 ? (
      <div class="empty-state">
        <p>No seating data available yet.</p>
      </div>
    ) : (
      <div class="comparison-list" id="gs-list">
        {grandstands.map((stand) => (
          <article 
            class="list-row gs-row" 
            data-circuit={stand.circuit}
            data-search={`${stand.circuit.toLowerCase()} ${stand.name.toLowerCase()} ${stand.type.toLowerCase()}`}
          >
            <!-- Thumbnail -->
            <div class="row-cell">
              <div class="thumb-wrap">
                <img src={stand.image} alt={`View from ${stand.name}`} loading="lazy" />
              </div>
            </div>
            
            <!-- Info -->
            <div class="row-cell info-content">
              <span class={`type-pill ${stand.type === 'Grandstand' ? 'pill-gs' : 'pill-ga'}`}>
                {stand.type === 'Grandstand' ? 'Grandstand' : 'Gen. Admission'}
              </span>
              <h2>{stand.name}</h2>
              <span class="circuit-name">📍 {stand.circuit}</span>
            </div>

            <!-- Rating -->
            <div class="row-cell rating-block">
              <span class="rating-score">{stand.rating.toFixed(1)}</span>
              <div class="rating-details">
                <span class="stars">{renderStars(stand.rating)}</span>
                <span class="review-count">{stand.reviewCount} Reviews</span>
              </div>
            </div>

            <!-- Features -->
            <div class="row-cell features-grid">
              {stand.features.map(f => (
                <span class="feature-tag">
                  <span class="f-icon">{f.icon}</span> {f.text}
                </span>
              ))}
            </div>

            <!-- Action -->
            <div class="row-cell">
              <a href={`/circuits-live/grandstands/${stand.slug}`} class="btn-view">
                Read Reviews
              </a>
            </div>
          </article>
        ))}
        
        <div id="no-results" class="empty-state hidden">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <p>No seats found matching your search.</p>
        </div>
      </div>
    )}

    <!-- COMMUNITY CTA BANNER -->
    <section class="community-cta">
      <div class="cta-content">
        <div class="cta-text">
          <h2>Been to a race recently?</h2>
          <p>Help other fans pick the perfect ticket. Upload a photo from your view and rate your experience!</p>
        </div>
        <a href="mailto:submit@mygrandprixhub.com" class="btn-submit">Submit a POV</a>
      </div>
    </section>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('gs-search') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const gsRows = document.querySelectorAll('.gs-row');
    const noResults = document.getElementById('no-results');

    let currentFilter = 'All';
    let currentSearch = '';

    const renderList = () => {
      let visibleCount = 0;

      gsRows.forEach(row => {
        const circuit = row.getAttribute('data-circuit') || '';
        const searchData = row.getAttribute('data-search') || '';
        
        const matchesFilter = (currentFilter === 'All' || circuit === currentFilter);
        const matchesSearch = (currentSearch === '' || searchData.includes(currentSearch));

        if (matchesFilter && matchesSearch) {
          (row as HTMLElement).style.display = 'grid'; // Maintain grid display
          visibleCount++;
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount !== 0);
      }
    };

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentFilter = btn.getAttribute('data-filter') || 'All';
        renderList();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        renderList();
      });
    }
  });
</script>

<style is:global>
  /* Base Layout */
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .section-header { max-width: 600px; }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Search & Filters */
  .search-wrapper { position: relative; width: 100%; max-width: 350px; }
  .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #64748b; }
  #gs-search {
    width: 100%; background: #0f172a; border: 1px solid #334155; color: #ffffff;
    padding: 0.85rem 1rem 0.85rem 2.85rem; border-radius: 8px; font-size: 0.95rem; font-family: inherit;
    box-sizing: border-box; transition: border-color 0.2s, box-shadow 0.2s;
  }
  #gs-search:focus { outline: none; border-color: #e10600; box-shadow: 0 0 0 3px rgba(225, 6, 0, 0.15); }

  .filter-row { margin-bottom: 1.5rem; }
  .filter-group { 
    display: inline-flex; background: #0b0f19; border: 1px solid #334155; 
    border-radius: 9999px; padding: 0.35rem; gap: 0.25rem; flex-wrap: wrap;
  }
  .filter-btn { 
    background: transparent; border: none; color: #94a3b8; padding: 0.6rem 1.25rem; 
    border-radius: 9999px; font-size: 0.85rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.05em; cursor: pointer; transition: all 0.2s ease; 
  }
  .filter-btn:hover { color: #ffffff; }
  .filter-btn.is-active { background: #334155; color: #ffffff; }

  /* --- CSS GRID COMPARISON ARCHITECTURE --- */
  /* This ensures perfect vertical alignment between headers and rows */
  .list-headers {
    display: grid;
    /* Image (120px) | Info (1.5fr) | Rating (130px) | Features (2fr) | Button (140px) */
    grid-template-columns: 120px 1.5fr 130px 2fr 140px;
    gap: 2rem;
    padding: 0 1.5rem 0.75rem 1.5rem;
    border-bottom: 2px solid #334155;
    margin-bottom: 1rem;
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .list-row {
    display: grid;
    grid-template-columns: 120px 1.5fr 130px 2fr 140px;
    gap: 2rem;
    align-items: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .comparison-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 4rem;
  }

  .list-row:hover {
    transform: translateX(4px);
    border-color: #475569;
    background: #233044;
  }

  /* Thumbnail */
  .thumb-wrap {
    width: 120px; height: 80px;
    border-radius: 6px; overflow: hidden;
    background: #0f172a;
  }
  .thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }

  /* Info Column */
  .info-content { display: flex; flex-direction: column; align-items: flex-start; }
  
  .type-pill {
    font-size: 0.65rem; font-weight: 800; text-transform: uppercase;
    padding: 0.2rem 0.5rem; border-radius: 4px; letter-spacing: 0.05em; margin-bottom: 0.5rem;
  }
  .pill-gs { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .pill-ga { background: rgba(167, 139, 250, 0.15); color: #a78bfa; border: 1px solid rgba(167, 139, 250, 0.3); }

  .list-row h2 { font-size: 1.35rem; margin: 0 0 0.25rem 0; color: #ffffff; font-weight: 800; letter-spacing: -0.01em; }
  .circuit-name { color: #94a3b8; font-size: 0.9rem; font-weight: 600; }

  /* Rating Column */
  .rating-block { display: flex; align-items: center; gap: 0.75rem; }
  .rating-score { font-size: 2rem; font-weight: 900; color: #ffffff; line-height: 1; font-variant-numeric: tabular-nums;}
  .rating-details { display: flex; flex-direction: column; gap: 0.15rem; }
  .stars { color: #facc15; font-size: 1.1rem; line-height: 1;}
  .review-count { color: #64748b; font-size: 0.75rem; font-weight: 600; }

  /* Features Column */
  .features-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .feature-tag {
    background: #0f172a; border: 1px solid #334155; color: #cbd5e1;
    font-size: 0.8rem; font-weight: 600; padding: 0.35rem 0.6rem; border-radius: 6px;
    display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;
  }
  .f-icon { font-size: 0.9rem; }

  /* Action Column */
  .btn-view {
    display: inline-block; background: #ffffff; color: #0f172a;
    font-weight: 800; font-size: 0.9rem; padding: 0.75rem 1.25rem;
    border-radius: 6px; text-decoration: none; transition: background 0.2s;
    text-align: center; width: 100%; box-sizing: border-box;
  }
  .btn-view:hover { background: #cbd5e1; }

  /* CTA */
  .community-cta {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155; border-radius: 12px; padding: 2.5rem;
    position: relative; overflow: hidden;
  }
  .community-cta::before {
    content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #e10600;
  }
  .cta-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .cta-text h2 { color: #ffffff; font-size: 1.5rem; font-weight: 800; margin: 0 0 0.5rem 0; }
  .cta-text p { color: #94a3b8; margin: 0; font-size: 1rem; max-width: 600px; }
  .btn-submit {
    background: #e10600; color: #ffffff; font-weight: 800; padding: 0.85rem 1.5rem;
    border-radius: 6px; text-decoration: none; white-space: nowrap; transition: background 0.2s;
  }
  .btn-submit:hover { background: #ff1a1a; }

  .empty-state {
    background: #1e293b; border: 1px dashed #475569; padding: 4rem 2rem;
    text-align: center; border-radius: 12px; color: #94a3b8;
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
  }
  .empty-state.hidden { display: none !important; }

  /* Responsive Design - Safely collapses the grid into mobile cards */
  @media (max-width: 900px) {
    .list-headers { display: none; }
    
    .list-row {
      display: flex !important; /* Overrides the grid */
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 0;
      overflow: hidden;
    }

    .list-row:hover { transform: translateY(-4px); }

    .row-cell { width: 100%; padding: 0 1.5rem; }
    
    /* Target the first child (image) */
    .row-cell:first-child { padding: 0; }
    .thumb-wrap { width: 100%; height: 200px; border-radius: 0; border-bottom: 1px solid #334155; }
    
    /* Target the last child (button) */
    .row-cell:last-child { 
      background: rgba(15, 23, 42, 0.5); 
      border-top: 1px solid #334155;
      padding: 1.25rem 1.5rem;
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 768px) {
    .header-container { flex-direction: column; align-items: flex-start; }
    .search-wrapper { max-width: 100%; }
    .cta-content { flex-direction: column; align-items: flex-start; }
    .btn-submit { width: 100%; text-align: center; }
  }

  @media (max-width: 600px) {
    .gradient-title { font-size: 2.5rem; }
    .filter-group { width: 100%; justify-content: space-between; }
    .filter-btn { flex: 1; text-align: center; padding: 0.6rem 0.2rem; font-size: 0.7rem; }
  }
</style>