---
// src/pages/circuits-live/index.astro
import Layout from '@/layouts/Layout.astro';
import { circuitGuidesData } from '@/data/circuitGuides';
import { getCollection } from 'astro:content';

// 1. Circuits: Pull from your static data file
const circuitsCount = circuitGuidesData ? circuitGuidesData.length : 0;

// 2. Grandstands: Pull from your TinaCMS collection
const grandstands = (await getCollection('grandstands')) || [];
const grandstandsCount = grandstands.length;

// 3. City Guides: Exclude index, types, or template helper files from the count
const cityGuideFiles = import.meta.glob([
  '@/data/cityGuides/*.{ts,json,md}',
  '!@/data/cityGuides/index.*',
  '!@/data/cityGuides/types.*',
  '!@/data/cityGuides/_*'
]);

const cityGuidesCount = Object.keys(cityGuideFiles).length;
---

<Layout 
  title="Circuits & Live Experience | My Grand Prix Hub"
  description="Everything you need to plan your trackside Grand Prix weekend, from picking the best grandstand seats to exploring host cities."
>
  <main class="page-container">
    <header class="section-header">
      <span class="badge">Trackside Hub</span>
      <h1 class="gradient-title">Circuits & Live Experience</h1>
      <p>Everything you need to plan your trackside Grand Prix weekend, from picking the best grandstand seats to exploring host cities.</p>
    </header>

    <div class="hub-grid">
      <div class="hub-card">
        <div class="card-badge">🏎️ Track Profiles</div>
        <h2>F1 Circuit Guides</h2>
        <p>Detailed overviews of every circuit on the F1 calendar. Track specs, lap records, zone maps, and spectator advice.</p>
        <div class="card-meta">{circuitsCount} Circuit Guides Available</div>
        <a href="/circuits-live/circuit-guides" class="hub-btn primary-btn">Browse Circuit Guides →</a>
      </div>

      <div class="hub-card">
        <div class="card-badge">💺 Seating & Sightlines</div>
        <h2>Grandstand Reviews</h2>
        <p>Unbiased fan ratings for grandstand views, giant TV screen visibility, roof coverage, and seat comfort across global tracks.</p>
        <div class="card-meta">{grandstandsCount} Grandstand Reviews Published</div>
        <a href="/circuits-live/grandstands" class="hub-btn primary-btn">View Grandstand Reviews →</a>
      </div>

      <div class="hub-card">
        <div class="card-badge">📍 Trackside Cities</div>
        <h2>City & Fan Guides</h2>
        <p>Local spectator guides for Grand Prix host cities: fan zones, transport links, hotel districts, and sports bars showing live sessions.</p>
        <div class="card-meta">{cityGuidesCount} City Guides Available</div>
        <a href="/circuits-live/city-guides" class="hub-btn primary-btn">Explore City Guides →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem 1.5rem;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    margin: 0;
    max-width: 700px;
    line-height: 1.6;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .hub-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hub-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .card-badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .hub-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin: 0 0 1rem 0;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .hub-card p {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .card-meta {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #1e293b;
  }

  .hub-btn {
    display: block;
    text-align: center;
    padding: 0.85rem 1.5rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .primary-btn {
    background-color: transparent;
    border: 1px solid #334155;
    color: #ffffff;
  }

  .hub-card:hover .primary-btn {
    background-color: #e10600;
    border-color: #e10600;
  }

  @media (max-width: 768px) {
    .gradient-title { font-size: 2.75rem; }
    .hub-card { padding: 1.75rem; }
  }
</style>