---
// src/pages/circuits-live/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Safely retrieve collections with fallback defaults
const circuits = (await getCollection('circuits')) || [];
const grandstands = (await getCollection('grandstands')) || [];
const cityGuides = (await getCollection('cityGuides')) || [];
---

<Layout title="Circuits & Live Experience | My Grand Prix Hub">
  <main class="page-container">
    <header class="section-header">
      <span class="badge">Trackside Hub</span>
      <h1>Circuits & Live Experience</h1>
      <p>Everything you need to plan your trackside Grand Prix weekend, from picking the best grandstand seats to exploring host cities.</p>
    </header>

    <div class="hub-grid">
      <div class="hub-card">
        <div class="card-badge">🏎️ Track Profiles</div>
        <h2>F1 Circuit Guides</h2>
        <p>Detailed overviews of every circuit on the F1 calendar. Track specs, lap records, zone maps, and spectator advice.</p>
        <div class="card-meta">{circuits.length} Circuit Guides Available</div>
        <a href="/circuits-live/circuit-guides" class="hub-btn primary-btn">Browse Circuit Guides →</a>
      </div>

      <div class="hub-card">
        <div class="card-badge">💺 Seating & Sightlines</div>
        <h2>Grandstand Reviews</h2>
        <p>Unbiased fan ratings for grandstand views, giant TV screen visibility, roof coverage, and seat comfort across global tracks.</p>
        <div class="card-meta">{grandstands.length} Grandstand Reviews Published</div>
        <a href="/circuits-live/grandstands" class="hub-btn primary-btn">View Grandstand Reviews →</a>
      </div>

      <div class="hub-card">
        <div class="card-badge">📍 Trackside Cities</div>
        <h2>City & Fan Guides</h2>
        <p>Local spectator guides for Grand Prix host cities: fan zones, transport links, hotel districts, and sports bars showing live sessions.</p>
        <div class="card-meta">{cityGuides.length} City Guides Available</div>
        <a href="/circuits-live/city-guides" class="hub-btn primary-btn">Explore City Guides →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem 1.5rem;
    width: 100%;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: 2.75rem;
    margin: 0.75rem 0 0.5rem 0;
    font-weight: 800;
    color: #f8fafc;
  }

  .section-header p {
    color: #94a3b8;
    font-size: 1.15rem;
    margin: 0;
    max-width: 700px;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .hub-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: #38bdf8;
    margin-bottom: 0.75rem;
  }

  .hub-card h2 {
    font-size: 1.6rem;
    color: #f8fafc;
    margin: 0 0 0.75rem 0;
  }

  .hub-card p {
    color: #94a3b8;
    font-size: 0.98rem;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .card-meta {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .hub-btn {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    background-color: #e10600;
    color: #ffffff;
  }
</style>