---
// src/pages/submit-review.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Submit a Grandstand Review | My Grand Prix Hub"
  description="Help fellow F1 fans by sharing your trackside experience. Upload photos and review your grandstand seats."
>
  <main class="page-container">
    <div class="form-wrapper">
      <header class="form-header">
        <h1>Review Your Seat</h1>
        <p>Help the community by sharing your view, tips, and photos from your grandstand.</p>
      </header>

      <!-- Success State (Hidden by default) -->
      <div id="success-message" class="success-state hidden">
        <div class="success-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <h2>Review Submitted!</h2>
        <p>Thank you for helping the community. Your review and photos have been sent to our moderators and will be live on the circuit page soon.</p>
        <button class="btn-secondary mt-4" onclick="window.location.reload()">Submit Another</button>
      </div>

      <!-- The Form -->
      <form id="review-form" class="review-form">
        
        <!-- Section 1: Event Details -->
        <fieldset>
          <legend>Event Details</legend>
          <div class="form-grid">
            <div class="form-group">
              <label for="circuit">Circuit / Race *</label>
              <select id="circuit" name="circuit" required>
                <option value="" disabled selected>Select a race...</option>
                <option value="dutch">Dutch Grand Prix (Zandvoort)</option>
                <option value="british">British Grand Prix (Silverstone)</option>
                <option value="italian">Italian Grand Prix (Monza)</option>
                <option value="belgian">Belgian Grand Prix (Spa)</option>
                <option value="other">Other Circuit...</option>
              </select>
            </div>
            <div class="form-group">
              <label for="year">Year Attended *</label>
              <select id="year" name="year" required>
                <option value="2026">2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
                <option value="older">2023 or older</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Section 2: Seat Location -->
        <fieldset>
          <legend>Seat Location</legend>
          <div class="form-group">
            <label for="grandstand">Grandstand Name *</label>
            <input type="text" id="grandstand" name="grandstand" placeholder="e.g. Tarzan Incline, Becketts, etc." required />
          </div>
          
          <div class="form-grid-3">
            <div class="form-group">
              <label for="block">Block/Section</label>
              <input type="text" id="block" name="block" placeholder="e.g. Block A" />
            </div>
            <div class="form-group">
              <label for="row">Row</label>
              <input type="text" id="row" name="row" placeholder="e.g. 14" />
            </div>
            <div class="form-group">
              <label for="seat">Seat</label>
              <input type="text" id="seat" name="seat" placeholder="e.g. 102" />
            </div>
          </div>
          <p class="field-hint">Seat details are optional but really help fans gauge the exact view!</p>
        </fieldset>

        <!-- Section 3: The Review -->
        <fieldset>
          <legend>Your Review</legend>
          
          <div class="form-group">
            <label>Overall Rating *</label>
            <div class="star-rating">
              <input type="radio" id="star5" name="rating" value="5" required /><label for="star5" title="5 stars">★</label>
              <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 stars">★</label>
              <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 stars">★</label>
              <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 stars">★</label>
              <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 star">★</label>
            </div>
          </div>

          <div class="form-group">
            <label for="review">What was the view like? *</label>
            <textarea id="review" name="review" rows="4" placeholder="Could you see a screen? Was there overtaking? Did you get wet if it rained?" required></textarea>
          </div>

          <div class="form-group">
            <label class="file-upload-label">
              <span class="upload-title">Upload a View Photo</span>
              <span class="upload-subtitle">JPG or PNG, max 5MB</span>
              <input type="file" id="photo" name="photo" accept="image/png, image/jpeg" class="file-input" />
            </label>
          </div>
        </fieldset>

        <!-- Section 4: Submitter -->
        <fieldset>
          <legend>About You</legend>
          <div class="form-group">
            <label for="username">Fan Name / Handle *</label>
            <input type="text" id="username" name="username" placeholder="How should we credit you?" required />
          </div>
        </fieldset>

        <button type="submit" id="submit-btn" class="btn-primary submit-btn">
          <span>Submit Review</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('review-form');
    const successMsg = document.getElementById('success-message');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault(); // Stop page reload
        
        // Change button state
        submitBtn.innerHTML = 'Uploading...';
        submitBtn.style.opacity = '0.7';
        submitBtn.disabled = true;

        // Simulate a network request (2 seconds)
        setTimeout(() => {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 1500);
      });
    }
  });
</script>

<style>
  .page-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .form-wrapper {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .form-header h1 {
    font-size: 2.5rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
  }

  .form-header p {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
  }

  legend {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    border-bottom: 2px solid #334155;
    width: 100%;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  label {
    color: #cbd5e1;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .field-hint {
    color: #64748b;
    font-size: 0.85rem;
    margin-top: -1rem;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  input[type="text"],
  select,
  textarea {
    background: #0f172a;
    border: 1px solid #334155;
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Star Rating CSS Hack */
  .star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  .star-rating input {
    display: none;
  }

  .star-rating label {
    font-size: 2rem;
    color: #334155;
    cursor: pointer;
    transition: color 0.2s;
    margin: 0;
  }

  .star-rating input:checked ~ label,
  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: #fbbf24; /* F1/Star Yellow */
  }

  /* File Upload Styling */
  .file-upload-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0f172a;
    border: 2px dashed #475569;
    border-radius: 8px;
    padding: 2rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .file-upload-label:hover {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.05);
  }

  .upload-title {
    color: #38bdf8;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .upload-subtitle {
    color: #64748b;
    font-size: 0.85rem;
    font-weight: normal;
  }

  .file-input {
    display: none;
  }

  .submit-btn {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    background: #e10600;
    color: #ffffff;
    border: none;
    padding: 1rem;
    border-radius: 6px;
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .submit-btn:hover {
    background: #ff1e16;
    transform: translateY(-2px);
  }

  /* Success State */
  .hidden {
    display: none !important;
  }

  .success-state {
    text-align: center;
    padding: 3rem 1rem;
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: rgba(16, 185, 129, 0.1);
    border-radius: 50%;
    margin-bottom: 1.5rem;
  }

  .success-state h2 {
    color: #ffffff;
    font-size: 2rem;
    margin: 0 0 1rem 0;
  }

  .success-state p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .btn-secondary {
    background: transparent;
    color: #38bdf8;
    border: 1px solid #38bdf8;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: #38bdf8;
    color: #0f172a;
  }

  /* Mobile Adjustments */
  @media (max-width: 640px) {
    .form-wrapper {
      padding: 1.5rem;
    }
    
    .form-grid, .form-grid-3 {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>