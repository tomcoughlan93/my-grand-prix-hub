---
// src/pages/circuits/[...slug].astro
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allCircuits = await getCollection('circuits');
  return allCircuits.map((entry: CollectionEntry<'circuits'>) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, "").toLowerCase() },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'circuits'>;
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<BaseLayout title={entry.data?.title || 'Circuit Guide'}>
  <article style="max-width: 800px; margin: 0 auto; padding: 1rem 0;">
    {entry.data?.heroImage && (
      <img 
        src={entry.data.heroImage} 
        alt={entry.data.title || ''} 
        style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 1.5rem;" 
      />
    )}
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">{entry.data?.title}</h1>
    {entry.data?.country && (
      <p style="color: #666; font-size: 1.1rem; margin-bottom: 1.5rem;">📍 {entry.data.country}</p>
    )}
    <hr style="border: 0; border-top: 1px solid #eee; margin: 2rem 0;" />
    
    <div style="line-height: 1.7; font-size: 1.1rem;">
      <Content />
    </div>
  </article>
</BaseLayout>