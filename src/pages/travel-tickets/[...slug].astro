---
// src/pages/travel-tickets/[...slug].astro
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allGuides = await getCollection('travelTickets');
  return allGuides.map((entry: CollectionEntry<'travelTickets'>) => ({
    params: { slug: entry.id.replace(/\.[^/.]+$/, "").toLowerCase() },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'travelTickets'>;
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
---

<BaseLayout title={entry.data?.title ? `${entry.data.title} | Travel & Ticket Advice` : 'Travel & Ticket Advice'}>
  <article style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    {entry.data?.heroImage && (
      <img 
        src={entry.data.heroImage} 
        alt={entry.data.title || ''} 
        style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 1.5rem;" 
      />
    )}
    
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; color: #111;">{entry.data?.title}</h1>
    
    {entry.data?.category && (
      <div style="margin-bottom: 1.5rem; font-size: 1rem; color: #555;">
        <span style="background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; font-weight: 600; color: #e10600; text-transform: uppercase; font-size: 0.85rem;">
          ✈️ {entry.data.category}
        </span>
      </div>
    )}

    <hr style="border: 0; border-top: 1px solid #eee; margin: 2rem 0;" />
    
    <div style="line-height: 1.7; font-size: 1.1rem;">
      <Content />
    </div>
  </article>
</BaseLayout>