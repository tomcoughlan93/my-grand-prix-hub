---
import Layout from '@/layouts/Layout.astro';
import seasonData from '@/content/results/season-2026.json';
import Parser from 'rss-parser';
import { TEAMS } from '@/data/teams';
import { getEntry } from 'astro:content';

// --- RSS PARSER SETUP ---
interface CustomFeedItem {
  mediaContent?: any;
  mediaThumbnail?: any;
  enclosure?: { url?: string };
  contentEncoded?: string;
  description?: string;
  content?: string;
  summary?: string;
  contentSnippet?: string;
  title?: string;
  link?: string;
  pubDate?: string;
  image?: any;
}

const parser: Parser<{}, CustomFeedItem> = new Parser({
  customFields: {
    item: [
      ['media:content', 'mediaContent', { keepArray: true }],
      ['media:thumbnail', 'mediaThumbnail', { keepArray: true }],
      ['media:group', 'mediaGroup', { keepArray: true }],
      ['content:encoded', 'contentEncoded'],
      ['description', 'description'],
      ['image', 'image']
    ],
  },
});

const VERIFIED_FEEDS = [
  { name: 'BBC Sport F1', url: 'https://feeds.bbci.co.uk/sport/formula1/rss.xml' },
  { name: 'Autosport', url: 'https://www.autosport.com/rss/f1/news/' },
  { name: 'Motorsport.com', url: 'https://www.motorsport.com/rss/f1/news/' },
  { name: 'RacingNews365', url: 'https://racingnews365.com/feed/news.xml' },
  { name: 'Crash.net F1', url: 'https://www.crash.net/rss/f1' },
];

function cleanSnippet(str?: string): string {
  if (!str) return '';
  const text = str.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&#039;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/\s+/g, ' ').trim();
  return text.length > 130 ? text.substring(0, 127) + '...' : text;
}

function extractImage(item: CustomFeedItem, sourceName: string): string | undefined {
  let url: string | undefined = undefined;
  if (item.enclosure && item.enclosure.url) url = item.enclosure.url;
  if (!url && item.mediaContent && Array.isArray(item.mediaContent)) {
    const found = item.mediaContent.find((m: any) => m.$?.url || m.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && item.mediaThumbnail && Array.isArray(item.mediaThumbnail)) {
    const found = item.mediaThumbnail.find((t: any) => t.$?.url || t.url);
    if (found) url = found.$?.url || found.url;
  }
  if (!url && (item as any).mediaGroup && Array.isArray((item as any).mediaGroup)) {
    const group = (item as any).mediaGroup[0];
    if (group && group['media:content'] && Array.isArray(group['media:content'])) {
      const found = group['media:content'].find((m: any) => m.$?.url || m.url);
      if (found) url = found.$?.url || found.url;
    }
  }
  if (!url && item.image) {
    if (typeof item.image === 'string') url = item.image;
    else if (item.image.url) url = item.image.url;
    else if (item.image.$ && item.image.$.url) url = item.image.$.url;
  }
  if (!url) {
    const htmlString = [item.contentEncoded, item.content, item.summary, item.description, item.contentSnippet].filter(Boolean).join(' ');
    const dataSrcMatch = htmlString.match(/<img[^>]+data-src\s*=\s*["']([^"']+)["']/i);
    if (dataSrcMatch && dataSrcMatch[1]) url = dataSrcMatch[1];
    else {
      const srcMatch = htmlString.match(/<img[^>]+src\s*=\s*["']([^"']+)["']/i);
      if (srcMatch && srcMatch[1]) url = srcMatch[1];
    }
  }
  if (!url) {
    const itemStr = JSON.stringify(item);
    const regex = /(https?:\/\/[^"'\s>]+?\.(?:jpg|jpeg|png|webp)(?:\?[^"'\s>]*)?)/i;
    const match = itemStr.match(regex);
    if (match && match[1]) url = match[1];
  }
  if (!url) return undefined;
  if (sourceName === 'BBC Sport F1') url = url.replace(/\/\d+x\d+\//g, '/976x549/').replace(/\/p\d+\//g, '/p0976/').replace(/\/(144|240|320|480)\//g, '/976/');
  return url;
}

export async function getStaticPaths() {
  return TEAMS.map(team => ({
    params: { slug: team.slug },
    props: { team, allTeams: TEAMS },
  }));
}

const { team, allTeams } = Astro.props;

// --- 1. FETCH LIVE STATS FROM CMS ---
let cmsStats = null;
try {
  cmsStats = await getEntry('teamStats', team.slug);
} catch (e) {
  console.log("Could not find CMS stats for", team.slug);
}

// Fallback to the hardcoded TS file if the CMS file is missing
const poles = cmsStats?.data?.poles ?? team.history.poles;
const fastestLaps = cmsStats?.data?.fastestLaps ?? team.history.fastestLaps;
const championships = cmsStats?.data?.championships ?? team.history.championships;

// --- 2. FETCH LIVE API DATA FOR POINTS ---
let teamPoints = 0;
let teamWins = 0;
let teamPos = '--';
let d1Points = 0;
let d2Points = 0;

try {
  const [driverRes, constrRes] = await Promise.all([
    fetch('https://api.jolpi.ca/ergast/f1/current/driverStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
    fetch('https://api.jolpi.ca/ergast/f1/current/constructorStandings.json', { headers: { 'User-Agent': 'Mozilla/5.0' } }),
  ]);

  if (constrRes.ok) {
    const cData = await constrRes.json();
    const cList = cData?.MRData?.StandingsTable?.StandingsLists?.[0]?.ConstructorStandings || [];
    const matchedTeam = cList.find((c: any) => c.Constructor.constructorId.toLowerCase().includes(team.key.replace('racingbulls', 'rb')));
    if (matchedTeam) {
      teamPoints = parseFloat(matchedTeam.points) || 0;
      teamWins = parseInt(matchedTeam.wins) || 0;
      teamPos = matchedTeam.position;
    }
  }

  if (driverRes.ok) {
    const dData = await driverRes.json();
    const dList = dData?.MRData?.StandingsTable?.StandingsLists?.[0]?.DriverStandings || [];
    const matchedD1 = dList.find((d: any) => d.Driver.code === team.d1 || d.Driver.familyName.substring(0,3).toUpperCase() === team.d1);
    const matchedD2 = dList.find((d: any) => d.Driver.code === team.d2 || d.Driver.familyName.substring(0,3).toUpperCase() === team.d2);
    if (matchedD1) d1Points = parseFloat(matchedD1.points) || 0;
    if (matchedD2) d2Points = parseFloat(matchedD2.points) || 0;
  }
} catch (e) {}

const calcTotal = d1Points + d2Points;
const displayTotal = Math.max(teamPoints, calcTotal);
const d1Pct = displayTotal > 0 ? Math.round((d1Points / displayTotal) * 100) : 50;
const d2Pct = displayTotal > 0 ? Math.round((d2Points / displayTotal) * 100) : 50;

// --- 3. CALCULATE HEAD-TO-HEAD FROM LOCAL JSON ---
let d1Ahead = 0;
let d2Ahead = 0;
let d1Best = 99;
let d2Best = 99;

const d1Season: (string | number)[] = Array(23).fill('-');
const d2Season: (string | number)[] = Array(23).fill('-');

if (seasonData && seasonData.drivers) {
  const d1Row: any = seasonData.drivers.find((d: any) => d.code === team.d1);
  const d2Row: any = seasonData.drivers.find((d: any) => d.code === team.d2);

  for (let i = 1; i <= 23; i++) {
    const rKey = `r${i}`;
    let val1 = (d1Row && d1Row[rKey] !== undefined) ? String(d1Row[rKey]).trim().toUpperCase() : '-';
    let val2 = (d2Row && d2Row[rKey] !== undefined) ? String(d2Row[rKey]).trim().toUpperCase() : '-';

    if (val1 === 'DNF' || val1 === 'DSQ') val1 = 'RET';
    if (val2 === 'DNF' || val2 === 'DSQ') val2 = 'RET';
    if (val1 === '') val1 = '-';
    if (val2 === '') val2 = '-';

    const num1 = parseInt(val1, 10);
    const num2 = parseInt(val2, 10);

    d1Season[i-1] = isNaN(num1) ? val1 : num1;
    d2Season[i-1] = isNaN(num2) ? val2 : num2;

    if (!isNaN(num1) && !isNaN(num2)) {
      if (num1 < num2) d1Ahead++;
      if (num2 < num1) d2Ahead++;
    }

    if (!isNaN(num1) && num1 < d1Best) d1Best = num1;
    if (!isNaN(num2) && num2 < d2Best) d2Best = num2;
  }
}

function getFormBadgeClass(result: number | string): string {
  const resStr = String(result).toUpperCase().trim();
  if (resStr === 'RET') return 'badge-ret';
  if (resStr === 'DNS' || resStr === 'DSQ') return 'badge-dns';
  if (resStr === '-' || resStr === '') return 'badge-dnp';
  const num = parseInt(resStr, 10);
  if (!isNaN(num)) {
    if (num === 1) return 'badge-p1';
    if (num === 2) return 'badge-p2';
    if (num === 3) return 'badge-p3';
    if (num <= 10) return 'badge-points';
  }
  return 'badge-out';
}

const ROUND_DATA = [
  { round: 1, name: 'AUS', flag: 'au' }, { round: 2, name: 'CHN', flag: 'cn' }, { round: 3, name: 'JPN', flag: 'jp' },
  { round: 4, name: 'MIA', flag: 'us' }, { round: 5, name: 'CAN', flag: 'ca' }, { round: 6, name: 'MON', flag: 'mc' },
  { round: 7, name: 'ESP', flag: 'es' }, { round: 8, name: 'AUT', flag: 'at' }, { round: 9, name: 'GBR', flag: 'gb' },
  { round: 10, name: 'BEL', flag: 'be' }, { round: 11, name: 'HUN', flag: 'hu' }, { round: 12, name: 'NED', flag: 'nl' },
  { round: 13, name: 'ITA', flag: 'it' }, { round: 14, name: 'MAD', flag: 'es' }, { round: 15, name: 'AZE', flag: 'az' },
  { round: 16, name: 'BHR', flag: 'bh' }, { round: 17, name: 'SIN', flag: 'sg' }, { round: 18, name: 'USA', flag: 'us' },
  { round: 19, name: 'MEX', flag: 'mx' }, { round: 20, name: 'SAP', flag: 'br' }, { round: 21, name: 'LVG', flag: 'us' },
  { round: 22, name: 'QAT', flag: 'qa' }, { round: 23, name: 'ABU', flag: 'ae' }
];

// --- 4. FETCH & FILTER RSS NEWS ---
let teamNews: any[] = [];
try {
  const feedPromises = VERIFIED_FEEDS.map(async (src) => {
    try {
      const feed = await parser.parseURL(src.url);
      const validItems = [];
      for (const item of feed.items || []) {
        const hasValidDate = item.pubDate && !isNaN(new Date(item.pubDate).getTime());
        if (!hasValidDate) continue;

        const imageUrl = extractImage(item, src.name);
        if (src.name === 'RacingNews365' && !imageUrl) continue;

        const rawDescription = item.contentEncoded || item.content || item.summary || item.description || item.contentSnippet || '';
        validItems.push({
          title: item.title || 'F1 News Headline',
          link: item.link || '#',
          pubDateStr: new Date(item.pubDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
          source: src.name,
          snippet: cleanSnippet(rawDescription),
          imageUrl: imageUrl || null,
          timestamp: new Date(item.pubDate!).getTime(),
        });
      }
      return validItems;
    } catch (err) { return []; }
  });

  const rssResults = await Promise.all(feedPromises);
  const globalRssFeed = rssResults.flat().sort((a, b) => b.timestamp - a.timestamp);

  const escapeRegExp = (str: string) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const teamSearchProfiles = (allTeams || []).map((t: any) => {
    const kws = [ t.name, t.shortName, t.chassis, t.principal, t.d1Name, t.d1Last, t.d2Name, t.d2Last, ...(t.aliases || []) ].filter(Boolean);
    return { key: t.key, regex: new RegExp(`\\b(${kws.map(escapeRegExp).join('|')})\\b`, 'i') };
  });

  const matchedNews = globalRssFeed.filter((article: any) => {
    let earliestIndexTitle = Infinity;
    let primaryTeamTitle = null;
    let earliestIndexSnippet = Infinity;
    let primaryTeamSnippet = null;

    teamSearchProfiles.forEach((profile: any) => {
      const matchTitle = article.title.match(profile.regex);
      if (matchTitle && matchTitle.index !== undefined && matchTitle.index < earliestIndexTitle) {
        earliestIndexTitle = matchTitle.index;
        primaryTeamTitle = profile.key;
      }
      const matchSnippet = article.snippet.match(profile.regex);
      if (matchSnippet && matchSnippet.index !== undefined && matchSnippet.index < earliestIndexSnippet) {
        earliestIndexSnippet = matchSnippet.index;
        primaryTeamSnippet = profile.key;
      }
    });

    const primaryTeam = primaryTeamTitle || primaryTeamSnippet;
    return primaryTeam === team.key;
  });

  teamNews = matchedNews.slice(0, 3);
} catch (e) {}
---

<Layout 
  title={`${team.name} | Team Profile | My Grand Prix Hub`}
  description={`2026 stats, head-to-head driver comparisons, and season form guide for ${team.name}.`}
>
  <main class="team-profile-container">
    
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav">
      <a href="/championship/teams-drivers">Directory</a>
      <span class="sep">/</span>
      <span class="current">{team.shortName}</span>
    </nav>

    <!-- Typography & Color Hero -->
    <header class="team-hero" style={`--team-accent: ${team.color};`}>
      <div class="hero-glow"></div>
      <span class="hero-chassis-bg">{team.chassis}</span>

      <div class="hero-content">
        <div class="hero-title-row">
          <div class="title-stack">
            <div class="badge-row">
              <span class="team-badge">Constructor Profile</span>
              <div class="social-links">
                {team.socials.website && <a href={team.socials.website} target="_blank" rel="noopener noreferrer" title="Official Website">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                </a>}
                {team.socials.x && <a href={team.socials.x} target="_blank" rel="noopener noreferrer" title="X (Twitter)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>}
                {team.socials.instagram && <a href={team.socials.instagram} target="_blank" rel="noopener noreferrer" title="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>}
              </div>
            </div>
            <h1>{team.name}</h1>
            {team.bio && <p class="team-bio-text">{team.bio}</p>}
          </div>
        </div>

        <div class="season-stats-strip">
          <div class="stat-card">
            <span class="stat-label">2026 Standing</span>
            <div class="stat-val-group">
              <span class="stat-val">{teamPos !== '--' ? `P${teamPos}` : '--'}</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Total Points</span>
            <div class="stat-val-group">
              <span class="stat-val">{displayTotal}</span>
              <span class="stat-sub">PTS</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-label">Race Wins</span>
            <div class="stat-val-group">
              <span class="stat-val">{teamWins}</span>
            </div>
          </div>
          <div class="stat-card technical-card">
            <span class="stat-label">Power Unit</span>
            <span class="tech-val">{team.pu}</span>
          </div>
          <div class="stat-card technical-card">
            <span class="stat-label">Base</span>
            <span class="tech-val">{team.base}</span>
          </div>
          <div class="stat-card technical-card">
            <span class="stat-label">Principal</span>
            <span class="tech-val">{team.principal}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Typography Driver Cards -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>2026 Driver Lineup</h2>
        <span class="section-badge">The Roster</span>
      </div>

      <div class="driver-cards-grid">
        <a href={`/drivers/${team.d1Slug}`} class="typo-driver-card" style={`--accent: ${team.color}`}>
          <div class={`driver-bg-number ${team.d1Number < 10 ? 'single-digit' : ''}`}>{team.d1Number}</div>
          <div class="driver-card-content">
            <div class="d-info-top">
              <span class="d-tag">{team.d1}</span>
            </div>
            <div class="d-info-bottom">
              <h3>{team.d1Name}</h3>
              <span class="view-profile-btn">View Driver Profile →</span>
            </div>
          </div>
        </a>

        <a href={`/drivers/${team.d2Slug}`} class="typo-driver-card" style={`--accent: ${team.color}`}>
          <div class={`driver-bg-number ${team.d2Number < 10 ? 'single-digit' : ''}`}>{team.d2Number}</div>
          <div class="driver-card-content">
            <div class="d-info-top">
              <span class="d-tag">{team.d2}</span>
            </div>
            <div class="d-info-bottom">
              <h3>{team.d2Name}</h3>
              <span class="view-profile-btn">View Driver Profile →</span>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Head-to-Head -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>Driver Head-to-Head</h2>
        <span class="section-badge">Intra-Team Battle</span>
      </div>

      <div class="h2h-container">
        <div class="points-split-wrapper">
          <div class="points-split-header">
            <span class="d-label d1-label">{team.d1} <span class="pts-count">({d1Points} pts)</span></span>
            <span class="split-title">Points Contribution</span>
            <span class="d-label d2-label"><span class="pts-count">({d2Points} pts)</span> {team.d2}</span>
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-d1" style={`width: ${d1Pct}%; background-color: ${team.color};`}>
              {d1Pct > 15 ? <span class="pct-text">{d1Pct}%</span> : ''}
            </div>
            <div class="progress-bar-d2" style={`width: ${d2Pct}%;`}>
              {d2Pct > 15 ? <span class="pct-text">{d2Pct}%</span> : ''}
            </div>
          </div>
        </div>

        <div class="h2h-scorecard">
          <div class="score-row headers-row">
            <div class="score-col score-header">{team.d1}</div>
            <div class="score-col metric-col">Metric</div>
            <div class="score-col score-header">{team.d2}</div>
          </div>
          <div class="score-row">
            <div class="score-col score-val">{d1Ahead}</div>
            <div class="score-col score-metric">Races Finished Ahead</div>
            <div class="score-col score-val">{d2Ahead}</div>
          </div>
          <div class="score-row border-none">
            <div class="score-col score-val">{d1Best === 99 ? '-' : `P${d1Best}`}</div>
            <div class="score-col score-metric">Best Race Result</div>
            <div class="score-col score-val">{d2Best === 99 ? '-' : `P${d2Best}`}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dual Driver Timeline -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>2026 Season Results</h2>
        <span class="section-badge">Team Form Guide</span>
      </div>
      
      <div class="timeline-card">
        <div class="timeline-scroll-wrapper">
          <div class="timeline-flex-table">
            <div class="t-row header-row">
              <div class="t-fixed-col"></div>
              <div class="t-scroll-cols">
                {ROUND_DATA.map((race) => (
                  <div class="t-col">
                    <img src={`https://flagcdn.com/w20/${race.flag}.png`} alt={race.name} class="race-card-flag" loading="lazy" />
                    <span class="race-round">{race.name}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="t-row d-row">
              <div class="t-fixed-col"><span class="d-code-tag">{team.d1}</span></div>
              <div class="t-scroll-cols">
                {d1Season.map((res) => (<div class="t-col"><span class={`form-circle ${getFormBadgeClass(res)}`}>{res}</span></div>))}
              </div>
            </div>
            <div class="t-row d-row border-none" style="padding-bottom: 0;">
              <div class="t-fixed-col"><span class="d-code-tag">{team.d2}</span></div>
              <div class="t-scroll-cols">
                {d2Season.map((res) => (<div class="t-col"><span class={`form-circle ${getFormBadgeClass(res)}`}>{res}</span></div>))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Historical Legacy -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>Team Legacy</h2>
        <span class="section-badge">Historical Records</span>
      </div>
      
      <div class="history-grid">
        <div class="history-card">
          <span class="h-label">World Championships</span>
          <span class="h-val">{championships}</span>
        </div>
        <div class="history-card">
          <span class="h-label">First Entry</span>
          <span class="h-val">{team.history.firstEntry}</span>
        </div>
        <div class="history-card">
          <span class="h-label">Pole Positions</span>
          <span class="h-val">{poles}</span>
        </div>
        <div class="history-card">
          <span class="h-label">Fastest Laps</span>
          <span class="h-val">{fastestLaps}</span>
        </div>
      </div>
    </section>

    <!-- Latest Team News -->
    <section class="profile-section">
      <div class="section-title-row">
        <h2>Latest {team.shortName} News</h2>
        <span class="section-badge">Around The Paddock</span>
      </div>

      {teamNews && teamNews.length > 0 ? (
        <div class="news-grid">
          {teamNews.map((article: any) => (
            <a href={article.link} target="_blank" rel="noopener noreferrer" class="news-card">
              {article.imageUrl && (
                <div class="card-image-wrap">
                  <img src={article.imageUrl} alt={article.title} loading="lazy" class="card-image" />
                </div>
              )}
              <div class="news-content">
                <div class="news-meta">
                  <span class="feed-source">{article.source}</span>
                  <span class="news-date">{article.pubDateStr}</span>
                </div>
                <h3 class="news-title">{article.title}</h3>
                {article.snippet && <p class="news-excerpt">{article.snippet}</p>}
