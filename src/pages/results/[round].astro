];

export async function getStaticPaths() {
  const rounds = Array.from({ length: 23 }, (_, i) => ({
    params: { round: String(i + 1) },
  }));
  return rounds;
}

const { round } = Astro.params;
const roundKey = `r${round}`;

// 2. Look up the specific race details from the calendar array
const currentRace = CALENDAR.find(r => r.round === round);
const raceTitle = currentRace ? currentRace.raceName : `Round ${round}`;
const circuitName = currentRace ? currentRace.Circuit.circuitName : '';
const raceDate = currentRace ? new Date(currentRace.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

// 3. Filter and sort the classification data
const classification = seasonData.drivers
  .filter((driver: any) => driver[roundKey] && driver[roundKey] !== "")
  .sort((a: any, b: any) => {
    const posA = a[roundKey];
    const posB = b[roundKey];
    
    const numA = parseInt(posA, 10);
    const numB = parseInt(posB, 10);

    if (!isNaN(numA) && !isNaN(numB)) return numA - numB;
    if (!isNaN(numA)) return -1;
    if (!isNaN(numB)) return 1;
    return posA.localeCompare(posB);
  });
---

<Layout 
  title={`${raceTitle} Results | Round ${round} | My Grand Prix Hub`}
  description={`Full classification and race results for the 2026 ${raceTitle}.`}
>
  <main class="page-container">
    <a href="/championship/calendar" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Calendar
    </a>

    <header class="section-header">
      <div class="header-flex">
        <div>
          <span class="badge">Official Classification</span>
          <h1 class="gradient-title">{raceTitle}</h1>
          {currentRace && (
            <p class="circuit-meta">{circuitName} &bull; {raceDate}</p>
          )}
        </div>
        
        <div class="dropdown-wrapper">
          <label for="round-selector" class="sr-only">Select Race</label>
          <select id="round-selector" class="round-dropdown">
            {CALENDAR.map((r) => (
              <option value={r.round} selected={r.round === round}>
                Round {r.round}: {r.raceName}
              </option>
            ))}
          </select>
          <svg class="dropdown-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>
    </header>

    {classification.length === 0 ? (
      <div class="empty-state">
        <p>Results for the {raceTitle} have not been published yet.</p>
      </div>
    ) : (
      <div class="table-container">
        <table class="results-table">
          <thead>
            <tr>
              <th class="col-pos">POS</th>
              <th class="col-driver">Driver</th>
              <th class="col-team">Team</th>
            </tr>
          </thead>
          <tbody>
            {classification.map((driver: any) => {
              const position = driver[roundKey];
              const isDNF = isNaN(parseInt(position, 10));
              
              return (
                <tr class={isDNF ? "row-dnf" : ""}>
                  <td class="col-pos">
                    <span class={`pos-badge ${isDNF ? 'badge-dnf' : position === '1' ? 'badge-gold' : position === '2' ? 'badge-silver' : position === '3' ? 'badge-bronze' : ''}`}>
                      {position}
                    </span>
                  </td>
                  <td class="col-driver">
                    <strong>{driver.name}</strong> 
                    <span class="driver-code">{driver.code}</span>
                  </td>
                  <td class="col-team">{driver.team}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selector = document.getElementById('round-selector') as HTMLSelectElement;
    if (selector) {
      selector.addEventListener('change', (e) => {
        const selectedRound = (e.target as HTMLSelectElement).value;
        window.location.href = `/results/${selectedRound}`;
      });
    }
  });
</script>

<style>
  .page-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: #38bdf8; }

  .section-header { margin-bottom: 2.5rem; }
  
  .header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    display: inline-block;
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .gradient-title { 
    font-size: 3rem; 
    margin: 0 0 0.5rem 0; 
    font-weight: 900; 
    letter-spacing: -0.02em; 
    color: #ffffff;
  }

  .circuit-meta {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
    font-weight: 600;
  }

  /* Dropdown Styles */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .dropdown-wrapper {
    position: relative;
    display: inline-block;
  }

  .round-dropdown {
    appearance: none;
    background-color: #0f172a;
    border: 1px solid #38bdf8;
    color: #f8fafc;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.6rem 2.5rem 0.6rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    outline: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .round-dropdown:hover, .round-dropdown:focus {
    background-color: #1e293b;
    border-color: #7dd3fc;
  }

  .dropdown-icon {
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    color: #38bdf8;
    pointer-events: none;
  }

  /* Table Styles */
  .table-container {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    overflow: hidden;
  }

  .results-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .results-table th {
    background: #1e293b;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1rem 1.5rem;
    border-bottom: 2px solid #334155;
  }

  .results-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #1e293b;
    color: #f8fafc;
    font-size: 0.95rem;
  }

  .results-table tr:last-child td { border-bottom: none; }
  .results-table tr:hover td { background: rgba(30, 41, 59, 0.5); }

  /* DNF Styling */
  .row-dnf td { color: #64748b; }
  .row-dnf strong { color: #94a3b8; }

  .pos-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 0.4rem;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.85rem;
  }

  .badge-gold { background: #fbbf24; color: #0f172a; border-color: #f59e0b; }
