---
// src/pages/travel-and-tickets/index.astro
import Layout from '../../layouts/Layout.astro';
import { raceLogisticsData } from '../../data/travelAndTickets';

// Helper function to color-code the status badges on the index cards
const getStatusBadgeClass = (status: string) => {
  switch(status) {
    case 'On Sale': return 'status-green';
    case 'Selling Fast': return 'status-amber';
    case 'Sold Out': return 'status-red';
    case 'Presale': return 'status-blue';
    case 'Waitlist': return 'status-purple';
    default: return 'status-default';
  }
};
---

<Layout 
  title="F1 Tickets & Travel Directory | My Grand Prix Hub"
  description="Plan your Formula 1 trip. View global ticket availability, hotel recommendations, and airport transit guides for every race on the 2026 calendar."
>
  <main class="page-container index-page">
    
    <header class="index-header">
      <span class="badge">2026 Season</span>
      <h1>Tickets & Travel Guides</h1>
      <p class="subtitle">Select a race to explore official ticket options, verified resellers, airport hubs, and local circuit logistics.</p>
    </header>

    <div class="race-grid">
      {raceLogisticsData.map((race) => (
        <a href={`/travel-and-tickets/${race.slug}`} class="race-card">
          
          <div class="card-top">
            <div class="round-badge">Round {race.round}</div>
            <span class={`status-badge ${getStatusBadgeClass(race.ticketStatus)}`}>
              {race.ticketStatus}
            </span>
          </div>
          
          <div class="card-body">
            <h2>{race.raceName}</h2>
            
            <div class="info-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{race.circuitName} &bull; {race.location.split(',')[1]?.trim() || race.location}</span>
            </div>
            
            <div class="info-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>{race.dates}</span>
            </div>
          </div>

          <div class="card-footer">
            <span class="view-btn">View Logistics Guide &rarr;</span>
          </div>
          
        </a>
      ))}
    </div>

  </main>
</Layout>

<style>
  .index-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .index-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 3.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.2rem;
    margin: 0 auto;
    font-weight: 500;
    max-width: 600px;
    line-height: 1.5;
  }

  .race-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .race-card {
    display: flex;
    flex-direction: column;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  .race-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: #0f172a;
    border-bottom: 1px solid #334155;
  }

  .round-badge {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    border: 1px solid transparent;
  }

  /* Status Colors */
  .status-green { background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3); }
  .status-amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3); }
  .status-red { background: rgba(225, 6, 0, 0.15); color: #f43f5e; border-color: rgba(225, 6, 0, 0.3); }
  .status-blue { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border-color: rgba(56, 189, 248, 0.3); }
  .status-purple { background: rgba(167, 139, 250, 0.15); color: #a78bfa; border-color: rgba(167, 139, 250, 0.3); }
  .status-default { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border-color: rgba(148, 163, 184, 0.3); }

  .card-body {
    padding: 1.5rem;
    flex-grow: 1;
  }

  .card-body h2 {
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 1.25rem 0;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #cbd5e1;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .info-row:last-child {
    margin-bottom: 0;
  }

  .info-row svg {
    color: #64748b;
    flex-shrink: 0;
  }

  .card-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid #334155;
    background: rgba(15, 23, 42, 0.4);
  }

  .view-btn {
    display: block;
    color: #38bdf8;
    font-size: 0.95rem;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .race-card:hover .view-btn {
    color: #7dd3fc;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }
    
    .race-grid {
      grid-template-columns: 1fr;
    }
  }
</style>