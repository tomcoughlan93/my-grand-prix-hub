---
// src/pages/travel-and-tickets/index.astro
import Layout from '@/layouts/Layout.astro';
import { raceLogisticsData } from '@/data/travelAndTickets';
import { circuitGuidesData } from '@/data/circuitGuides';
import GlobalCircuitMap from '@/components/GlobalCircuitMap.astro';

const now = new Date();

// Map over the logistics data and cross-reference the circuit data to get the exact date
const races = raceLogisticsData.map((race) => {
  const circuitMatch = circuitGuidesData.find(c => c.round === race.round);
  let isPast = false;

  if (circuitMatch) {
    // Calculate if the race has passed (roughly 3 days after first session)
    const raceEndDate = new Date(new Date(circuitMatch.firstSessionDate).getTime() + (3 * 24 * 60 * 60 * 1000));
    isPast = now > raceEndDate;
  }

  return {
    ...race,
    isPast
  };
});

// Ensure they are sorted by round
races.sort((a, b) => a.round - b.round);
---

<Layout 
  title="F1 Tickets & Travel Directory | My Grand Prix Hub"
  description="Plan your Formula 1 trip. View global ticket availability, hotel recommendations, and airport transit guides for every race on the 2026 calendar."
>
  <main class="page-container index-page">
    
    <header class="index-header">
      <span class="badge">2026 Season</span>
      <h1 class="gradient-title">Tickets & Travel Guides</h1>
      <p class="subtitle">Select a race to explore official ticket options, verified resellers, airport hubs, and local circuit logistics.</p>
    </header>

    <GlobalCircuitMap/>

    <div class="race-grid">
      {races.map((race) => (
        <a href={`/travel-and-tickets/${race.slug}`} class={`race-card ${race.isPast ? 'is-past' : ''}`}>
          
          <div class="card-top">
            <div class="round-badge">Round {race.round}</div>
          </div>
          
          <div class="card-body">
            <h2>{race.raceName}</h2>
            
            <div class="info-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{race.circuitName} &bull; {race.location.split(',')[1]?.trim() || race.location}</span>
            </div>
            
            <div class="info-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span>{race.dates}</span>
            </div>
          </div>

          <div class="card-footer">
            <span class="view-btn">View Logistics Guide &rarr;</span>
          </div>
          
        </a>
      ))}
    </div>

  </main>
</Layout>

<style>
  .index-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .index-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .badge {
    display: inline-block;
    background-color: #e10600;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .gradient-title { 
    font-size: 3.5rem; 
    margin: 0 0 1rem 0; 
    font-weight: 900; 
    letter-spacing: -0.03em; 
    line-height: 1.1; 
    background: linear-gradient(to right, #ffffff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.15rem;
    margin: 0 auto;
    font-weight: 500;
    max-width: 600px;
    line-height: 1.6;
  }

  .race-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .race-card {
    display: flex;
    flex-direction: column;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, opacity 0.3s, filter 0.3s;
    overflow: hidden;
  }

  /* Past Race Dimming */
  .is-past {
    opacity: 0.6;
    filter: grayscale(40%);
  }
  
  .is-past:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  .race-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  .card-top {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: #0f172a;
    border-bottom: 1px solid #334155;
  }

  .round-badge {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-body {
    padding: 1.5rem;
    flex-grow: 1;
  }

  .card-body h2 {
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 1.25rem 0;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #cbd5e1;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .info-row:last-child {
    margin-bottom: 0;
  }

  .info-row svg {
    color: #64748b;
    flex-shrink: 0;
  }

  .card-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid #334155;
    background: rgba(15, 23, 42, 0.4);
  }

  .view-btn {
    display: block;
    color: #38bdf8;
    font-size: 0.95rem;
    font-weight: 800;
    transition: color 0.2s ease;
  }

  .race-card:hover .view-btn {
    color: #7dd3fc;
  }

  @media (max-width: 768px) {
    .gradient-title {
      font-size: 2.75rem;
    }
    
    .race-grid {
      grid-template-columns: 1fr;
    }
  }
</style>