  }

  .distance {
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .transit-summary {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .stay-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    display: flex;
    margin-top: 2rem;
  }

  .stay-areas {
    padding: 2rem;
    flex: 1;
    border-right: 1px solid #334155;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stay-tips {
    padding: 2rem;
    flex: 1;
    background: rgba(56, 189, 248, 0.05);
  }

  .stay-card h4 {
    color: #ffffff;
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
  }

  .stay-areas ul {
