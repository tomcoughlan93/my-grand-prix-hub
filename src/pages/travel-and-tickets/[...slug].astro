---
// src/pages/travel-and-tickets/[slug].astro
import Layout from '../../layouts/Layout.astro';
import JourneyPlanner from '../../components/JourneyPlanner.astro';
import { 
  raceLogisticsData, 
  type GrandPrixLogistics, 
  type TicketTier, 
  type Airport 
} from '../../data/travelAndTickets'; 

export const prerender = true;

export function getStaticPaths() {
  return raceLogisticsData.map((race: GrandPrixLogistics) => ({
    params: { slug: race.slug },
    props: { race },
  }));
}

interface Props {
  race: GrandPrixLogistics;
}

const { race } = Astro.props as Props;

const getStatusColor = (status: string) => {
  switch(status) {
    case 'On Sale': return 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';
    case 'Selling Fast': return 'bg-amber-500/20 text-amber-400 border-amber-500/30';
    case 'Sold Out': return 'bg-rose-500/20 text-rose-400 border-rose-500/30';
    default: return 'bg-slate-500/20 text-slate-300 border-slate-500/30';
  }
};
---

<Layout 
  title={`${race.raceName} Tickets & Travel Guide | My Grand Prix Hub`}
  description={`Plan your trip to the ${race.raceName}. Get ticket prices, airport guides, accommodation tips, and local transport info for ${race.circuitName}.`}
>
  <main class="page-container hub-page">
    
    <header class="hub-header">
      <div class="header-content">
        <span class="round-badge">Round {race.round} &bull; {race.dates}</span>
        <h1>{race.raceName}</h1>
        <p class="subtitle">{race.circuitName}, {race.location}</p>
        
        <div class="header-actions">
          <span class={`status-badge ${getStatusColor(race.ticketStatus)} border`}>
            {race.ticketStatus}
          </span>
          <a href={race.officialBoxOfficeUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Official Tickets
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
          </a>
        </div>
      </div>
    </header>

    <nav class="sticky-nav">
      <ul class="nav-links">
        <li><a href="#tickets">Tickets & Prices</a></li>
        <!-- COMBINED NAV LINK -->
        <li><a href="#travel-access">Getting There & Access</a></li>
        <li><a href="#stay">Where to Stay</a></li>
        <li><a href="#know-before-you-go">Know Before You Go</a></li>
      </ul>
    </nav>

    <div class="content-grid">
      
      <!-- TICKETS SECTION -->
      <section id="tickets" class="hub-section">
        <div class="section-header-flex">
          <div>
            <h2>Tickets & Packages</h2>
            <p class="section-intro">Explore official grandstand options and verified VIP packages.</p>
          </div>
          <!-- Currency Switcher -->
          <div class="currency-switcher">
            <label for="currency-select">Currency:</label>
            <select id="currency-select" class="currency-dropdown">
              <option value="EUR">EUR (€)</option>
              <option value="GBP">GBP (£)</option>
              <option value="USD">USD ($)</option>
            </select>
          </div>
        </div>
        
        <div class="ticket-tiers">
          {race.ticketTiers.map((tier: TicketTier) => (
            <div class="ticket-card">
              <div class="tier-header">
                <span class="tier-category">{tier.category}</span>
                <h3>{tier.name}</h3>
              </div>
              <div class="tier-price">
                From 
                <strong 
                  class="price-val" 
                  data-eur={tier.priceFromEUR} 
                  data-gbp={tier.priceFromGBP} 
                  data-usd={tier.priceFromUSD}
                >
                  €{tier.priceFromEUR}
                </strong>
              </div>
              <p class="tier-desc">{tier.description}</p>
            </div>
          ))}
        </div>

        <div class="vendors-box">
          <h4>Authorised International Resellers</h4>
          <ul class="vendor-list">
            {race.vendors.map((vendor: { name: string; type: string; url: string }) => (
              <li>
                <a href={vendor.url} target="_blank" rel="noopener noreferrer" class="vendor-link">
                  <strong>{vendor.name}</strong>
                  <span class="vendor-type">{vendor.type}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- COMBINED TRAVEL & ACCESS SECTION -->
      <section id="travel-access" class="hub-section">
        <div class="section-header-flex">
            <div>
                <h2>Getting There & Circuit Access</h2>
                <p class="section-intro">Plan your route from international airports right down to the local circuit gates.</p>
            </div>
        </div>

        <JourneyPlanner 
            circuitName={race.circuitName} 
            lat={race.coordinates?.lat || 0} 
            lon={race.coordinates?.lon || 0}
        >
            <div class="access-grid">
                {race.circuitTransit.trainStation && (
                  <div class="access-card">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 3"/><path d="M16 19l2 3"/><path d="M8 15h.01"/><path d="M16 15h.01"/></svg>
                    <h4>Train Access</h4>
                    <p>Nearest Station: <strong>{race.circuitTransit.trainStation}</strong></p>
                    {race.circuitTransit.trainBookingUrl && (
                      <a href={race.circuitTransit.trainBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-text mt-2">Book Train Tickets &rarr;</a>
                    )}
                  </div>
                )}
                
                <div class="access-card">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><rect x="3" y="11" width="18" height="8" rx="2"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="19" r="2"/><path d="M5 11V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"/></svg>
                  <h4>Shuttles & Buses</h4>
                  <p>{race.circuitTransit.shuttleInfo}</p>
                  {race.circuitTransit.shuttleBookingUrl && (
                    <a href={race.circuitTransit.shuttleBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-text mt-2">Book Shuttle Pass &rarr;</a>
                  )}
                </div>
      
                <div class="access-card">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
                  <h4>Parking</h4>
                  <p>{race.circuitTransit.parkingAdvice}</p>
                  {race.circuitTransit.parkingBookingUrl && (
                    <a href={race.circuitTransit.parkingBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-text mt-2">Reserve Parking &rarr;</a>
                  )}
                </div>
      
                <div class="access-card full-width">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                  <h4>Gate Entry & App Rules</h4>
                  <p>{race.circuitTransit.gateEntryTips}</p>
                </div>
              </div>
        </JourneyPlanner>

        <h3 class="subsection-title">Nearest Airports</h3>
        <div class="airport-grid">
          {race.airports.map((airport: Airport) => (
            <div class="airport-card">
              <div class="airport-header">
                <div class="airport-code">{airport.code}</div>
                <div>
                  <h4>{airport.name}</h4>
                  <span class="distance">{airport.distanceToCircuit} to circuit</span>
                </div>
              </div>
              <p class="transit-summary">{airport.transitSummary}</p>
              {airport.bookingUrl && (
                <a href={airport.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-3">
                  Search Flights
                </a>
              )}
            </div>
          ))}
        </div>
      </section>

      <hr class="section-divider" />

      <!-- ACCOMMODATION SECTION -->
      <section id="stay" class="hub-section">
        <h2>Where to Stay</h2>
        <div class="stay-card">
          <div class="stay-areas">
            <h4>Recommended Base Locations:</h4>
            <ul>
              {race.accommodation.recommendedAreas.map((area: string) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {area}
                </li>
              ))}
            </ul>
            {race.accommodation.bookingUrl && (
              <a href={race.accommodation.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-4">
                Find Hotels & Rentals
              </a>
            )}
          </div>
          <div class="stay-tips">
            <h4>Local Tip:</h4>
            <p>{race.accommodation.tips}</p>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- KNOW BEFORE YOU GO SECTION -->
      <section id="know-before-you-go" class="hub-section">
        <h2>Know Before You Go</h2>
        <p class="section-intro">Essential logistics, rules, and tips for the race weekend.</p>
        
        <div class="kbyg-grid">
          
          <!-- Rules & Bags -->
          <div class="kbyg-card border-t-blue">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <h4>Bag & Food Policy</h4>
            </div>
            <p><strong>Bags:</strong> {race.knowBeforeYouGo.bagPolicy}</p>
            <p><strong>Food & Drink:</strong> {race.knowBeforeYouGo.foodAndDrinkPolicy}</p>
          </div>

          <!-- Prohibited Items (Warning) -->
          <div class="kbyg-card border-t-red bg-rose-950/20">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              <h4 class="text-rose-400">Strictly Prohibited</h4>
            </div>
            <ul class="prohibited-list">
              {race.knowBeforeYouGo.prohibitedItems.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <!-- Payments & Currency -->
          <div class="kbyg-card border-t-emerald">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <h4>Currency & Payments</h4>
            </div>
            <p><strong>Track Systems:</strong> {race.knowBeforeYouGo.paymentMethods}</p>
          </div>

          <!-- Packing & Weather -->
          <div class="kbyg-card border-t-amber">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/></svg>
              <h4>Weather & Packing</h4>
            </div>
            <p>{race.knowBeforeYouGo.packingTips}</p>
          </div>

          <!-- PRM / Accessibility -->
          <div class="kbyg-card border-t-purple">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              <h4>Accessibility (PRM)</h4>
            </div>
            <p><strong>Viewing:</strong> {race.knowBeforeYouGo.accessibility.wheelchairAccess}</p>
            <p><strong>Parking:</strong> {race.knowBeforeYouGo.accessibility.parkingShuttles}</p>
          </div>

          <!-- Weekend Extras -->
          <div class="kbyg-card border-t-indigo">
            <div class="kbyg-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <h4>Weekend Extras</h4>
            </div>
            <div class="support-badges">
              {race.knowBeforeYouGo.weekendExtras.supportSeries.map((series: string) => (
                <span class="badge-sub">{series}</span>
              ))}
            </div>
            <p>{race.knowBeforeYouGo.weekendExtras.entertainment}</p>
          </div>

        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  // Client-side JavaScript to handle live currency conversion
  document.addEventListener('DOMContentLoaded', () => {
    const currencySelect = document.getElementById('currency-select') as HTMLSelectElement;
    const priceElements = document.querySelectorAll('.price-val');

    if (currencySelect && priceElements.length > 0) {
      currencySelect.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const currency = target.value;
        const symbols: Record<string, string> = { EUR: '€', GBP: '£', USD: '$' };

        priceElements.forEach(el => {
          const price = el.getAttribute(`data-${currency.toLowerCase()}`);
          if (price) {
            el.innerHTML = `${symbols[currency]}${price}`;
          }
        });
      });
    }
  });
</script>

<style>
  .hub-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #38bdf8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #7dd3fc;
  }

  .hub-header {
    margin-bottom: 3rem;
  }

  .round-badge {
    color: #94a3b8;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.2rem;
    margin: 0 0 2rem 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .status-badge {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #e10600;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 800;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background: #ff1e16;
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-block;
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #38bdf8;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: #38bdf8;
    color: #0f172a;
  }

  .btn-text {
    display: inline-block;
    color: #38bdf8;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }

  .btn-text:hover {
    color: #7dd3fc;
    text-decoration: underline;
  }

  .mt-2 { margin-top: 0.5rem; }
  .mt-3 { margin-top: 1rem; }
  .mt-4 { margin-top: 1.5rem; }

  .sticky-nav {
    position: sticky;
    top: 0;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #334155;
    border-top: 1px solid #334155;
    padding: 1rem 0;
    margin-bottom: 3rem;
    z-index: 10;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .nav-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #38bdf8;
  }

  .hub-section {
    margin-bottom: 4rem;
    scroll-margin-top: 100px; 
  }

  .section-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hub-section h2 {
    color: #ffffff;
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }
  
  .subsection-title {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    margin: 3.5rem 0 1.5rem 0;
  }

  .section-intro {
    color: #94a3b8;
    font-size: 1.1rem;
    margin: 0;
  }

  .currency-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #0f172a;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #334155;
  }

  .currency-switcher label {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .currency-dropdown {
    background: transparent;
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    outline: none;
  }

  .currency-dropdown option {
    background: #0f172a;
    color: #ffffff;
  }

  .section-divider {
    border: 0;
    height: 1px;
    background: #334155;
    margin: 3rem 0;
  }

  .ticket-tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .ticket-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .tier-category {
    font-size: 0.75rem;
    font-weight: 800;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ticket-card h3 {
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0.25rem 0 1rem 0;
  }

  .tier-price {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #334155;
  }

  .tier-price strong {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 900;
  }

  .tier-desc {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .vendors-box {
    background: #0f172a;
    border: 1px dashed #475569;
    padding: 1.5rem;
    border-radius: 8px;
  }

  .vendors-box h4 {
    color: #ffffff;
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
  }

  .vendor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .vendor-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #1e293b;
    padding: 1rem;
    border-radius: 6px;
    text-decoration: none;
    border: 1px solid #334155;
