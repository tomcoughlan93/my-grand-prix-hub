---
import Layout from '../../layouts/Layout.astro';
import JourneyPlanner from '../../components/JourneyPlanner.astro';
import { 
  raceLogisticsData, 
  type GrandPrixLogistics, 
  type TicketTier, 
  type Airport 
} from '../../data/travelAndTickets'; 

export const prerender = true;

export function getStaticPaths() {
  return raceLogisticsData.map((race: GrandPrixLogistics) => ({
    params: { slug: race.slug },
    props: { race },
  }));
}

interface Props {
  race: GrandPrixLogistics;
}

const { race } = Astro.props as Props;

const startingPriceGBP = race.ticketTiers.length > 0 ? race.ticketTiers[0].priceFromGBP : '--';
const startingPriceEUR = race.ticketTiers.length > 0 ? race.ticketTiers[0].priceFromEUR : '--';
const startingPriceUSD = race.ticketTiers.length > 0 ? race.ticketTiers[0].priceFromUSD : '--';
---

<Layout 
  title={`${race.raceName} Tickets & Trip Planner | My Grand Prix Hub`}
  description={`Step-by-step travel & booking guide for the ${race.raceName}. Tickets, flights, train routes, city base guide, and circuit transport for ${race.circuitName}.`}
>
  <main class="page-container hub-page">
    
    <!-- HERO HEADER -->
    <header class="hub-hero">
      <div class="hero-top-meta">
        <span class="round-badge">Round {race.round} &bull; {race.dates}</span>
      </div>

      <h1>{race.raceName}</h1>
      <p class="subtitle">{race.circuitName} &bull; {race.location}</p>
      
      <div class="hero-cta-strip">
        <div class="hero-price-tag">
          <span class="price-lbl">Official Tickets From</span>
          <span 
            class="price-hero-val price-val" 
            data-eur={startingPriceEUR} 
            data-gbp={startingPriceGBP} 
            data-usd={startingPriceUSD}
          >
            £{startingPriceGBP}
          </span>
        </div>
        <a href={race.officialBoxOfficeUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Official Box Office
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
      </div>
    </header>

    <!-- TRUST BADGE ROW -->
    <div class="trust-bar">
      <div class="trust-cell">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Verified Official Vendors</span>
      </div>
      <div class="trust-cell">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>Secure Booking Portals</span>
      </div>
      <div class="trust-cell">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Updated for 2026 Season</span>
      </div>
    </div>

    <!-- STEP-BY-STEP STICKY JOURNEY NAV -->
    <nav class="sticky-step-nav" id="trip-stepper">
      <div class="step-nav-inner">
        <a href="#step-tickets" class="step-link is-active" data-step="1">
          <span class="step-num">01</span>
          <span class="step-text">Tickets</span>
        </a>
        <span class="step-arrow">&rarr;</span>
        <a href="#step-travel" class="step-link" data-step="2">
          <span class="step-num">02</span>
          <span class="step-text">Travel to City</span>
        </a>
        <span class="step-arrow">&rarr;</span>
        <a href="#step-stay" class="step-link" data-step="3">
          <span class="step-num">03</span>
          <span class="step-text">Stay & City Guide</span>
        </a>
        <span class="step-arrow">&rarr;</span>
        <a href="#step-access" class="step-link" data-step="4">
          <span class="step-num">04</span>
          <span class="step-text">Track Access</span>
        </a>
        <span class="step-arrow">&rarr;</span>
        <a href="#step-rules" class="step-link" data-step="5">
          <span class="step-num">05</span>
          <span class="step-text">Track Rules</span>
        </a>
      </div>
    </nav>

    <!-- CONTENT SECTIONS -->
    <div class="journey-content">
      
      <!-- STEP 1: TICKETS & PACKAGES -->
      <section id="step-tickets" class="journey-step-section">
        <div class="step-header-row">
          <div class="step-title-group">
            <span class="step-pill">Step 01</span>
            <h2>Tickets & Official Passes</h2>
          </div>
          
          <div class="currency-box">
            <label for="currency-select">Currency:</label>
            <select id="currency-select" class="currency-dropdown">
              <option value="GBP">GBP (£)</option>
              <option value="EUR">EUR (€)</option>
              <option value="USD">USD ($)</option>
            </select>
          </div>
        </div>
        <p class="step-intro">Compare ticket categories, pricing brackets, and verified ticket sellers for the {race.raceName}.</p>

        <div class="ticket-grid">
          {race.ticketTiers.map((tier: TicketTier) => (
            <div class="ticket-card">
              <div class="ticket-top">
                <span class="tier-tag">{tier.category}</span>
                <h3>{tier.name}</h3>
                <div class="price-row">
                  <span class="from-text">From</span>
                  <strong 
                    class="price-val" 
                    data-eur={tier.priceFromEUR} 
                    data-gbp={tier.priceFromGBP} 
                    data-usd={tier.priceFromUSD}
                  >
                    £{tier.priceFromGBP}
                  </strong>
                </div>
                <p class="tier-desc">{tier.description}</p>
              </div>

              <div class="ticket-bottom">
                <a href={race.officialBoxOfficeUrl} target="_blank" rel="noopener noreferrer" class="btn-check-ticket">
                  Check Tickets &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="vendors-panel">
          <div class="vendors-panel-header">
            <h4>Authorised International Resellers</h4>
            <span class="verified-tag">100% Genuine Allocation</span>
          </div>
          <div class="vendor-grid">
            {race.vendors.map((vendor: { name: string; type: string; url: string }) => (
              <a href={vendor.url} target="_blank" rel="noopener noreferrer" class="vendor-card">
                <div>
                  <strong>{vendor.name}</strong>
                  <span class="v-type">{vendor.type}</span>
                </div>
                <span class="v-arrow">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- STEP 2: TRAVEL TO DESTINATION -->
      <section id="step-travel" class="journey-step-section">
        <div class="step-header-row">
          <div class="step-title-group">
            <span class="step-pill">Step 02</span>
            <h2>Travel to Destination</h2>
          </div>
        </div>
        <p class="step-intro">Choose how you are getting to the host region. Switch modes to compare flights, international trains, and driving.</p>

        <!-- Travel Mode Selector Tabs -->
        <div class="travel-tabs-wrapper">
          <div class="travel-tabs">
            <button type="button" class="tab-btn is-active" data-target="tab-flights">
              ✈️ Flights & Airports
            </button>
            <button type="button" class="tab-btn" data-target="tab-trains">
              🚆 International Rail
            </button>
            <button type="button" class="tab-btn" data-target="tab-driving">
              🚗 Driving & Road Trips
            </button>
          </div>
        </div>

        <!-- TAB 1: FLIGHTS -->
        <div id="tab-flights" class="travel-tab-content is-active">
          <div class="airport-grid">
            {race.airports.map((airport: Airport) => (
              <div class="airport-card">
                <div class="airport-header">
                  <div class="airport-badge">
                    <span class="code">{airport.code}</span>
                  </div>
                  <div>
                    <h4>{airport.name}</h4>
                    <span class="dist-pill">{airport.distanceToCircuit} to circuit</span>
                  </div>
                </div>
                <p class="transit-p">{airport.transitSummary}</p>
                {airport.bookingUrl && (
  <a href={airport.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4">
    Compare Flights to {airport.code} &rarr;
  </a>
)}
              </div>
            ))}
          </div>
        </div>

        <!-- TAB 2: RAIL -->
        <div id="tab-trains" class="travel-tab-content">
          <div class="mode-info-card">
            <div class="mode-info-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-2 3"/><path d="M16 19l2 3"/></svg>
              <h3>High-Speed & Intercity Rail</h3>
            </div>
            <p>Travelling across Europe or domestically? High-speed rail connects directly into the nearest metropolitan transport hubs without airport security queues.</p>
            
            <div class="rail-perks">
              <div class="perk-box">
                <strong>Main Station Hub</strong>
                <span>{race.circuitTransit.trainStation || 'Central Metropolitan Terminal'}</span>
              </div>
              <div class="perk-box">
                <strong>Luggage Allowance</strong>
                <span>Generous allowances with no extra fees for bags or fluids</span>
              </div>
            </div>

            {race.circuitTransit.trainBookingUrl && (
              <a href={race.circuitTransit.trainBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4">
                Search Train Timetables & Tickets &rarr;
              </a>
            )}
          </div>
        </div>

        <!-- TAB 3: DRIVING -->
        <div id="tab-driving" class="travel-tab-content">
          <div class="mode-info-card">
            <div class="mode-info-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
              <h3>Driving & Highway Advice</h3>
            </div>
            <p>Road-tripping to {race.raceName}? Ensure your vehicle is equipped with the necessary emissions vignettes, toll tags, or international driving kit.</p>

            <div class="road-tips-list">
              <div class="tip-item">
                <span class="tip-icon">🅿️</span>
                <div>
                  <strong>Circuit Parking Requirement:</strong>
                  <p>{race.circuitTransit.parkingAdvice}</p>
                </div>
              </div>
            </div>

            <!-- Dual Action Buttons for Driving -->
            <div class="travel-actions mt-4">
              {race.circuitTransit.parkingBookingUrl && (
                <a href={race.circuitTransit.parkingBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                  Reserve Circuit Parking &rarr;
                </a>
              )}
              <a href={`https://www.google.com/maps/dir/?api=1&destination=${race.coordinates?.lat || ''},${race.coordinates?.lon || ''}`} target="_blank" rel="noopener noreferrer" class="btn-outline">
                Plan Your Route 🗺️
              </a>
            </div>
            
          </div>
        </div>
      </section>

      <!-- STEP 3: WHERE TO STAY & CITY GUIDE -->
      <section id="step-stay" class="journey-step-section">
        <div class="step-header-row">
          <div class="step-title-group">
            <span class="step-pill">Step 03</span>
            <h2>Where to Stay & City Guide</h2>
          </div>
        </div>
        <p class="step-intro">Lock down your base. Explore top neighborhoods for nightlife, dining, and easy circuit transport.</p>

        <div class="stay-layout-grid">
          <!-- Recommended Neighborhoods -->
          <div class="neighborhood-panel">
            <h3>Recommended Base Areas</h3>
            <div class="hood-list">
              {race.accommodation.recommendedAreas.map((area: string) => (
                <div class="hood-box">
                  <div class="hood-header">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <h4>{area}</h4>
                  </div>
                  <a href={race.accommodation.bookingUrl || '#'} target="_blank" rel="noopener noreferrer" class="hood-link">
                    Search Hotels in {area} &rarr;
                  </a>
                </div>
              ))}
            </div>

            <div class="stay-tip-card">
              <strong>💡 Local Accommodation Tip:</strong>
              <p>{race.accommodation.tips}</p>
            </div>
          </div>

          <!-- INTERNAL CITY GUIDE FEATURE CARD -->
          <div class="city-guide-feature-card">
            <span class="cg-badge">Trackside City Guide</span>
            <h3>Explore {race.location.split(',')[0]} Beyond the Track</h3>
            <p>Looking for the best motorsport pubs, fan zones, dining spots, and city travel tips during race week?</p>
            
            <a href={`/circuits-live/city-guides`} class="btn-city-guide">
              Read {race.location.split(',')[0]} Fan & City Guide &rarr;
            </a>
          </div>
        </div>
      </section>

      <!-- STEP 4: TRACK ACCESS & LOCAL TRANSIT -->
      <section id="step-access" class="journey-step-section">
        <div class="step-header-row">
          <div class="step-title-group">
            <span class="step-pill">Step 04</span>
            <h2>Daily Track Access & Gates</h2>
          </div>
        </div>
        <p class="step-intro">How to get from your hotel or local station straight to the grandstand gates each morning.</p>

        <JourneyPlanner 
          circuitName={race.circuitName} 
          lat={race.coordinates?.lat || 0} 
          lon={race.coordinates?.lon || 0}
        >
          <div class="access-cards-grid">
            {race.circuitTransit.trainStation && (
              <div class="access-item">
                <div class="access-icon-bubble">🚆</div>
                <h4>Train & Shuttle Link</h4>
                <p>Arrive at <strong>{race.circuitTransit.trainStation}</strong> and follow official circuit wayfinding.</p>
                {race.circuitTransit.trainBookingUrl && (
                  <a href={race.circuitTransit.trainBookingUrl} target="_blank" rel="noopener noreferrer" class="access-link">Train Passes &rarr;</a>
                )}
              </div>
            )}
            
            <div class="access-item">
              <div class="access-icon-bubble">🚌</div>
              <h4>Express Circuit Buses</h4>
              <p>{race.circuitTransit.shuttleInfo}</p>
              {race.circuitTransit.shuttleBookingUrl && (
                <a href={race.circuitTransit.shuttleBookingUrl} target="_blank" rel="noopener noreferrer" class="access-link">Shuttle Bookings &rarr;</a>
              )}
            </div>

            <div class="access-item full-width-item">
              <div class="access-icon-bubble">📲</div>
              <div>
                <h4>Gate Entry & Ticketing App Rules</h4>
                <p>{race.circuitTransit.gateEntryTips}</p>
              </div>
            </div>
          </div>
        </JourneyPlanner>
      </section>

      <!-- STEP 5: KNOW BEFORE YOU GO -->
      <section id="step-rules" class="journey-step-section">
        <div class="step-header-row">
          <div class="step-title-group">
            <span class="step-pill">Step 05</span>
            <h2>Know Before You Go</h2>
          </div>
        </div>
        <p class="step-intro">Key circuit rules, bag dimensions, payment setups, and what you can bring through security.</p>

        <div class="rules-grid">
          <div class="rule-card rule-blue">
            <h4>🎒 Bag & Food Policy</h4>
            <p><strong>Bag Rules:</strong> {race.knowBeforeYouGo.bagPolicy}</p>
            <p><strong>Food & Drinks:</strong> {race.knowBeforeYouGo.foodAndDrinkPolicy}</p>
          </div>

          <div class="rule-card rule-red">
            <h4 class="text-red">🚫 Strictly Prohibited Items</h4>
            <ul class="prohibited-bullets">
              {race.knowBeforeYouGo.prohibitedItems.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>

          <div class="rule-card rule-emerald">
            <h4>💳 Currency & Payments</h4>
            <p><strong>Payment Methods:</strong> {race.knowBeforeYouGo.paymentMethods}</p>
          </div>

          <div class="rule-card rule-amber">
            <h4>☀️ Weather & Packing Checklist</h4>
            <p>{race.knowBeforeYouGo.packingTips}</p>
          </div>

          <div class="rule-card rule-purple">
            <h4>♿ Accessibility (PRM)</h4>
            <p><strong>Wheelchair Viewing:</strong> {race.knowBeforeYouGo.accessibility.wheelchairAccess}</p>
            <p><strong>Accessible Parking:</strong> {race.knowBeforeYouGo.accessibility.parkingShuttles}</p>
          </div>

          <div class="rule-card rule-indigo">
            <h4>🏎️ Weekend Extras & Support Series</h4>
            <div class="series-pill-row">
              {race.knowBeforeYouGo.weekendExtras.supportSeries.map((series: string) => (
                <span class="series-pill">{series}</span>
              ))}
            </div>
            <p>{race.knowBeforeYouGo.weekendExtras.entertainment}</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- STICKY MOBILE BOOKING BAR -->
  <div class="mobile-booking-bar">
    <div class="mobile-booking-inner">
      <div class="mobile-price">
        <span class="lbl">Tickets From</span>
        <strong 
          class="val price-val"
          data-eur={startingPriceEUR} 
          data-gbp={startingPriceGBP} 
          data-usd={startingPriceUSD}
        >
          £{startingPriceGBP}
        </strong>
      </div>
      <a href={race.officialBoxOfficeUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Official Tickets &rarr;
      </a>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Currency Switcher
    const currencySelect = document.getElementById('currency-select') as HTMLSelectElement;
    const priceElements = document.querySelectorAll('.price-val');

    if (currencySelect && priceElements.length > 0) {
      currencySelect.addEventListener('change', (e) => {
        const currency = (e.target as HTMLSelectElement).value;
        const symbols: Record<string, string> = { EUR: '€', GBP: '£', USD: '$' };

        priceElements.forEach(el => {
          const price = el.getAttribute(`data-${currency.toLowerCase()}`);
          if (price && price !== '--') {
            el.innerHTML = `${symbols[currency]}${price}`;
          }
        });
      });
    }

    // 2. Travel Mode Tabs
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.travel-tab-content');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        
        tabButtons.forEach(b => b.classList.remove('is-active'));
        tabContents.forEach(c => c.classList.remove('is-active'));

        btn.classList.add('is-active');
        if (targetId) {
          document.getElementById(targetId)?.classList.add('is-active');
        }
      });
    });

    // 3. ScrollSpy for Stepper
    const stepNavLinks = document.querySelectorAll('.step-link');
    const sections = document.querySelectorAll('.journey-step-section');

    window.addEventListener('scroll', () => {
      let currentSectionId = '';
      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop - 180;
        if (window.scrollY >= sectionTop) {
          currentSectionId = section.getAttribute('id') || '';
        }
      });

      stepNavLinks.forEach(link => {
        link.classList.remove('is-active');
        if (link.getAttribute('href') === `#${currentSectionId}`) {
          link.classList.add('is-active');
        }
      });
    });
  });
</script>

<style>
  .hub-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    color: #f1f5f9;
  }

  /* Hero Section */
  .hub-hero {
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155;
    border-radius: 16px;
    padding: 3rem;
    margin-bottom: 2rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
  }

  .hero-top-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .round-badge {
    color: #38bdf8;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }

  .hub-hero h1 {
    font-size: 3.25rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.2rem;
    margin: 0 0 2rem 0;
  }

  .hero-cta-strip {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: #0f172a;
    border: 1px solid #334155;
    padding: 1rem 1.5rem;
    border-radius: 10px;
    width: fit-content;
  }

  .hero-price-tag {
    display: flex;
    flex-direction: column;
  }

  .price-lbl {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 700;
    text-transform: uppercase;
  }

  .price-hero-val {
    font-size: 1.6rem;
    font-weight: 900;
    color: #ffffff;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #e10600;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    background: #ff1e16;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(225, 6, 0, 0.35);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: #f8fafc;
    border: 1px solid #334155;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-outline:hover {
    border-color: #38bdf8;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.05);
    transform: translateY(-2px);
  }

  /* Trust Bar */
  .trust-bar {
    display: flex;
    justify-content: space-between;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 0.85rem 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .trust-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* Sticky Stepper Navigation */
  .sticky-step-nav {
