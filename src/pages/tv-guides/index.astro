<script>
  let tvInterval: ReturnType<typeof setInterval> | undefined; // Track interval so it doesn't duplicate across navigations

  const initTVGuide = () => {
    const dataElement = document.getElementById('broadcaster-data');
    if (!dataElement) return;
    const { races, broadcasters } = JSON.parse(dataElement.textContent || '{}');

    // UI Elements
    const raceSelector = document.getElementById('race-selector') as HTMLSelectElement;
    const searchInput = document.getElementById('country-search') as HTMLInputElement;
    const broadcasterButtons = document.querySelectorAll('.broadcaster-item');
    const noResults = document.getElementById('no-results');
    const scheduleListContainer = document.getElementById('schedule-list-container');
    const scheduleTimezone = document.getElementById('schedule-timezone');
    const activeBroadcasterName = document.getElementById('active-broadcaster-name');
    const watchLiveBtn = document.getElementById('watch-live-btn') as HTMLAnchorElement;
    const f1tvPromoCard = document.getElementById('f1tv-promo-card');
    const timeToggles = document.querySelectorAll('input[name="time-toggle"]');
    
    // Header UI Elements for Race Info
    const scheduleFlag = document.getElementById('schedule-flag') as HTMLImageElement;
    const scheduleRoundDates = document.getElementById('schedule-round-dates');
    const scheduleRaceTitle = document.getElementById('schedule-race-title');
    const sprintIndicatorBadge = document.getElementById('sprint-indicator-badge');

    // Radio UI Elements
    const radioProviderText = document.getElementById('radio-provider-text');
    const radioListenBtn = document.getElementById('radio-listen-btn') as HTMLAnchorElement;

    // Filter UI Elements
    const filterBtns = document.querySelectorAll('.filter-btn');

    // --- TIMEZONE DETECTION LOGIC ---
    const getBroadcasterFromTimezone = () => {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      
      if (tz.includes('New_York') || tz.includes('Chicago') || tz.includes('Denver') || tz.includes('Los_Angeles') || tz.includes('Phoenix') || tz.includes('Anchorage') || tz.includes('Honolulu')) return 'us-appletv';
      if (tz.includes('Toronto') || tz.includes('Vancouver') || tz.includes('Montreal') || tz.includes('Edmonton') || tz.includes('Winnipeg') || tz.includes('Halifax')) return 'ca-tsn';
      if (tz.startsWith('Australia/')) return 'au-fox';
      if (tz.includes('Amsterdam')) return 'nl-viaplay';
      if (tz.includes('Berlin')) return 'de-sky';
      if (tz.includes('Rome')) return 'it-sky';
      if (tz.includes('Madrid') || tz.includes('Canary')) return 'es-dazn';
      if (tz.includes('Paris')) return 'fr-canal';
      if (tz.includes('Sao_Paulo') || tz.includes('Fortaleza') || tz.includes('Manaus') || tz.includes('Cuiaba')) return 'br-globo';
      if (tz.includes('Tokyo')) return 'jp-fuji';
      if (tz.includes('Kolkata') || tz.includes('Calcutta')) return 'in-fancode';
      if (tz.includes('Johannesburg')) return 'za-super';
      if (tz.includes('Auckland')) return 'nz-sky';
      if (tz.includes('Dubai') || tz.includes('Riyadh') || tz.includes('Qatar') || tz.includes('Bahrain')) return 'mena-bein';
      
      return 'uk-sky';
    };

    // Initial State
    let currentRaceId = raceSelector?.value;
    let currentBroadcasterId = getBroadcasterFromTimezone();
    let isLocalTime = true; 
    let currentRegion = 'all';

    // --- AUTO-UPDATE UI TO MATCH DETECTED TIMEZONE ---
    const localTimeToggle = document.getElementById('time-local') as HTMLInputElement;
    if (localTimeToggle) localTimeToggle.checked = true;

    broadcasterButtons.forEach((btn) => {
      btn.classList.remove('is-active');
      if (btn.getAttribute('data-id') === currentBroadcasterId) {
        btn.classList.add('is-active');
        
        // Auto-scroll the list down to their detected country
        setTimeout(() => {
          const listContainer = document.getElementById('broadcaster-list');
          if (listContainer) {
            listContainer.scrollTop = (btn as HTMLElement).offsetTop - 20;
          }
        }, 100);
      }
    });

    // --- TIME CONVERSION HELPERS ---
    const parseTimeOffset = (onAirStr: string, startStr: string) => {
      const parse = (t: string) => {
        const [h, m] = t.split(':').map(Number);
        return h * 60 + m;
      };
      let diff = parse(startStr) - parse(onAirStr);
      if (diff < 0) diff += 24 * 60; 
      return diff;
    };

    const formatLocalString = (date: Date) => {
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false }).replace('24:', '00:');
    };

    const getLocalDay = (date: Date) => {
      return date.toLocaleDateString([], { weekday: 'long' });
    };

    const generateGoogleCalendarUrl = (title: string, sessionName: string, startIso: string, endIso: string, location: string, network: string, f1tv: boolean) => {
      const formatTime = (iso: string) => iso.replace(/[-:]/g, '').split('.')[0] + 'Z';
      const eventTitle = encodeURIComponent(`F1: ${title} - ${sessionName}`);
      const descriptionText = `🏎️ Formula 1: ${title} - ${sessionName}\n📺 Watch live on: ${network}${f1tv ? ' (or F1 TV Pro)' : ''}\n📍 Track: ${location}\n\nView full timings and F1 guides at My Grand Prix Hub.`;
      const details = encodeURIComponent(descriptionText);
      const loc = encodeURIComponent(location);
      const dates = `${formatTime(startIso)}/${formatTime(endIso)}`;
      return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${eventTitle}&dates=${dates}&details=${details}&location=${loc}`;
    };

    // Calculate Real-Time Session Status
    const updateSessionStatuses = () => {
      const now = new Date().getTime();
      const rows = document.querySelectorAll('.schedule-row');
      let foundNext = false;

      rows.forEach((row) => {
        const startStr = row.getAttribute('data-utc-start');
        const endStr = row.getAttribute('data-utc-end');
        const statusPill = row.querySelector('.live-status-pill');
        if (!startStr || !endStr || !statusPill) return;

        const start = new Date(startStr).getTime();
        const end = new Date(endStr).getTime();

        if (now >= start && now <= end) {
          statusPill.className = 'live-status-pill pill-live-now';
          statusPill.textContent = '● LIVE NOW';
          row.classList.remove('is-next-session');
        } else if (now > end) {
          statusPill.className = 'live-status-pill pill-completed';
          statusPill.textContent = '✓ Finished';
          row.classList.remove('is-next-session');
        } else if (now < start && !foundNext) {
          statusPill.className = 'live-status-pill pill-next';
          statusPill.textContent = '⏳ UP NEXT';
          row.classList.add('is-next-session'); 
          foundNext = true;
        } else {
          statusPill.className = 'live-status-pill pill-upcoming';
          statusPill.textContent = 'Upcoming';
          row.classList.remove('is-next-session');
        }
      });
    };

    // Core Render Function
    const renderSchedule = () => {
      const selectedRace = races.find((r: any) => r.id === currentRaceId);
      const selectedBroadcaster = broadcasters.find((b: any) => b.id === currentBroadcasterId);
      
      if (!selectedRace || !selectedBroadcaster) return;

      if (scheduleTimezone) {
        if (isLocalTime) {
          const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone;
          scheduleTimezone.textContent = `Your Local Time (${tzName})`;
          scheduleTimezone.classList.add('local-tz-active');
        } else {
          scheduleTimezone.textContent = selectedBroadcaster.timezone;
          scheduleTimezone.classList.remove('local-tz-active');
        }
      }

      if (activeBroadcasterName) activeBroadcasterName.textContent = `${selectedBroadcaster.network} (${selectedBroadcaster.country})`;
      if (watchLiveBtn) watchLiveBtn.href = selectedBroadcaster.url;

      if (selectedBroadcaster.radio) {
        if (radioProviderText) radioProviderText.innerHTML = `Listen live via <strong>${selectedBroadcaster.radio.name}</strong>`;
        if (radioListenBtn) radioListenBtn.href = selectedBroadcaster.radio.url;
      } else {
        if (radioProviderText) radioProviderText.innerHTML = `Listen live via <strong>Official F1 Live Audio Commentary</strong>`;
        if (radioListenBtn) radioListenBtn.href = 'https://www.formula1.com/en/f1-live.html';
      }

      if (f1tvPromoCard) {
        f1tvPromoCard.style.display = selectedBroadcaster.f1tvPro ? 'flex' : 'none';
      }

      if (scheduleFlag) scheduleFlag.src = `https://flagcdn.com/w40/${selectedRace.flagCode}.png`;
      if (scheduleRoundDates) scheduleRoundDates.innerHTML = `Round ${selectedRace.round} &bull; ${selectedRace.dates}`;
      if (scheduleRaceTitle) scheduleRaceTitle.textContent = selectedRace.name;
      
      if (sprintIndicatorBadge) {
        sprintIndicatorBadge.classList.toggle('hidden', !selectedRace.isSprint);
      }

      const activeSchedule = selectedBroadcaster.schedules[currentRaceId] || [];
      
      if (scheduleListContainer) {
        if (activeSchedule.length === 0) {
           scheduleListContainer.innerHTML = `<div class="no-schedule">Schedule not yet published for this network.</div>`;
           return;
        }

        scheduleListContainer.innerHTML = activeSchedule.map((item: any) => {
          let displayDay = item.day;
          let displayStart = item.start;
          let displayNetworkOnAir = item.networkOnAir;
          let displayF1tvOnAir = item.f1tvOnAir;

          if (isLocalTime && item.utcStart) {
            const utcStartDate = new Date(item.utcStart);
            displayDay = getLocalDay(utcStartDate);
            displayStart = formatLocalString(utcStartDate);

            if (item.networkOnAir) {
              const networkOffsetMins = parseTimeOffset(item.networkOnAir, item.start);
              const networkDate = new Date(utcStartDate.getTime() - (networkOffsetMins * 60000));
              displayNetworkOnAir = formatLocalString(networkDate);
            }

            if (item.f1tvOnAir) {
              const f1tvOffsetMins = parseTimeOffset(item.f1tvOnAir, item.start);
              const f1tvDate = new Date(utcStartDate.getTime() - (f1tvOffsetMins * 60000));
              displayF1tvOnAir = formatLocalString(f1tvDate);
            }
          }

          return `
            <div class="schedule-row ${item.session.includes('Grand Prix') || item.session.includes('Sprint Race') ? 'highlight-race' : ''}" data-utc-start="${item.utcStart}" data-utc-end="${item.utcEnd}">
              <div class="session-info">
                <div class="session-meta-top">
                  <span class="day-badge ${isLocalTime ? 'day-local' : ''}">${displayDay}</span>
                  <span class="live-status-pill pill-upcoming">Upcoming</span>
                </div>
                <h3>${item.session}</h3>
                <span class="duration-text">${item.duration}</span>
              </div>

              <div class="timings-block">
                <div class="time-col on-air">
                  <span class="time-label">Build-Up On Air</span>
                  <div class="on-air-providers">
                    <div class="provider-row">
                      <span class="prov-name">${selectedBroadcaster.network}:</span>
                      <span class="time-val">${displayNetworkOnAir}</span>
                    </div>
                    ${displayF1tvOnAir && selectedBroadcaster.f1tvPro ? `
                      <div class="provider-row f1tv-row">
                        <span class="prov-name">F1TV Pro:</span>
                        <span class="time-val">${displayF1tvOnAir}</span>
                      </div>
                    ` : ''}
                  </div>
                </div>

                <div class="timeline-divider">
                  <span class="circle-dot"></span>
                  <span class="connect-line"></span>
                  <span class="circle-dot active"></span>
                </div>

                <div class="time-col track-action">
                  <span class="time-label">${item.session.includes('Grand Prix') || item.session.includes('Sprint Race') ? 'Lights Out' : 'Green Flag'}</span>
                  <span class="time-val track-val">${displayStart}</span>
                </div>
              </div>

              <div class="cal-actions">
                <button type="button" class="btn-cal" data-session="${item.session}" data-start="${item.utcStart}" data-end="${item.utcEnd}" title="Add to Google Calendar">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M12 14v4M10 16h4"/></svg>
                  +Cal
                </button>
              </div>
            </div>
          `
        }).join('');

        const calButtons = scheduleListContainer.querySelectorAll('.btn-cal');
        calButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const session = btn.getAttribute('data-session') || '';
            const start = btn.getAttribute('data-start') || '';
            const end = btn.getAttribute('data-end') || '';
            const url = generateGoogleCalendarUrl(selectedRace.name, session, start, end, selectedRace.circuitName, selectedBroadcaster.network, selectedBroadcaster.f1tvPro);
            window.open(url, '_blank');
          });
        });

        updateSessionStatuses();
      }
    };

    // Client-Side Search and Filter Logic
    const filterBroadcasters = () => {
      const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      broadcasterButtons.forEach((item) => {
        const el = item as HTMLElement;
        const country = el.getAttribute('data-country') || '';
        const region = el.getAttribute('data-region') || '';

        const matchesSearch = country.includes(term);
        const matchesRegion = currentRegion === 'all' || region === currentRegion;

        if (matchesSearch && matchesRegion) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount !== 0);
      }
    };

    // Event Listeners
    timeToggles.forEach(toggle => {
      toggle.addEventListener('change', (e) => {
        isLocalTime = (e.target as HTMLInputElement).value === 'local';
        renderSchedule();
      });
    });

    if (raceSelector) {
      raceSelector.addEventListener('change', (e) => {
        currentRaceId = (e.target as HTMLSelectElement).value;
        renderSchedule();
      });
    }

    broadcasterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentBroadcasterId = btn.getAttribute('data-id') || broadcasters[0].id;
        broadcasterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        renderSchedule();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', filterBroadcasters);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterBtns.forEach(b => b.classList.remove('is-active'));
        const target = e.target as HTMLElement;
        target.classList.add('is-active');
        currentRegion = target.getAttribute('data-region') || 'all';
        filterBroadcasters();
      });
    });

    // --- CHECK INCOMING CALENDAR LINKS ---
    function checkUrlForRaceFilter() {
      const urlParams = new URLSearchParams(window.location.search);
      const targetRound = urlParams.get('round');

      if (targetRound && raceSelector) {
        // Find race by round string
        const targetRace = races.find((r: any) => String(r.round) === targetRound);
        
        if (targetRace) {
          currentRaceId = targetRace.id;
          raceSelector.value = targetRace.id;
        }
      }
    }
    checkUrlForRaceFilter(); // Run before render

    if (tvInterval) clearInterval(tvInterval);
    tvInterval = setInterval(updateSessionStatuses, 60000);
    
    // Final render
    renderSchedule();
  };

  // Bind to BOTH standard load and Astro's View Transitions
  document.addEventListener('DOMContentLoaded', initTVGuide);
  document.addEventListener('astro:page-load', initTVGuide);
</script>

